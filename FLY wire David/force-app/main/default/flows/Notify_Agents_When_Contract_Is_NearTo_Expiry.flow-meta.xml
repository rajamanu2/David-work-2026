    <description>SALDEV-934: Notify Agents Account Owner and RM about Contracts Expiry.</description>
    <environments>Default</environments>
    <formulas>
        <name>DaysBeforeNotice</name>
        <dataType>Number</dataType>
        <expression>IF(
  LEN( TEXT({!CurrentContract.OwnerExpirationNotice}) ) = 0,
  90,
  VALUE( TEXT({!CurrentContract.OwnerExpirationNotice}) )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_IsTriggerDay</name>
        <dataType>Boolean</dataType>
        <expression>TODAY() = {!Loop_Contracts.EndDate} - 
IF(
    ISBLANK(TEXT({!Loop_Contracts.OwnerExpirationNotice})), 
    90, 
    VALUE(TRIM(SUBSTITUTE(TEXT({!Loop_Contracts.OwnerExpirationNotice}), &quot;Days&quot;, &quot;&quot;)))
)</expression>
    </formulas>
    <formulas>
        <name>NoticeDays</name>
        <dataType>Number</dataType>
        <expression>VALUE(
    TRIM(
        SUBSTITUTE(
            TEXT({!Loop_Contracts.OwnerExpirationNotice}),
            &quot;Days&quot;,
            &quot;&quot;
        )
    )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TargetNoticeDate</name>
        <dataType>Date</dataType>
        <expression>{!CurrentContract.EndDate} - {!DaysBeforeNotice}</expression>
    </formulas>
    <formulas>
        <name>Todays_Date</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Contracts.EndDate} - TODAY()</expression>
        <scale>0</scale>
    </formulas>
