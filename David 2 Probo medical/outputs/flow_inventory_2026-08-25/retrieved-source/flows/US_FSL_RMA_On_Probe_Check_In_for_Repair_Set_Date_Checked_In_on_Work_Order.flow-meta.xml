        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Date_Probe_Received_for_Repair_Eval__c</field>
            <value>
                <elementReference>$Record.Date_RMA_Item_Received__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Opportunity__r.Related_Work_Order__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>1 AND 2 AND (3 OR 4 OR (5 AND (6 OR 7)))</filterLogic>
        <filters>
            <field>Date_RMA_Item_Received__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Date_RMA_Item_Received__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012U0000000A9CqIAK</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012U0000000A9Cq</stringValue>
            </value>
        </filters>
        <filters>
            <field>Customer_Expectation__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Customer wants Equipment Back</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
