<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_to_Live__c</fullName>
    <externalId>false</externalId>
    <formula>IF( 
ISBLANK(Date_First_Opp_Product_Live__c),
0,
(Date_First_Opp_Product_Live__c - CloseDate)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText># of days it took for Opportunity to go live. Live Date - Close Date.</inlineHelpText>
    <label>Days to Live</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
