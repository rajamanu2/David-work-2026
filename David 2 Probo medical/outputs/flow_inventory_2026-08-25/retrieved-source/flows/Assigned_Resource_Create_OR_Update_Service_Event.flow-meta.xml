    <decisions>
        <name>AR_Record_Status</name>
        <label>AR Record Status</label>
        <locationX>611</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Event</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PPM_Before_March</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Work_Order.Scheduled_Service_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <dateTimeValue>2026-03-01T00:00:00.000Z</dateTimeValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Work_Order.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Preventative_Maintenance</stringValue>
                </rightValue>
            </conditions>
            <label>PPM Before March</label>
        </rules>
        <rules>
            <name>IsNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Service_Event</targetReference>
            </connector>
            <label>IsNew</label>
