<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Currency_on_Opp_Already_Matches</name>
        <label>Currency on Opp Already Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Currency_on_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Currency_on_Opp_Already_Match</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CurrencyIsoCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CurrencyfromEntity</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Entity__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Currency on Opp Already Match?</label>
        </rules>
    </decisions>
    <description>12/15/2025 (BW) - When the entity is changed, this automatically updates the currency on the opportunity to align with the new entity. This can be changed afterwards by the user if necessary.</description>
    <environments>Default</environments>
    <formulas>
        <name>CurrencyfromEntity</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.Entity__c}),
&quot;Probo-US&quot;,&quot;USD&quot;,
&quot;Probo-UK&quot;,&quot;GBP&quot;,
&quot;Probo-GMBH&quot;,&quot;EUR&quot;,
&quot;Probo-SAS&quot;,&quot;EUR&quot;,
&quot;Probo-CAD&quot;,&quot;CAD&quot;,
&quot;ASG&quot;,&quot;USD&quot;,
&quot;USD&quot;)</expression>
    </formulas>
    <interviewLabel>Update Currency when Entity is Changed {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Currency when Entity is Changed</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Currency_on_Opportunity</name>
        <label>Update Currency on Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>CurrencyfromEntity</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Entity__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Entity__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Currency_on_Opp_Already_Matches</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>InvalidDraft</status>
</Flow>
