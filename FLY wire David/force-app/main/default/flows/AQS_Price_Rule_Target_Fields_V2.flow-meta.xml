        <name>UpdatePriceRule</name>
        <label>Update Price Rule</label>
        <locationX>1159</locationX>
        <locationY>296</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Rule__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AQS_Price_Rule_Target_Fields__c</field>
            <value>
                <elementReference>vTable</elementReference>
            </value>
