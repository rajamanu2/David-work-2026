    <description>SN/NB - Made updates to expand outlier contract dates. Also added stipulation to check status when changing from active &gt; expired and vice versa.
This flow checks daily for active contracts. Updates the warranty and contract status according to the start and end dates respectively. Transitioned from &quot;PB: Service Contract&quot; Process Builder</description>
    <environments>Default</environments>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>Yesterday</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 1</expression>
    </formulas>
