    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
ISNEW(),
OR(
ISPICKVAL([Lead].CreatedBy.Location__c,&quot;Bristol, UK&quot;),
ISPICKVAL([Lead].CreatedBy.Location__c,&quot;Dusseldorf, Germany&quot;),
ISPICKVAL([Lead].CreatedBy.Location__c,&quot;Gloucester, UK&quot;),
ISPICKVAL([Lead].CreatedBy.Location__c,&quot;Nantes, FR&quot;),
ISPICKVAL([Lead].CreatedBy.Location__c,&quot;Nottingham, UK&quot;),
ISPICKVAL([Lead].LeadSource,&quot;HealthTrust&quot;)
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISNEW(),
OR(
ISPICKVAL({!myVariable_current.CreatedBy.Location__c},&quot;Bristol, UK&quot;),
ISPICKVAL({!myVariable_current.CreatedBy.Location__c},&quot;Dusseldorf, Germany&quot;),
ISPICKVAL({!myVariable_current.CreatedBy.Location__c},&quot;Gloucester, UK&quot;),
ISPICKVAL({!myVariable_current.CreatedBy.Location__c},&quot;Nantes, FR&quot;),
ISPICKVAL({!myVariable_current.CreatedBy.Location__c},&quot;Nottingham, UK&quot;),
ISPICKVAL({!myVariable_current.LeadSource},&quot;HealthTrust&quot;)
)
)</expression>
    </formulas>
