        <name>InventoryEmailTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;A part has been requested by the Refurb Team. Please pick the part and deliver it to the Refurb Tech. Don&apos;t forget to move the Location/Sublocation of the asset.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Asset:&lt;/strong&gt; {!Select_Asset_To_Consume.firstSelectedRow.Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Asset Location/SubLocation: &lt;/strong&gt;{!Select_Asset_To_Consume.firstSelectedRow.Location__c} / {!Select_Asset_To_Consume.firstSelectedRow.Sub_Location__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Part Requested: &lt;/strong&gt;{!Select_Asset_To_Consume.firstSelectedRow.Product_Name__c}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Refurb Test:&lt;/strong&gt; {!GetPartRequestInfo.Refurb_Test__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Requesting Tech:&lt;/strong&gt;&lt;span style=&quot;background-color: var(--slds-g-color-neutral-base-100, var(--lwc-colorBackgroundInput,rgb(255, 255, 255))); color: var(--slds-g-color-neutral-base-30, var(--lwc-colorTextWeak,rgb(68, 68, 68))); font-size: var(--lwc-fontSize3,0.8125rem); font-family: var(--lwc-fontFamily,-apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;);&quot;&gt; {!GetPartRequestInfo.Refurb_Test__r.Mechanical_Technician__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Location/Sublocation: &lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;{!GetPartRequestInfo.Refurb_Test__r.Refurb_Asset__r.Location__c} / &lt;/span&gt;{!GetPartRequestInfo.Refurb_Test__r.Refurb_Asset__r.Sub_Location__c}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thanks,&lt;/p&gt;&lt;p&gt;Refurb Team&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>PAEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!GetPartRequestInfo.CreatedBy.Name} is requesting {!GetAssetInfo.Name} to be Purchasing Approved for Refurb Team to Consume in {!GetPartRequestInfo.Name}. Please PA at your earliest convenience.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Link to Asset:  &lt;a href=&quot;https://probomedical.lightning.force.com/lightning/r/ProductItem__c/{!GetAssetInfo.Id}/view&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;https://probomedical.lightning.force.com/lightning/r/ProductItem__c/{!GetAssetInfo.Id}/view&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thanks,&lt;/p&gt;&lt;p&gt;Refurb Team&lt;/p&gt;</text>
