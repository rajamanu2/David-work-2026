<tr class="mktoModule" id="Headline_With_Bull"> 
<td align="center" valign="top"> 
<table width="640" border="0" cellspacing="0" cellpadding="0" align="center" style="width:640px;" class="em_wrapper" bgcolor="#ffffff"> 
<tbody> 
<tr> 
<td align="center" valign="top" style="padding:79px 40px 0px 40px;" class="em_ptrl2"> 
<table width="100%" border="0" cellspacing="0" cellpadding="0" align="center"> 
<tbody> 
<tr> 
<td align="left" valign="top" style="font-size:30px; line-height:34px; font-family:'Chivo', Verdana, Geneva, sans-serif; color:#223341; padding-top:5px; font-weight:bold;" class="em_defaultlink"> 
<div id="text_016" class="mktoText"> 
<p><span style="color: #223341; font-family: Chivo, Verdana, Geneva, sans-serif; font-size: 22px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: bold; letter-spacing: normal; orphans: 2; text-align: -webkit-left; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;">Come visit us virtually at these upcoming events...</span><br /></p> 
</div></td> 
</tr> 
<tr> 
<td align="center" valign="top" style="padding-top:23px;" class="em_ptop"> 
<table width="100%" border="0" cellspacing="0" cellpadding="0" align="center"> 
<tbody> 
<tr> 
<td width="8" align="left" valign="middle" style="font-size:0px; line-height:0px; width:8px;"> 
<div id="image_06" class="mktoImg"> 
<span style="vertical-align:-8px;"><img src="https://more.flywire.com/rs/372-QSQ-649/images/bull_img.png" width="8" height="8" style="display:block; max-width:8px;" border="0" /></span> 
</div></td> 
<td align="center" valign="top" width="12" style="width:12px; font-size:0px; line-height:0px;">&nbsp;</td> 
