    <decisions>
        <name>Is_Activated_Date_Populated</name>
        <label>Is Activated Date Populated?</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Default_Update_Status_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Activated_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Deactivated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Date</targetReference>
            </connector>
            <label>Yes Populated</label>
        </rules>
        <rules>
            <name>Not_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Activated_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Product_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active (Product Live)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Deactivated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Active_Date</targetReference>
            </connector>
            <label>Not Populated</label>
        </rules>
    </decisions>
    <description>If integration user Dan Ladd updates product config record Status or Status is Active, update Status date to TODAY. If Activated Date is null it populates the field for the first time. If Account is Deactivated, only update Prod Config status date 05/14/2024. 3/10 - Change from DLadd to Looker Custom Permission</description>
    <environments>Default</environments>
    <interviewLabel>(PROD CONFIG) API Changed Status Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(PROD CONFIG) API Changed Status Update Status Date</label>
