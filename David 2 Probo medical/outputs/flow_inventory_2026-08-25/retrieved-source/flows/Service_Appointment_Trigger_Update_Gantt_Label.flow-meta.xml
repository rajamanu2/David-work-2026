        <locationX>578</locationX>
        <locationY>587</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Icon_Blank_or_Appt_Type_Changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FSL__GanttIcon__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Appointment_Type__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decide_Type</targetReference>
            </connector>
            <label>Icon Blank or Appt Type Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Gantt_Label_Blank</name>
        <label>Gantt Label Blank</label>
        <locationX>578</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Gantt_Icon_Blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FSL__GanttLabel__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.City</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Gantt_Label</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>03/10/2025 - Kyle/Delegate - Keep Gantt label Updated
03/12/2025 - Kyle/Delegate - Adding Gantt Icon updates
04/24/2025 - Kyle/Delegate - Adding Tentative Time block title info</description>
    <environments>Default</environments>
    <formulas>
        <description>SA Number + City</description>
        <name>GanttLabel</name>
        <dataType>String</dataType>
        <expression>IF(
{!$Record.Tentative_SA_Time_Block__c}=TRUE, 
(IF(NOT(ISBLANK({!$Record.City})), &quot;TENTATIVE: &quot;&amp;{!$Record.AppointmentNumber}&amp;&quot; - &quot;&amp;{!$Record.City}, &quot;TENTATIVE: &quot;&amp;{!$Record.AppointmentNumber})), 
(IF(NOT(ISBLANK({!$Record.City})), {!$Record.AppointmentNumber}&amp;&quot; - &quot;&amp;{!$Record.City}, {!$Record.AppointmentNumber})))</expression>
    </formulas>
