            </connector>
            <label>Different Ship-To Line Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_QuoteLine_Type</name>
        <label>Check for QuoteLine Type</label>
        <locationX>880</locationX>
        <locationY>1415</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_it_is_an_New_Or_Quantity_Increase</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote_Line_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote_Line_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quantity Increase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.SBQQ__Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opp_Type</targetReference>
            </connector>
            <label>If it is an New Or Quantity Increase</label>
        </rules>
    </decisions>
