        <locationX>693</locationX>
        <locationY>295</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopPriceAction</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Rule__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Rule__r.Id</elementReference>
            </value>
        </filters>
        <object>SBQQ__PriceAction__c</object>
        <outputReference>socPriceActions</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>SBQQ__Field__c</queriedFields>
        <queriedFields>SBQQ__TargetObject__c</queriedFields>
    </recordLookups>
    <recordUpdates>
