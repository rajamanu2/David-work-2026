)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_8</name>
        <dataType>Boolean</dataType>
        <expression>AND
(
{!myVariable_current.Product_Name_Copy__c}  = &quot;Payables SaaS Fee&quot;,
