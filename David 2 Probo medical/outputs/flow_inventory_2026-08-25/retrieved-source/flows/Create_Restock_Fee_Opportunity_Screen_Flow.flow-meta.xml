        </connector>
    </assignments>
    <choices>
        <name>FifteenPercent</name>
        <choiceText>15%</choiceText>
        <dataType>Number</dataType>
        <value>
            <numberValue>0.15</numberValue>
        </value>
    </choices>
    <choices>
        <name>TenPercent</name>
        <choiceText>10%</choiceText>
        <dataType>Number</dataType>
        <value>
            <numberValue>0.1</numberValue>
        </value>
    </choices>
    <choices>
        <name>ThirtyPercent</name>
        <choiceText>30%</choiceText>
        <dataType>Number</dataType>
        <userInput>
            <isRequired>false</isRequired>
            <promptText>30%</promptText>
        </userInput>
        <value>
            <numberValue>0.3</numberValue>
        </value>
    </choices>
    <choices>
        <name>TwentyPercent</name>
        <choiceText>20%</choiceText>
        <dataType>Number</dataType>
        <value>
            <numberValue>0.2</numberValue>
        </value>
    </choices>
    <environments>Default</environments>
    <formulas>
        <name>RestockFeeFormula</name>
        <dataType>Currency</dataType>
        <expression>IF(
    {!Restock_Fee} = {!FifteenPercent}, 
    {!GetRMAOpportunityInfo.Amount} * 0.15,
    IF(
        {!Restock_Fee} = {!TwentyPercent}, 
        {!GetRMAOpportunityInfo.Amount} * 0.20,
        IF(
            {!Restock_Fee} = {!ThirtyPercent}, 
            {!GetRMAOpportunityInfo.Amount} * 0.30,
            IF(
                {!Restock_Fee} = {!TenPercent}, 
                {!GetRMAOpportunityInfo.Amount} * 0.10, 
                0
            )
        )
    )
)</expression>
        <scale>2</scale>
    </formulas>
