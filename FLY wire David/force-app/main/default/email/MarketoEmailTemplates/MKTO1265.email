​
​
      body, .body_style { margin:0; padding:0; mso-line-height-rule: exactly;}
      img, a img { border:0; outline:none; text-decoration:none; }
      table, td { border-collapse:collapse; }
      .ReadMsgBody{width:100%;} .ExternalClass{width:100%;}
      .ExternalClass, .ExternalClass * {line-height:100%;}
      table {mso-table-lspace:0pt; mso-table-rspace:0pt;}
      img {outline: none;-ms-interpolation-mode: bicubic;}
      body, .body_style, table, td, p, a, li, blockquote {-ms-text-size-adjust:100%; -webkit-text-size-adjust:100%;}
      body, .body_style {mso-line-height-rule: exactly;}
      .radius {-webkit-border-radius: 4px;-moz-border-radius:4px; }
      .round {-webkit-border-radius: 999px;-moz-border-radius: 999px;}
      p {margin-top: 0; margin-bottom: 1em;}
      body {margin:0;padding:0;}
      a {
        color: #0084C0;
        text-decoration: none;
      }
      a:hover { text-decoration: underline !important; }
      a:visited { color: #0084C0; }
      b {font-weight: 600;}
      img { max-width: 100%; }
      a img { border: 0; }
      img.block { display: block; }
      .preHeader {
        display: none !important;
        mso-hide: all;
        display: none;
        visibility: hidden;
        opacity: 0;
        color: transparent;
        mso-line-height-rule: exactly;
        line-height: 0;
        font-size: 0;
        overflow: hidden;
        border: 0;
      }
      .radius { border-radius: 4px; }
      .round { border-radius: 999px; }
      h4 { font-size: 16px; color: #6B7886; font-weight: normal; margin-top: 12px;}
      table.outer-wrapper {
        min-width: 100%;
        width: 100%;
        margin: 0 auto;
        table-layout: fixed;
      }
      table.emailContainer {
        margin: 0 auto;
        width: 600px;
        max-width: 600px;
        table-layout: fixed;
      }
      .gutter { padding-left: 20px; padding-right: 20px; }
      
      table.full-button {
        width: 100%;
      }
      table.button a {
        font-family: 'Chivo',Lucida Grande,Verdana,Arial,sans-serif;
        text-decoration:none;
        color:#ffffff;
        
      }
      table.button a:hover {
        text-decoration: none !important;
        color: #fff;
      }
      table.column {
        table-layout: fixed;
      }
​
      @media only screen and (max-width: 599px) {
        img.scalable {
          width: auto !important;
          height: auto !important;
        }
        .emailContainer {
          width: 100% !important;
          max-width: 599px;
        }
        table.column {
          width: 100% !important;
          float: none !important;
          margin-left: auto !important;
          margin-right: auto !important;
        }
        .gutter { padding-right: 20px !important; }
        .gutter { padding-left: 20px !important; }
      }
​
      @media only screen and (max-width: 319px) {
        .gutter {
        padding-left: 10px !important;
        padding-right: 10px !important;
        }
      }
    </style> 
<style type="text/css">
      body,
