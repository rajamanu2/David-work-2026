<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_QL_Fields</name>
        <label>Update QL Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Quote_Line_Type_background__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Quote_Line_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Rate_Details_Changed__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RateDetailsMismatch</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_QL_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Should_Process_This_Quote_Line</name>
        <label>Should Process This Quote Line?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>ShouldProcessQL</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_QL_Fields</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>SALDEV-770:Update the Quote Line Type background with the value of the Quote Line Type formula field.
SALDEV-913: Added Logic for Rate Details MisMatchMatch, added update to false on 11/3</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>IsNew()</expression>
    </formulas>
    <formulas>
        <name>QuantityChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.SBQQ__Quantity__c})</expression>
    </formulas>
    <formulas>
        <name>RateDetailsMismatch</name>
        <dataType>Boolean</dataType>
        <expression>$Record.Rate_Details__c != $Record.Default_Rate_Details__c</expression>
    </formulas>
    <formulas>
        <name>RenewedSubscription</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.SBQQ__RenewedSubscription__c})</expression>
    </formulas>
    <formulas>
        <name>ShouldProcessQL</name>
        <dataType>Boolean</dataType>
        <expression>OR(
   ISBLANK($Record.Quote_Line_Type_background__c),
   $Record.Quote_Line_Type_background__c != $Record.Quote_Line_Type__c
)</expression>
    </formulas>
    <formulas>
        <name>UpgradedSubscription</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.SBQQ__UpgradedSubscription__c})</expression>
    </formulas>
    <interviewLabel>Quote Line Type background field update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Type background field update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_QL_Record</name>
        <label>Update QL Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Should_Process_This_Quote_Line</targetReference>
        </connector>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>colMismatch</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SBQQ__QuoteLine__c</objectType>
    </variables>
</Flow>
