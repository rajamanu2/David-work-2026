      table.inner-float-table {
        width: 450px;
        max-width: 450px;
        margin: 0 auto;
        table-layout: fixed;
      }
      @media only screen and (max-width: 400px) {
        .social td { width: 42px; }
        .social img {
          width: 30px;
          height: 30px;
        }
      }
