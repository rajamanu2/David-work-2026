<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Current_Ship_Date</name>
        <label>Set Current Ship Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varShipDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Ship_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Ship_Date_to_Today_and_Re_sync</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Error_Decision</name>
        <label>Error Decision?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Status_to_Sync</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>General Re-sync</defaultConnectorLabel>
        <rules>
            <name>Date_Error_Need_re_formatting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Intacct_Shipper_Error_Message__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>our transaction date</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Current_Ship_Date</targetReference>
            </connector>
            <label>Date Error, Need re-formatting</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_new_record_is_in_Intacct_set_status_to_synced</name>
        <label>If new record is in Intacct, set status to synced</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_is_now_in_Intacct</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_new_Record_Values.Intacct_Shipper_Record_No__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_new_Record_Values.Intacct_Shipper_Sync_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Synced</stringValue>
                </rightValue>
            </conditions>
            <label>Opportunity is now in Intacct</label>
        </rules>
    </decisions>
    <description>05/19/2026 (BW) - Updating so that &quot;Transaction requires a date&quot; also triggers a re-sync</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Resync System {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Resync System</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_new_Record_Values</name>
        <label>Get new Record Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_new_record_is_in_Intacct_set_status_to_synced</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Re_Set_Ship_Date</name>
        <label>Re-Set Ship Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Wait_to_set_status_to_synced</targetReference>
        </connector>
        <inputAssignments>
            <field>Ship_Date__c</field>
            <value>
                <elementReference>varShipDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Status_to_Sync</name>
        <label>Set Status to Sync</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Intacct_Shipper_Sync_Status__c</field>
            <value>
                <stringValue>Sync</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Ship_Date_to_Today_and_Re_sync</name>
        <label>Update Ship Date to Today and Re-sync</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Wait_Re_Set_Ship_Date</targetReference>
        </connector>
        <inputAssignments>
            <field>Intacct_Shipper_Sync_Status__c</field>
            <value>
                <stringValue>Sync</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Ship_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Error_Decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Intacct_Shipper_Sync_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </filters>
        <filters>
            <field>Intacct_Shipper_Timestamp__c</field>
            <operator>GreaterThan</operator>
            <value>
                <dateTimeValue>2026-01-01T05:00:00.000Z</dateTimeValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2025-10-17</startDate>
            <startTime>08:20:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varShipDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <waits>
        <name>Wait_Re_Set_Ship_Date</name>
        <elementSubtype>WaitDuration</elementSubtype>
        <label>Wait for Re-Set Ship Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Re_Set_Ship_Date</targetReference>
            </connector>
            <label>el_0</label>
            <offset>5</offset>
            <offsetUnit>Minutes</offsetUnit>
        </waitEvents>
    </waits>
    <waits>
        <name>Wait_to_set_status_to_synced</name>
        <elementSubtype>WaitDuration</elementSubtype>
        <label>Wait to set status to synced</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Get_new_Record_Values</targetReference>
            </connector>
            <label>el_1</label>
            <offset>5</offset>
            <offsetUnit>Minutes</offsetUnit>
        </waitEvents>
    </waits>
</Flow>
