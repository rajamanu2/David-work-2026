    <recordLookups>
        <name>Get_Service_Appointment_Information</name>
        <label>Get Service Appointment Information</label>
        <locationX>270</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Service_Appointment_Ship_Date_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Id</elementReference>
            </value>
        </filters>
        <object>ServiceAppointment</object>
        <outputReference>varTriggeringServiceAppointment</outputReference>
        <queriedFields>Ship_Date__c</queriedFields>
        <queriedFields>AppointmentNumber</queriedFields>
        <queriedFields>Tracking_Number__c</queriedFields>
        <queriedFields>ParentRecordId</queriedFields>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Work_Order_Line_Items</name>
        <label>Get Work Order Line Items</label>
        <locationX>490</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Work_Order_Line_Items_Found_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Service_Appointment__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varTriggeringServiceAppointment.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>WorkOrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varTriggeringServiceAppointment.ParentRecordId</elementReference>
            </value>
        </filters>
        <object>WorkOrderLineItem</object>
        <outputReference>colvarWorkOrderLineItems</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Part_Used__c</queriedFields>
        <queriedFields>Part_Name__c</queriedFields>
        <queriedFields>Part_Number_D__c</queriedFields>
        <queriedFields>Part_Name_D__c</queriedFields>
        <queriedFields>Asset_Number__c</queriedFields>
    </recordLookups>
