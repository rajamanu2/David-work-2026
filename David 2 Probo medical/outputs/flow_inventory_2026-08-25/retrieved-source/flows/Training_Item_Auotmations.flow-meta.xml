<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Approved_and_Visibility_Check</name>
        <label>Approved and Visibility Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_to_Visible_for_Quality_Only</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved_and_Not_Quality</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Document_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Department__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Quality (QMS)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_to_Visible_for_All_Users_and_Approved_By</targetReference>
            </connector>
            <label>Approved and Not Quality</label>
        </rules>
        <rules>
            <name>Approved_and_Quality</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Document_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_to_Visible_for_Quality_Only_and_Approved_By</targetReference>
            </connector>
            <label>Approved and Quality</label>
        </rules>
    </decisions>
    <decisions>
        <name>Document_Status_Changed_Check</name>
        <label>Document Status Changed Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Document_Status_is_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Document_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_and_Visibility_Check</targetReference>
            </connector>
            <label>Document Status is Changed</label>
        </rules>
    </decisions>
    <description>15/10/2025 - SP - Adjust Department not equal to Quality in the Update to Visible for All Users and Approved By Update Records element
15/10/2025 - SP - Adding Published Date to be set by the Running Flow Interview on approval routes</description>
