        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 OR 2) AND 3 AND (4 OR 5 OR 6 OR 7 OR 8) AND 9 AND 10 AND 11 AND 12</filterLogic>
        <filters>
            <field>Entity__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Probo-UK</stringValue>
            </value>
        </filters>
        <filters>
            <field>Entity__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Probo-SAS</stringValue>
            </value>
        </filters>
        <filters>
            <field>Account_Name__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Probo Medical</stringValue>
            </value>
        </filters>
        <filters>
            <field>Count_Products_with_Costs__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Asset_Summary__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Amount</field>
