<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Loops through the Work Order Line Items, adding the Part/Probe Name (D) and Asset Number for each.</description>
        <name>Build_Asset_Display_List</name>
        <label>Build Asset Display List</label>
        <locationX>754</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>varAssetDisplayTextSingle</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!recvarWorkOrderLineItem.Part_Name_D__c} - {!recvarWorkOrderLineItem.Asset_Number__c}, </stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Work_Order_Line_Items_for_Assets</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Service_Appointment_Ship_Date_Check</name>
        <label>Service Appointment Ship Date Check</label>
        <locationX>270</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Get_Work_Order_Line_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Ship_Date_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTriggeringServiceAppointment.Ship_Date__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Service_Appointment_Shipped_Screen</targetReference>
            </connector>
            <label>Ship Date Already Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Work_Order_Line_Items_Found_Check</name>
        <label>Work Order Line Items Found Check</label>
        <locationX>490</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Loop_Work_Order_Line_Items_for_Assets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Work_Order_Line_Items_Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colvarWorkOrderLineItems</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Work_Order_Line_Items_Found_Screen</targetReference>
            </connector>
            <label>Work Order Line Items Not Found</label>
        </rules>
    </decisions>
    <description>25/03/2026 - SP - updating the &quot;formulaAssetToAdd&quot; to work on mobile</description>
    <environments>Default</environments>
    <formulas>
        <name>formulatextTrackingNumber</name>
        <dataType>String</dataType>
        <expression>&quot;Taken by &quot; + {!$User.Full_Name__c}</expression>
    </formulas>
    <interviewLabel>FSL - Service Appointment - Collect Assets {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FSL - Service Appointment - Collect Assets</label>
