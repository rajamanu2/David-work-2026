<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assigns the Total Price and Quantity fields to be updated on the Canadian GST/HST Opportunity Product.</description>
        <name>Assign_GST_HST_Sales_Price</name>
        <label>Assign GST/HST Sales Price</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Opportunity_Product_GST_HST.TotalPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GSTHSTCalcFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Opportunity_Product_GST_HST.Quantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_GST_HST_Product</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>Production = 01tRo00000BBRUnIAP</description>
        <name>GSTHSTProductID</name>
        <dataType>String</dataType>
        <value>
            <stringValue>01tRo00000BBRUnIAP</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Decides if a Canadian GST/HST Opportunity Product exists.</description>
        <name>GST_HST_Product_Exists</name>
        <label>GST/HST Product Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_GST_HST_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_GST_HST_Product_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Product_GST_HST.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GST_HST_Sales_Price</targetReference>
            </connector>
            <label>Yes, GST/HST Product Exists</label>
        </rules>
    </decisions>
    <description>11/18/2025 (BW) - Added a &quot;Lock for Recursive Update&quot; system which provents the flow from triggering itself again.</description>
    <environments>Default</environments>
    <formulas>
        <name>GSTHSTCalcFormula</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.GST_HST_Amount__c} *  0.13</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Opportunity Canadian Entity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Canadian Entity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Creates a new Canadian GST/HST Opportunity Product.</description>
        <name>Create_GST_HST_Product</name>
        <label>Create GST/HST Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Unlock_for_Recursive_Updates</targetReference>
        </connector>
        <inputAssignments>
            <field>OpportunityId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PricebookEntryId</field>
            <value>
                <stringValue>01uRo00000EgRjhIAF</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ProductItem__c</field>
            <value>
                <stringValue>a06Ro00000SXccfIAD</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quantity</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TotalPrice</field>
            <value>
                <elementReference>GSTHSTCalcFormula</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordCreates>
    <recordLookups>
        <description>Gets the Canadian GST/HST Opportunity Product if it exists.</description>
        <name>Get_Opportunity_Product_GST_HST</name>
        <label>Get Opportunity Product GST/HST</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GST_HST_Product_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Product2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GSTHSTProductID</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Lock_for_Recursive_Updates</name>
        <label>Lock for Recursive Updates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity_Product_GST_HST</targetReference>
        </connector>
        <inputAssignments>
            <field>Lock_for_Recursive_Flows__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Unlock_for_Recursive_Updates</name>
        <label>Unlock for Recursive Updates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Lock_for_Recursive_Flows__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Updates the existing Canadian GST/HST Opportunity Product.</description>
        <name>Update_GST_HST_Product</name>
        <label>Update GST/HST Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Unlock_for_Recursive_Updates</targetReference>
        </connector>
        <inputReference>Get_Opportunity_Product_GST_HST</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>1 AND 2 AND (3 OR 4) AND 5</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>001U000000pNlw4IAC</stringValue>
            </value>
        </filters>
        <filters>
            <field>CurrencyIsoCode</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CAD</stringValue>
            </value>
        </filters>
        <filters>
            <field>Count_All_Products_on_Opp__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Total_Sales_Price__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Lock_for_Recursive_Flows__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Lock_for_Recursive_Updates</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
