<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Decides if today is the 28th in order to run. EVERY month has a 28th.</description>
        <name>Run_Today</name>
        <label>Run Today</label>
        <locationX>766</locationX>
        <locationY>333</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TodaysDay</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Draws</targetReference>
            </connector>
            <label>Is Today</label>
        </rules>
    </decisions>
    <description>Creates the draws for reps for the upcoming month</description>
    <formulas>
        <description>Sets current date time</description>
        <name>CurrentDateTime</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <description>Sets the end date of the draw</description>
        <name>EndDateFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE ( IF(
  MONTH( DATEVALUE( {!CurrentDateTime} ) ) = 12,
  DATE( YEAR( DATEVALUE( {!CurrentDateTime} ) ) +1 , 1, 1 ),
  DATE( YEAR( DATEVALUE( {!CurrentDateTime} ) ), MONTH ( DATEVALUE( {!CurrentDateTime} ) ) + 1, 1 ) 
) )</expression>
    </formulas>
    <formulas>
        <name>RecordNameCreate</name>
        <dataType>String</dataType>
        <expression>{!$Record.LastName} &amp; &quot; &quot; &amp;
CASE(MONTH(DATEVALUE({!CurrentDateTime})),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;, 
4, &quot;April&quot;, 
5, &quot;May&quot;, 
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;None&quot;)</expression>
    </formulas>
    <formulas>
        <name>ThisMonthDraw</name>
        <dataType>Currency</dataType>
        <expression>IF({!Get_Draws.Draw_Difference__c}&lt; 0,{!$Record.Monthly_Draw_Amount__c},{!$Record.Monthly_Draw_Amount__c} +{!Get_Draws.Draw_Difference__c} )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Decides if today is the 28th</description>
        <name>TodaysDay</name>
        <dataType>Number</dataType>
        <expression>Day(Today())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Finds yesterdays date</description>
        <name>Yesterday</name>
        <dataType>DateTime</dataType>
        <expression>Now() - 1</expression>
    </formulas>
    <interviewLabel>Create Master Draws {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Master Draws</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create Draws for the next month</description>
        <name>Create_New_Draw</name>
        <label>Create New Draw</label>
        <locationX>779</locationX>
        <locationY>671</locationY>
        <inputAssignments>
            <field>End_Date__c</field>
            <value>
                <elementReference>EndDateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>RecordNameCreate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Draw__c</field>
            <value>
                <elementReference>Get_Draws.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Month_Roll_Over__c</field>
            <value>
                <elementReference>Get_Draws.Draw_Difference__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rep_Name__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Start_Date__c</field>
            <value>
                <elementReference>CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>This_Months_Draw__c</field>
            <value>
                <elementReference>ThisMonthDraw</elementReference>
            </value>
        </inputAssignments>
        <object>Master_Draw__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get last months draw</description>
        <name>Get_Draws</name>
        <label>Get Draws</label>
        <locationX>779</locationX>
        <locationY>508</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_New_Draw</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Rep_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>End_Date__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>Yesterday</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Master_Draw__c</object>
        <sortField>End_Date__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>649</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Run_Today</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Monthly_Draw_Amount__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>User</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2021-01-01</startDate>
            <startTime>01:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
