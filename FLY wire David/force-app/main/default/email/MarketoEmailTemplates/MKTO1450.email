<td width="100%" valign="top" align="center" class="st-dynamic-828-16" style="padding-bottom: 40px; width: 100%;"><a href="https://www.eqkualalumpur.equatorial.com/dining/sabayon/?utm_source=marketo&amp;utm_medium=email&amp;utm_campaign=" target="_blank" style="display: block;"><img border="0" valign="top" width="560" src="https://www.cdnrcad8t.com/7qyflwemdj/en_us/images/659e11b43a457-1704858036.2387.png" alt="image " title="" class="st-mobile-width-constraint" style="border: 0px; display: block; width: 560px; max-width: 100%;" /> </a></td> 
