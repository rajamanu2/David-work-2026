        <expression>{!Get_Original_Opportunity_Product_Cancellation.Commissions_Net_ARR__c} * (-1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ContingencyARR</name>
        <dataType>Number</dataType>
        <expression>IF(
    {!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c} &gt; 1,  
    {!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c} * 
    ({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c} / 100) *
    ({!$Record.Opportunity.Contract_Paper_Factor__c} / 100), 
    {!$Record.Opportunity.Ship_To_Account__r.Net_Patient_Revenue__c} * 0.00035 * 
    (({!$Record.Opportunity.Contract_Paper_Factor__c} / 100) / 0.015) *
    ({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c} / 100)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ContingencyFeeRevenueCalculated</name>
        <dataType>String</dataType>
        <expression>&quot;Contingency Fee - &quot; +
IF(
{!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c}&gt;1,
TEXT({!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c}) + &quot; * &quot; +
TEXT({!$Record.SBQQ__QuoteLine__r.Avg_Quoted_Rate__c}),
TEXT({!$Record.Opportunity.Ship_To_Account__r.Net_Patient_Revenue__c}) + &quot; * 0.00035 * (&quot; +
TEXT({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}) + &quot;) * &quot; +
TEXT({!$Record__Prior.Opportunity.Contract_Paper_Factor__c})
)
+ &quot; Calculated: &quot; + 
TEXT( NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <name>EpicSecureUsageARR</name>
        <dataType>Number</dataType>
        <expression>IF(
    {!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c} &gt; 1, 
    {!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c} * 0.0004, 
    {!$Record.Opportunity.Ship_To_Account__r.Net_Patient_Revenue__c} * 0.00003 * ({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c} / 0.25)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>EpicSecureUsageRevenueCalculated</name>
        <dataType>String</dataType>
        <expression>&quot;Epic Secure Checkout Usage - &quot; +
IF(
{!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c}&gt;1,
TEXT({!$Record.Opportunity.Annual_Expected_Self_Pay_USD__c}) + &quot; * 0.0004 &quot;,
TEXT({!$Record.Opportunity.Ship_To_Account__r.Net_Patient_Revenue__c}) + &quot; * 0.00002 * (&quot; +
TEXT({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c}) + &quot;)&quot;
)
+ &quot; Calculated: &quot; + 
TEXT( NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <name>IntegratedFinancingARR</name>
        <dataType>Number</dataType>
        <expression>IF(
    {!$Record.Opportunity.Annual_Plan_Origination_USD__c} &gt; 1, 
    {!$Record.Opportunity.Annual_Plan_Origination_USD__c} * 0.0276, 
    {!$Record.Opportunity.Ship_To_Account__r.Net_Patient_Revenue__c} * 0.0002
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>IntegratedFinancingRevenueCalculated</name>
        <dataType>String</dataType>
        <expression>&quot;Integrated Financing - &quot; +
IF(
{!$Record.Opportunity.Annual_Plan_Origination_USD__c}&gt;1,
TEXT({!$Record.Opportunity.Annual_Plan_Origination_USD__c}) + &quot; * 0.0276&quot;,
TEXT({!$Record.Opportunity.Ship_To_Account__r.Net_Patient_Revenue__c}) + &quot; * 0.0002&quot;
)
+ &quot; Calculated: &quot; + 
TEXT( NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <description>Merchant Processing BPS ARR = (BPS Up charge / 10000) x Processed Volume $</description>
        <name>MerchantProcessingBPSARR</name>
        <dataType>Number</dataType>
        <expression>({!$Record.SBQQ__QuoteLine__r.BPS_Upcharge__c} / 10000) *
{!$Record.SBQQ__QuoteLine__r.Processed_Volume_Amount__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Merchant Processing BPS Net Price = ((BPS Upcharge - 5 / 10000)) * Processed Volume $</description>
        <name>MerchantProcessingBPSNetPrice</name>
        <dataType>Number</dataType>
        <expression>(({!$Record.SBQQ__QuoteLine__r.BPS_Upcharge__c} - 3) / 10000) *
{!$Record.SBQQ__QuoteLine__r.Processed_Volume_Amount__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>MerchantProcessingBPSRevenueCalculated</name>
        <dataType>String</dataType>
        <expression>&quot;Merchant Processing ARR Automation: (Opp Product) Healthcare ARR - Resources: MerchantProcessingBPSARR, MerchantProcessingBPSNetPrice&quot;</expression>
    </formulas>
    <formulas>
        <description>Merchant Processing Interchange ARR = Processed Volume $ * Interchange Rate</description>
        <name>MerchantProcessingInterchangeARR</name>
        <dataType>Number</dataType>
        <expression>{!$Record.SBQQ__QuoteLine__r.Processed_Volume_Amount__c} * ({!$Record.SBQQ__QuoteLine__r.Interchange_Rate__c} / 100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>MerchantProcessingInterchangeRevenueCalculated</name>
        <dataType>String</dataType>
        <expression>&quot;Merchant Processing ARR Automation: (Opp Product) Healthcare ARR - Resource: MerchantProcessingInterchangeARR&quot;</expression>
    </formulas>
    <formulas>
        <description>Merchant Processing TX ARR = Per Transaction Upcharge * Processed Volume #</description>
        <name>MerchantProcessingTXARR</name>
        <dataType>Number</dataType>
        <expression>{!$Record.SBQQ__QuoteLine__r.Per_Transaction_Upcharge__c} *
{!$Record.SBQQ__QuoteLine__r.No_Processed_Volume__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Merchant Processing TX Net Price = (Per Transaction Upcharge - 0.08) * Processed Volume #</description>
        <name>MerchantProcessingTXNetPrice</name>
        <dataType>Number</dataType>
        <expression>IF(
    {!$Record.SBQQ__QuoteLine__r.Per_Transaction_Upcharge__c} - 0.04 &gt; 0,
    ({!$Record.SBQQ__QuoteLine__r.Per_Transaction_Upcharge__c} - 0.04) * {!$Record.SBQQ__QuoteLine__r.No_Processed_Volume__c},
    0
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>MerchantProcessingTXRevenueCalculated</name>
        <dataType>String</dataType>
        <expression>&quot;Merchant Processing ARR Automation: (Opp Product) Healthcare ARR - Resources: MerchantProcessingTXARR, MerchantProcessingTXNetPrice&quot;</expression>
    </formulas>
