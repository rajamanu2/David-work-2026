    <description>06/04/26 (GD) – DLRS-replacement: Loaner_Assets_Roll_Up (before delete). Loop over Transform: no ConcatenateDistinct, formula field (ProductItem__r.Name), no delimiter/truncation control.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Asset_In_String</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Asset} &amp; &quot;,&quot;, &quot;,&quot; &amp; {!Loop_Through_Loaner_Assets.Loaner_Asset__c} &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Trimmed_Asset</name>
        <dataType>String</dataType>
        <expression>LEFT(IF(RIGHT({!Concatenated_Asset}, 1) = &quot;,&quot;, LEFT({!Concatenated_Asset}, LEN({!Concatenated_Asset}) - 1), {!Concatenated_Asset}), 255)</expression>
    </formulas>
