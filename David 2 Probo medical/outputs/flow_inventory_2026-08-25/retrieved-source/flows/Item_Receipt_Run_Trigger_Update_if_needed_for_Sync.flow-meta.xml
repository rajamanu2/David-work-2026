            <targetReference>Update_to_Re_sync</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_associated_account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Intacct_Receipt_Error_Message__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>has no associated Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Inventory_Vs_Non_Inventory</targetReference>
            </connector>
            <label>No associated account</label>
        </rules>
    </decisions>
