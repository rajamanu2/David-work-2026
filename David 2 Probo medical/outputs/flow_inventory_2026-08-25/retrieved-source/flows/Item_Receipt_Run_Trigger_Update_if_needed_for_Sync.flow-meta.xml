            </connector>
            <label>Products Missing GL Accounts</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_Current_Product_have_a_Purchasing_GL_Account</name>
        <label>Does Current Product have a Purchasing GL Account?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_for_Product_Account_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Does_not_have_purchasing_GL_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_for_Product_Account_Check.Product2__r.Purchasing_GL_Account__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Product_to_List_of_Products_Needing_Purchasing_GL_Account</targetReference>
            </connector>
            <label>Does not have purchasing GL Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Inventory_Vs_Non_Inventory</name>
        <label>Inventory Vs Non-Inventory</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Run_Trigger_Update_to_Correct_Issues</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Non_Inventory</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Item_Receipt_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-Inventory</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IR_Products</targetReference>
            </connector>
            <label>Non-Inventory</label>
        </rules>
    </decisions>
