    <formulas>
        <name>DurationFormula</name>
        <dataType>Number</dataType>
        <expression>ROUND( 8 * (
   ( 5 * FLOOR( ( DATEVALUE( {!Loop_SAs_to_Create.Scheduled_End}) - DATE( 1900, 1, 8) ) / 7) +
    MIN(5, 
     MOD( DATEVALUE( {!Loop_SAs_to_Create.Scheduled_End} ) - DATE( 1900, 1, 8), 7) +
     MIN( 1, 24 / 8 * ( MOD( {!Loop_SAs_to_Create.Scheduled_End} - DATETIMEVALUE( &apos;1900-01-08 16:00:00&apos; ), 1 ) ) )
    ) 
   )
 -
   ( 5 * FLOOR( ( DATEVALUE( {!Loop_SAs_to_Create.Scheduled_Start} ) - DATE( 1900, 1, 8) ) / 7) +
     MIN( 5,
      MOD( DATEVALUE( {!Loop_SAs_to_Create.Scheduled_Start} ) - DATE( 1996, 1, 1), 7 ) +
      MIN( 1, 24 / 8 * ( MOD( {!Loop_SAs_to_Create.Scheduled_Start} - DATETIMEVALUE( &apos;1900-01-08 16:00:00&apos; ), 1) ) )
    )
   ) 
  ), 
0 )</expression>
        <scale>2</scale>
    </formulas>
