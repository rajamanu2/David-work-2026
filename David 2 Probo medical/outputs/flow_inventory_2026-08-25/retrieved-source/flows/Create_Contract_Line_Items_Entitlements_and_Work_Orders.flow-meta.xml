    <formulas>
        <name>AssignservicedatenumberworkorderPM</name>
        <dataType>Number</dataType>
        <expression>365 - ((365/{!Get_service_contract.Number_of_PMs__c}) * ({!CounterforWorkOrderDates} - 1)) - 30</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Assignservicedateworkorder</name>
        <dataType>Date</dataType>
        <expression>{!YearlyEntitlementStartDate}+ {!AssignservicedatenumberworkorderPM}</expression>
    </formulas>
    <formulas>
        <name>PCIDate</name>
        <dataType>Date</dataType>
        <expression>{!Get_service_contract.StartDate}</expression>
    </formulas>
    <formulas>
        <name>TermInYears</name>
        <dataType>Number</dataType>
        <expression>YEAR({!Get_service_contract.EndDate}) - YEAR({!Get_service_contract.StartDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TodaysDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>YearlyEntitlementEndDate</name>
        <dataType>Date</dataType>
        <expression>{!Get_service_contract.EndDate}  - (365*({!YearCounter} - 1))</expression>
    </formulas>
    <formulas>
        <name>YearlyEntitlementStartDate</name>
        <dataType>Date</dataType>
        <expression>{!Get_service_contract.StartDate}  + (365*({!TermInYears} - {!YearCounter}))</expression>
    </formulas>
