    <description>26/03/2026 - SP - Adding Ultrasound Electrical Safety Test.</description>
    <environments>Default</environments>
    <formulas>
        <description>This is used to return the developer name of the Service Report Template related to the Checklist Type.</description>
        <name>formulaServiceReportLayoutDeveloperName</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.Checklist_Type__c},

    &quot;C-Arm&quot;, &quot;C-Arm - Preventive Maintenance - Service Report Template&quot;,
    &quot;Cardio Labs&quot;, &quot;Cardio Labs - Preventive Maintenance - Service Report Template&quot;,
    &quot;CT&quot;, &quot;CT - Preventive Maintenance - Service Report Template&quot;,
    &quot;Dental&quot;, &quot;Dental - Preventive Maintenance - Service Report Template&quot;,
    &quot;DEXA&quot;, &quot;DEXA - Preventive Maintenance - Service Report Template&quot;,
    &quot;Injector&quot;, &quot;Injector - Preventive Maintenance - Service Report Template&quot;,
    &quot;Intraoral&quot;, &quot;Intraoral - Preventive Maintenance - Service Report Template&quot;,
    &quot;Iradimed Infusion Pump&quot;, &quot;Iradimed Infusion Pump - Preventive Maintenance - Service Report Template&quot;,
    &quot;Iradimed Patient Monitor&quot;, &quot;Iradimed Patient Monitor - Preventive Maintenance - Service Report Template&quot;,
    &quot;Mammography&quot;, &quot;Mammography - Preventive Maintenance - Service Report Template&quot;,
    &quot;Mobile X-Ray&quot;, &quot;Mobile X-Ray - Preventive Maintenance - Service Report Template&quot;,
    &quot;MRI&quot;, &quot;MRI - Preventive Maintenance - Service Report Template&quot;,
    &quot;Static Fluoro&quot;, &quot;Static Fluoro - Preventive Maintenance - Service Report Template&quot;,
    &quot;Static X-Ray CR&quot;, &quot;Static X-Ray CR - Preventive Maintenance - Service Report Template&quot;,
    &quot;Static X-Ray DDR&quot;, &quot;Static X-Ray DDR - Preventive Maintenance - Service Report Template&quot;,
    &quot;Ultrasound&quot;, &quot;PPM Ultrasound&quot;,
    &quot;Ultrasound Electrical Safety Test&quot;, &quot;PPM Ultrasound&quot;,
    &quot;Ultrasound Pre-Contract Inspection&quot;, &quot;Ultrasound - Pre-Contract Inspection - Service Report Template&quot;,
    &quot;CR Reader&quot;, &quot;CR Reader - Preventive Maintenance - Service Report Template&quot;,
    &quot;Nuclear Medicine&quot;, &quot;Nuclear Medicine - Preventive Maintenance - Service Report Template&quot;,
    &quot;C-Arm Pre-Contract Inspection&quot;, &quot;C-Arm - Pre-Contract Inspection - Service Report Template&quot;,

    NULL
)</expression>
    </formulas>
    <interviewLabel>FSL - Work Order - {!$Flow.CurrentDateTime}</interviewLabel>
