    <formulas>
        <name>formulaCLIStartDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!Loop_Through_CLIs.StartDate})</expression>
    </formulas>
    <formulas>
        <name>formulaConvertCoverageDurationMStoBusinessHours</name>
        <dataType>Number</dataType>
        <expression>{!Calculate_Running_Coverage_Duration_Business_Hours} / 1000 / 60 / 60</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Determines the first day of the current quarter based on today’s date and returns it as a DateTime value.</description>
        <name>formulaCurrentQuarterStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  DATE(
    YEAR(TODAY()),
    CASE(
      CEILING(MONTH(TODAY())/3),
      1, 1,
      2, 4,
      3, 7,
      4, 10,
      1
    ),
    1
  )
)</expression>
    </formulas>
    <formulas>
        <name>formulaEffectiveEnd</name>
        <dataType>DateTime</dataType>
        <expression>IF(
  ISBLANK({!Loop_Through_CLIs.EndDate}),
  {!formulaLastQuarterEnd},
  IF(
    DATETIMEVALUE({!Loop_Through_CLIs.EndDate}) + (1 - (1/86400)) &lt; {!formulaLastQuarterEnd},
    DATETIMEVALUE({!Loop_Through_CLIs.EndDate}) + (1 - (1/86400)),
    {!formulaLastQuarterEnd}
  )
)</expression>
    </formulas>
    <formulas>
        <name>formulaEffectiveStart</name>
        <dataType>DateTime</dataType>
        <expression>IF(
  DATETIMEVALUE({!Loop_Through_CLIs.StartDate}) &gt; {!formulaLastQuarterStart},
  DATETIMEVALUE({!Loop_Through_CLIs.StartDate}),
  {!formulaLastQuarterStart}
)</expression>
    </formulas>
    <formulas>
        <description>Returns 11:59:59 PM on the last day of the previous calendar quarter.</description>
        <name>formulaLastQuarterEnd</name>
        <dataType>DateTime</dataType>
        <expression>{!formulaCurrentQuarterStart} - (1/86400)</expression>
    </formulas>
    <formulas>
        <name>formulaLastQuarterStart</name>
        <dataType>DateTime</dataType>
        <expression>ADDMONTHS({!formulaCurrentQuarterStart}, -3)</expression>
    </formulas>
    <formulas>
        <name>formulaTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
