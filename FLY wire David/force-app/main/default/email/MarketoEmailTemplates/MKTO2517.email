<td width="100%" valign="top" align="center" class="st-dynamic-tbecjs8sm6tqm" style="padding-top: 40px; padding-bottom: 40px; width: 100%;"><img border="0" valign="top" width="240" src="https://www.cdnrcad8t.com/c9howft0ap/en_us/images/60216eb98b9c1-1612803769.5718.png" alt="Flywire Logo" title="" class="st-mobile-width-constraint" style="border: 0px; display: block; width: 240px; max-width: 100%;" /> </td> 
