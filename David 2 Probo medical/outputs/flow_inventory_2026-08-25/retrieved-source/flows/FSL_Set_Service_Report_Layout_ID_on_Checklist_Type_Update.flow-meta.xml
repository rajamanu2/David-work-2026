        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ServiceReportTemplateId</field>
            <value>
                <elementReference>Get_Service_Report_Layout.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Work_Order__r</inputReference>
    </recordUpdates>
    <start>
