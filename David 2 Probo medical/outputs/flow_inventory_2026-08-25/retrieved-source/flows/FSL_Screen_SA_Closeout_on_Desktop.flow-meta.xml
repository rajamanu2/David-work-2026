    <description>07/27/2026 - SP - Amending the Flow to set the &quot;Status&quot; field to &quot;Paperwork to be Sent&quot; when the Work Order&apos;s &quot;Modality&quot; is not &quot;Ultrasound&quot;.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaStatus</name>
        <dataType>String</dataType>
        <expression>IF(
    {!Appointment_Status} = &quot;Cannot Complete&quot;,
    &quot;Cannot Complete&quot;,
    IF(
        {!varModality} &lt;&gt; &quot;Ultrasound&quot;,
        &quot;Paperwork to be Sent&quot;,
        &quot;Completed&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <description>If Hours required (from parts screen) is blank, use the value from hours required for follow up (from follow up visit screen)</description>
        <name>HoursFinal</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!Hour_s_Required})=TRUE, {!Hours_Required_for_Follow_Up_Visit}, {!Hour_s_Required} )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Since these 2 entry fields will go into a single field, utilizing this formula will allow a single entry unless parts are not required</description>
        <name>HoursFormula</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!Hour_s_Required})=FALSE, {!Hour_s_Required}, NULL)</expression>
        <scale>2</scale>
    </formulas>
