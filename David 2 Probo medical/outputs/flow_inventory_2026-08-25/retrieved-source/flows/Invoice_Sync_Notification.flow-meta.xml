    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Intacct_Invoice_Sync_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Opportunity_Entity__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Probo-UK</stringValue>
            </value>
        </filters>
        <filters>
            <field>Entity_Location__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Probo-SAS</stringValue>
            </value>
        </filters>
        <object>Invoice__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
