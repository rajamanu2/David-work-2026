<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Chatter_RMA_Created_Probe_Repair</name>
        <label>Send RMA Created Mobile Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <stringValue>0MLRo000000UCdFOAW</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>varEngineerIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <elementReference>formRMACreatedTitle</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>TT_RMACreatedBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Engineer_Recipient</name>
        <label>Assign Engineer Recipient</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEngineerIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Work_Order__r.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Chatter_RMA_Created_Probe_Repair</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>DEC_Check_Conditions</name>
        <label>Check WO and Opp Conditions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Conditions Not Met — Stop</defaultConnectorLabel>
        <rules>
            <name>All_Conditions_Met</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Work_Order__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Work_Order__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FSL_Work_Order</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Work_Order__r.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Work_Order__r.Opportunity__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Probe_Repair_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Engineer_Recipient</targetReference>
            </connector>
            <label>All Conditions Met</label>
        </rules>
    </decisions>
    <description>06/01/26 (BW) – Created to send a mobile push notification to the engineer (WO owner) when an RMA is created on a Probe Repair Work Order; scoped to FSL Work Order record type, US country, and Probe Repair Opportunity record type only</description>
    <environments>Default</environments>
    <formulas>
        <name>formRMACreatedTitle</name>
        <dataType>String</dataType>
        <expression>&quot;New RMA on WO &quot; &amp; {!$Record.Work_Order__r.WorkOrderNumber} &amp; &quot; | Type: &quot; &amp; {!$Record.RMA_Type__c}</expression>
    </formulas>
    <interviewLabel>RMA Notify Engineer on Probe Repair WO Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RMA | Notify Engineer on Probe Repair WO Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>RMA__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>DEC_Check_Conditions</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>TT_RMACreatedBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>A new {!$Record.RMA_Type__c} RMA ({!$Record.Name}) has been created for Work Order {!$Record.Work_Order__r.WorkOrderNumber}. Tap to view the RMA.</text>
    </textTemplates>
    <variables>
        <name>varEngineerIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
