                <elementReference>Loop_contracts.SBQQ__RenewalOpportunity__r.SBQQ__PrimaryQuote__r.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteList.AutoRenewed_Completed__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>QuoteList</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_contracts</targetReference>
        </connector>
