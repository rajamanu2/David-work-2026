    <description>Questionnaire to see if we should allow Rep to request a bid for this RFP. With Override Instructions. SAL-4764 Updated 12/02/2024 to preven close date in the past validation error</description>
    <environments>Default</environments>
    <formulas>
        <description>Add up the answers to determine if we bid or not</description>
        <name>sumQs</name>
        <dataType>Number</dataType>
        <expression>If( {!Q1} = &quot;Yes&quot;, 1, 0) +
If ( {!Q2} = &quot;Yes&quot;, 1, 0) +
If ( {!Q3} = &quot;Yes&quot;, 1, 0) +
If ( {!Q4} = &quot;Yes&quot;, 1, 0) +
If ( {!Q5} = &quot;Yes&quot;, 1, 0) +
If ( {!Q6} = &quot;Yes&quot;, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
