        <name>Are_Products_Missing_GL_Accounts</name>
        <label>Are Products Missing GL Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Products_Missing_GL_Accounts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varListofProductsNeedingPurchasingAccount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
