<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>addToSum</name>
        <label>Add to Sum and Increment Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSum</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>loopProductItems.Working_Capital_Usage_Days__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopProductItems</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>calculateAverage</name>
        <label>Calculate Average</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAvg</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaAvg</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>getOpportunity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>initializeVars</name>
        <label>Initialize Variables</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSum</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>getRelatedProductItems</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>setAvgOnOpportunity</name>
        <label>Set Average on Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOpportunity.Working_Capital_Usage_Days__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAvg</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>updateOpportunity</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>checkCountGreaterThanZero</name>
        <label>Has Records to Average?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Records (Skip Update)</defaultConnectorLabel>
        <rules>
            <name>countGreaterThanZero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>calculateAverage</targetReference>
            </connector>
            <label>Has Records</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkOppIdNotNull</name>
        <label>Opportunity ID Not Null?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Opportunity (Skip)</defaultConnectorLabel>
        <rules>
            <name>oppIdNotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Purchasing_Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>initializeVars</targetReference>
            </connector>
            <label>Has Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkValueNotNull</name>
        <label>Working Capital Value Not Null?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>loopProductItems</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Null (Skip)</defaultConnectorLabel>
        <rules>
            <name>valueNotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loopProductItems.Working_Capital_Usage_Days__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>addToSum</targetReference>
            </connector>
            <label>Has Value</label>
        </rules>
    </decisions>
    <description>05/13/26 (BW) – Async record-triggered flow on ProductItem__c that recalculates the average Working_Capital_Usage_Days__c on the parent Opportunity via Purchasing_Opportunity__c lookup. Runs asynchronously after commit to avoid SOQL limits. Mirrors the DLRS rollup [ACTIVE] Working Capital Usage Days Roll Up.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaAvg</name>
        <dataType>Number</dataType>
        <expression>{!varSum} / {!varCount}</expression>
        <scale>4</scale>
    </formulas>
    <interviewLabel>Working Capital Usage Days Roll Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Working Capital Usage Days Roll Up</label>
    <loops>
        <name>loopProductItems</name>
        <label>Loop Product Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varProductItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>checkValueNotNull</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>checkCountGreaterThanZero</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getOpportunity</name>
        <label>Get Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>setAvgOnOpportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Purchasing_Opportunity__c</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>varOpportunity</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Working_Capital_Usage_Days__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>getRelatedProductItems</name>
        <label>Get Related Product Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>loopProductItems</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Purchasing_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Purchasing_Opportunity__c</elementReference>
            </value>
        </filters>
        <object>ProductItem__c</object>
        <outputReference>varProductItems</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Working_Capital_Usage_Days__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>updateOpportunity</name>
        <label>Update Opportunity Average</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varOpportunity</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Working_Capital_Usage_Days__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Purchasing_Opportunity__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>ProductItem__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>checkOppIdNotNull</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>varAvg</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>4</scale>
    </variables>
    <variables>
        <name>varCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varOpportunity</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
    <variables>
        <name>varProductItems</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ProductItem__c</objectType>
    </variables>
    <variables>
        <name>varSum</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>4</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
