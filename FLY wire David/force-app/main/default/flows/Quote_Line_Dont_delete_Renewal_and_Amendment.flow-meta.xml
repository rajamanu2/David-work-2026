<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Error_Message</name>
        <label>Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>{!Error_message_template}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Item_Type</name>
        <label>Item Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Renewal_Type</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote_Line_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote_Line_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Amendment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message</targetReference>
            </connector>
            <label>Renewal</label>
        </rules>
    </decisions>
    <description>SAL-6453  Displays an error message preventing users from deleting quote line item(s) belonging to a renewal or amendment under the related list for quote line items on the quote record page layout.</description>
    <environments>Default</environments>
    <interviewLabel>(Quote Line) Dont delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(Quote Line) Dont delete Renewal and Amendment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Item_Type</targetReference>
        </connector>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Error_message_template</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>The quote line item you are trying to delete is an active product subscription under the CPQ contract and can not be deleted.

Only use the Quote Line Editor (QLE) to make changes to product selections within the quote. You can cancel an active product subscription by updating the quantity of the product to 0 in the QLE. If a active product subscription can not be cancelled by updating the quantity to 0 (zero), please submit a Jira ticket to the Salesforce team to resolve this error.

To make changes to active product subscriptions, please access the quote line editor by clicking on the &apos;Edit Lines&apos; button on the quote record.</text>
    </textTemplates>
</Flow>
