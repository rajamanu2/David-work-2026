    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetQuote</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.Pricebook2.Name} = &apos;CPQ&apos;,
    NOT(ISPICKVAL({!$Record.Type},&apos;Statement of Work&apos;)),
    {!$Record.RecordType.DeveloperName} != &apos;Agents&apos;,
    {!$Record.RecordType.DeveloperName} != &apos;Healthcare&apos;,
    {!$Record.RecordType.DeveloperName} != &apos;Healthcare_SOW&apos;,
    {!$Record.RecordType.DeveloperName} != &apos;Bank_PSP_Partner&apos;,
    {!$Record.RecordType.DeveloperName} != &apos;Strategic_Partner&apos;,
    ISCHANGED({!$Record.StageName}),
    ISPICKVAL({!$Record.StageName},&apos;Legal&apos;),
    NOT(ISPICKVAL({!$Record.Type}, &quot;Auto Renewal&quot;)) 
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
