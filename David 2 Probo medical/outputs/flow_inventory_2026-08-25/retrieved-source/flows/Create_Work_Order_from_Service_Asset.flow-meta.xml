    <formulas>
        <description>Checks for Billing Street on asset, if it doesn&apos;t exist it pulls the account billing address</description>
        <name>frmBillingStreet</name>
        <dataType>String</dataType>
        <expression>&apos;1&apos;</expression>
    </formulas>
    <formulas>
        <description>OpportunityID for the Service Contract</description>
        <name>frmContractOpportunityId</name>
        <dataType>String</dataType>
        <expression>{!Get_Service_Asset.Contract_Line_Item__r.ServiceContract.Opportunity__r.Id}</expression>
    </formulas>
    <formulas>
        <description>Defaults to P1 if the customer is GE Precision Healthcare</description>
        <name>frmDefaultShipType</name>
        <dataType>String</dataType>
        <expression>IF ({!varWO.Account.Name}=&apos;GE PRECISION HEALTHCARE LLC&apos;, &apos;FedEx Priority P1 (Priority Overnight)&apos;,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <description>Use record type and asset info to default work order description</description>
        <name>frmWODescription</name>
        <dataType>String</dataType>
        <expression>{!Work_Order_Type} &amp; &apos; Order for &apos; &amp; {!varWO.System_Serial_Number__c} &amp; &apos; &apos; &amp; TEXT(YEAR(TODAY())) &amp; &apos;-&apos; &amp; 
LPAD(TEXT(MONTH(TODAY())), 2, &apos;0&apos;) &amp; &apos;-&apos; &amp; 
LPAD(TEXT(DAY(TODAY())), 2, &apos;0&apos;)</expression>
    </formulas>
