    <decisions>
        <name>Loaner_Changed_Decision</name>
        <label>Loaner Changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Current_Parent_Shipments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Changed</defaultConnectorLabel>
        <rules>
            <name>Loaner_Was_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loaner_Changed_Formula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
