        <object>Change_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Change_Requests</name>
        <label>Get Existing Change Requests</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Existing_Change_Request_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Related_Document_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ExistingDocument.recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Change_Request_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Published</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Change_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Training_Item</name>
