            </connector>
            <label>Yes, Associated with WOLI</label>
        </rules>
    </decisions>
    <decisions>
        <name>is_WOLI_DOA</name>
        <label>is WOLI DOA/Unused/Exchange Return?</label>
        <locationX>1144</locationX>
        <locationY>708</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Add_Current_Opp_Line_to_List_for_Transform</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>1 OR 2 OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Opportunity_Products.Work_Order_Line_Item__r.Line_Intent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DOA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Opportunity_Products.Work_Order_Line_Item__r.Line_Intent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unused</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Opportunity_Products.Work_Order_Line_Item__r.Line_Intent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Exchange</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Opportunity_Products.Work_Order_Line_Item__r.Line_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Part Return</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Opportunity_Products</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
