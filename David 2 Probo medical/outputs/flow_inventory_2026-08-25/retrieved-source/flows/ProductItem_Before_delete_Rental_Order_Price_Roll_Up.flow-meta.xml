<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>06/03/26 (GD) – Replaces DLRS Rental_Order_Price rule (on delete). Runs synchronously before delete (Salesforce does not support async after-delete flows). Queries remaining ProductItems on the Rental Order (excluding the record being deleted) and writes the summed Sales_Price__c to Rental_Order__c.Rental_Amount__c. Entry criteria guards against null Rental_Order__c to avoid unnecessary SOQL.</description>
    <environments>Default</environments>
    <interviewLabel>ProductItem | Before delete, Rental Order Price Roll Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ProductItem | Before delete, Rental Order Price Roll Up</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_ProductItems_on_Rental_Order</name>
        <label>Get All ProductItems on Rental Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Sum_Sales_Price_for_Rental_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Rental_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Rental_Order__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ProductItem__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Rental_Order_Amount</name>
        <label>Update Rental Order Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Rental_Order__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Rental_Amount__c</field>
            <value>
                <elementReference>Sum_Sales_Price_for_Rental_Order</elementReference>
            </value>
        </inputAssignments>
        <object>Rental_Order__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_ProductItems_on_Rental_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Rental_Order__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ProductItem__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <transforms>
        <name>Sum_Sales_Price_for_Rental_Order</name>
        <label>Sum Sales Price for Rental Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Rental_Order_Amount</targetReference>
        </connector>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <scale>2</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <inputParameters>
                    <name>aggregationValues</name>
                    <value>
                        <elementReference>Get_All_ProductItems_on_Rental_Order</elementReference>
                    </value>
                </inputParameters>
                <inputParameters>
                    <name>aggregationFieldReference</name>
                    <value>
                        <complexValue>{&quot;dataType&quot;:&quot;SObject&quot;,&quot;objectType&quot;:&quot;ProductItem__c&quot;,&quot;fieldReferences&quot;:[&quot;Sales_Price__c&quot;],&quot;elementReference&quot;:&quot;Get_All_ProductItems_on_Rental_Order&quot;}</complexValue>
                        <complexValueType>FieldReference</complexValueType>
                    </value>
                </inputParameters>
                <transformType>Sum</transformType>
            </transformValueActions>
        </transformValues>
    </transforms>
</Flow>
