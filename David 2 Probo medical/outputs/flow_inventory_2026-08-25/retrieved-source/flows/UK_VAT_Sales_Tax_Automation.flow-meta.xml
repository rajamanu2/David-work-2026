<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>If the Account&apos;s location is outside of the UK then don&apos;t run.</description>
        <name>Account_Location_Check</name>
        <label>Account Location Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>VAT_Exempt_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Address_is_not_in_the_UK</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.BillingCountry</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>United Kingdom</stringValue>
                </rightValue>
            </conditions>
            <label>Address is not in the UK</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if the &quot;VAT Exempt Account&quot; checkbox has been ticked or not.</description>
        <name>VAT_Exempt_Check</name>
        <label>VAT Exempt Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Sales_Tax_Field</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>VAT_Exempt_Checket</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.VAT_Exempt_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>VAT Exempt Checket</label>
        </rules>
    </decisions>
    <description>28/11/2025 - V1 - SP - This Flow has been designed to enter 20% of the &quot;GST/HST Amount&quot; on UK Opportunities.
28/11/2025 - V2 - SP - Updating the decision to look at the &quot;Billing Country&quot; instead of the &quot;Billing Address&quot;.
28/11/2025 - V3 - SP - Updating the decision to have &quot;Does Not Equal&quot; instead of &quot;Equals&quot;.
28/11/2025 - V4 - SP - Adding second decision to check &quot;VAT Exempt Checkbox&quot;.
02/12/2025 - V5 - SP - Adding entry condition to not run if the &quot;Intacct Shipper Sync Status&quot; is set to &quot;Synced&quot;.
03/12/2025 - V6 - SP - Updating Flow to run before save to reduce system load.
28/01/2025 - V7 - SP - Updating &quot;formulaSalesTax&quot; to look at the Opportunity &quot;Amount&quot; field instead of the &quot;GST HST Amount&quot;.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaSalesTax</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Amount}*0.20</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>UK VAT Sales Tax Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UK VAT Sales Tax Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates the Sales Tax field on the triggering Opportunity.</description>
        <name>Update_Opportunity_Sales_Tax_Field</name>
        <label>Update Opportunity Sales Tax Field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AVA_SFCLOUD__Sales_Tax__c</field>
            <value>
                <elementReference>formulaSalesTax</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Account_Location_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Entity_Location__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1400--Probo Medical Ltd.</stringValue>
            </value>
        </filters>
        <filters>
            <field>Intacct_Shipper_Sync_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Synced</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
