        <fields>
            <name>SuccessMessage</name>
            <fieldText>&lt;p&gt;The Contact has been updated. The changes are now being synced to the following NetSuite accounts:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;{!var_AccountListText}&lt;/strong&gt;&lt;/p&gt;</fieldText>
