    <description>V12 - Includes the Intercompany Transaction = True and Variables for Asset creation.
V13 - Updating for all varFinalAsset Assignments
V14 - Reducing number of fields for Assignments
V25- Added formulaInternalSalesOpportunityRecordId
V15 - Amending Accounts to be based off &quot;Transfer To&quot; and &quot;Ship To&quot; fields</description>
    <environments>Default</environments>
    <formulas>
        <description>This adds 15% to the Initial/Requested Asset&apos;s Cost.</description>
        <name>formulaAssetSalesPrice</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Asset_Requested__r.Cost__c} * 1.15</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaBusinessUnitSelect</name>
        <dataType>String</dataType>
        <expression>CASE(
    $Record.Asset_Requested__r.Product_Family__c,
    &quot;Part&quot;, &quot;Part Sales&quot;,
    &quot;Ultrasound Probe&quot;, &quot;Ultrasound Probes&quot;,
    &quot;Ultrasound System&quot;, &quot;Ultrasound Systems&quot;,
    &quot;Radiology&quot;
)</expression>
    </formulas>
    <formulas>
        <description>This returns the following:
Modality Contains Ultrasound = Inspected
Else = As-Is</description>
        <name>formulaInspectionType</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!$Record.Asset_Requested__r.Modality__c}, &quot;Ultrasound&quot;),
  &quot;Inspected&quot;,
  &quot;As-Is&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Ths is for the Opportunity Name, &quot; - PURCHASE&quot; and &quot; - SALE&quot; is added in the relative Assignment element.</description>
        <name>formulaInternalOpportunityName</name>
        <dataType>String</dataType>
        <expression>&quot;INTERNAL - &quot; &amp; {!$Record.Asset_Requested__r.Name} &amp; &quot; - &quot; &amp; {!$Record.Asset_Requested__r.Ownership__c} &amp; &quot; TO &quot; &amp; TEXT({!$Record.Transfer_To__c})</expression>
    </formulas>
    <formulas>
        <description>Part = Part Sales Opportunity
Ultrasound System = System Sales Opportunity
Ultrasound Probe = Probe Sales Opportunity
Else Big Iron Sales Opportunity</description>
        <name>formulaInternalSalesOpportunityRecordId</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.Asset_Requested__r.RecordTypeId},
    &quot;0125b000000LWcIAAW&quot;, &quot;0124O000000tE33QAE&quot;,
    &quot;0125b000000LWcLAAW&quot;, &quot;0124O000000tE2tQAE&quot;,
    &quot;0125b000000LWcKAAW&quot;, &quot;0124O000000tE2yQAE&quot;,
    &quot;0124O0000001xpSQAQ&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaOpportunityCurrencies</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.Asset_Requested__r.Ownership__c},
    &quot;PROBO-SAS&quot;, &quot;EUR&quot;,
    &quot;PROBO-UK&quot;,  &quot;GBP&quot;,
    &quot;PROBO-US&quot;,  &quot;USD&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaPurchaseOpportunityAccountID</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.Asset_Requested__r.Ownership__c},
    &quot;PROBO-SAS&quot;, &quot;0010B00001lqFQRQA2&quot;,
    &quot;PROBO-UK&quot;,  &quot;001U000000pNlWPIA0&quot;,
    &quot;PROBO-US&quot;,  &quot;001U000001VNxN6IAL&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaRequestingEntity</name>
        <dataType>String</dataType>
        <expression>IF(
  OR(
    CONTAINS({!$Record.Ship_to_Account__r.Name}, &quot;Tampa&quot;),
    CONTAINS({!$Record.Ship_to_Account__r.Name}, &quot;Indy&quot;)
  ),
  &quot;PROBO-US&quot;,
  IF(
    CONTAINS({!$Record.Ship_to_Account__r.Name}, &quot;UK&quot;),
    &quot;PROBO-UK&quot;,
    IF(
      CONTAINS({!$Record.Ship_to_Account__r.Name}, &quot;SAS&quot;),
      &quot;PROBO-SAS&quot;,
      &quot;&quot;
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>formulaSalesOrHarvest</name>
        <dataType>String</dataType>
        <expression>IF(
OR(
TEXT({!$Record.Procurement_Purpose__c}) = &apos;Sales - Wholesale&apos;,
TEXT({!$Record.Procurement_Purpose__c}) = &apos;Sales - Retail&apos;
),
&apos;Sales&apos;,
&apos; US Harvest&apos;
)</expression>
    </formulas>
    <formulas>
        <description>This returns the following:
If the Requested Asset&apos;s Product has a Product Family of Part or Ultrasound Probe, then DHL - Express
Else Shipping Arranged by Probo Medical</description>
        <name>formulaShipType</name>
        <dataType>String</dataType>
        <expression>IF(
OR(
{!$Record.Asset_Requested__r.Product_Family__c} = &quot;Part&quot;,
{!$Record.Asset_Requested__r.Product_Family__c} = &quot;Ultrasound Probe&quot;
),
&quot;DHL - EXPRESS&quot;,
&quot;Shipping Arranged by Probo Medical&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaTransferToAccountID</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.Transfer_To__c},
    &quot;PROBO-SAS&quot;, &quot;0010B00001lqFQRQA2&quot;,
    &quot;PROBO-UK&quot;,  &quot;001U000000pNlWPIA0&quot;,
    &quot;PROBO-US&quot;,  &quot;001U000001VNxN6IAL&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaTransferToAccountName</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!$Record.Transfer_To__c},
    &quot;PROBO-SAS&quot;, &quot;Probo Medical SAS (IMAX Medical)&quot;,
    &quot;PROBO-UK&quot;,  &quot;Probo Medical LTD (UK)&quot;,
    &quot;PROBO-US&quot;,  &quot;Probo Medical - Indy&quot;,
    &quot;&quot;
)</expression>
    </formulas>
