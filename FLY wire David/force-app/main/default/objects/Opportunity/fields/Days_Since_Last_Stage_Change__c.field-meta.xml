<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Last_Stage_Change__c</fullName>
    <description>Number of days since the Opportunity Stage was last changed.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK( Date_100__c ),
TODAY()-Last_Stage_Change__c,
Date_100__c - Last_Stage_Change__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Number of days since the Opportunity Stage was last changed.</inlineHelpText>
    <label>Days Since Last Stage Change</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
