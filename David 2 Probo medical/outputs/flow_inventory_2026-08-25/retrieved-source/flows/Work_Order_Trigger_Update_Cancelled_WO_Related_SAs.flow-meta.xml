<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_status_of_SAs_in_Collection_Variable</name>
        <label>Set status of SAs in Collection Variable</label>
        <locationX>138</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>Iterate_over_all_Related_SAs.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Iterate_over_all_Related_SAs.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DescriptionFormulaText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SACollectionforupdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_over_all_Related_SAs</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_over_all_Related_SAs</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Determine_if_Records_Exist</name>
        <label>Determine if Records Exist</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_all_related_incomplete_SA_s</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Iterate_over_all_Related_SAs</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>03/03/2025 - Delegate (Kyle) - This flow is triggered when a work order status is set to &quot;Cancelled Work Order&quot;, with the purpose of finding all related service appointments that are not yet complete and cancelling them.
03/11/2025 - Delegate (Kyle) - Error handle Update</description>
    <environments>Default</environments>
    <formulas>
        <name>DescriptionFormulaText</name>
        <dataType>String</dataType>
        <expression>{!Iterate_over_all_Related_SAs.Description}&amp;&quot; - &quot;&amp;&quot;PARENT WORK ORDER CANCELED ON &quot;&amp;TEXT(TODAY())&amp;&quot;.&quot;</expression>
    </formulas>
    <interviewLabel>Work Order - Trigger - Update Cancelled WO Related SAs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Work Order - Trigger - Update Cancelled WO Related SAs</label>
    <loops>
        <name>Iterate_over_all_Related_SAs</name>
        <label>Iterate over all Related SAs</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <collectionReference>Get_all_related_incomplete_SA_s</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_status_of_SAs_in_Collection_Variable</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Applicable_SAs_to_Cancelled</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_all_related_incomplete_SA_s</name>
        <label>Get all related incomplete SA&apos;s</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Determine_if_Records_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Work_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cannot Complete</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ServiceAppointment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Applicable_SAs_to_Cancelled</name>
        <label>Update Applicable SAs to Cancelled</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <inputReference>SACollectionforupdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_all_related_incomplete_SA_s</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </filters>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>SACollectionforupdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ServiceAppointment</objectType>
    </variables>
</Flow>
