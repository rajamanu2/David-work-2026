    <description>8/12/26 - Updating to take the larger of entered sales price and 15% markup on cost.</description>
    <environments>Default</environments>
    <formulas>
        <name>form_CostAndInternationalUplift</name>
        <dataType>Currency</dataType>
        <expression>Max({!$Record.UnitPrice}, ({!formInternationalUnitPricePlusReplairs}*{!var_ExchangeRate})*1.15)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Form_GetDestinationExchangeRate</name>
        <dataType>Number</dataType>
        <expression>((({!formInternationalUnitPricePlusReplairs}*1.15)/
IF(ISNULL({!Get_Dated_Asset_Of_Current_Currency.ConversionRate}),1,{!Get_Dated_Asset_Of_Current_Currency.ConversionRate})
)*
IF(ISNULL({!Get_Opportunity_Destination_Exchange_Rate.ConversionRate}),1,{!Get_Opportunity_Destination_Exchange_Rate.ConversionRate}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formInternationalUnitPricePlusReplairs</name>
        <dataType>Currency</dataType>
        <expression>IF(!ISBLANK({!$Record.ProductItem__r.Cost__c}) &amp;&amp; !ISBLANK({!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c}),
{!$Record.ProductItem__r.Cost__c}+{!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c},
IF(!ISBLANK({!$Record.ProductItem__r.Cost__c}),
{!$Record.ProductItem__r.Cost__c},
IF(!ISBLANK({!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c}),
{!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c},
0
)
)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formUnitPricePlusRepairs</name>
        <dataType>Currency</dataType>
        <expression>IF(!ISBLANK({!$Record.ProductItem__r.Cost__c}) &amp;&amp; !ISBLANK({!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c}),
{!$Record.ProductItem__r.Cost__c}+{!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c},
IF(!ISBLANK({!$Record.ProductItem__r.Cost__c}),
{!$Record.ProductItem__r.Cost__c},
IF(!ISBLANK({!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c}),
{!$Record.ProductItem__r.Total_Cost_of_Assets_Used_in_Repair__c},
0
)
)
)</expression>
        <scale>2</scale>
    </formulas>
