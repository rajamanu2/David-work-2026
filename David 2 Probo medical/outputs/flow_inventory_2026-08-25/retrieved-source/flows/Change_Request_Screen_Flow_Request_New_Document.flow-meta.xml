<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Version Number = (Training Item &quot;Version Number&quot; + 1)
Document Owner = Training Item &quot;Document Owner&quot;</description>
        <name>Set_Revision_Number</name>
        <label>Set Revision Number</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDocumentOwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Training_Item.Document_Owner__r.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varVersionNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaVersonNumberAddOne</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Change_Request</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>Existing</name>
        <choiceText>Existing</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Existing</stringValue>
        </value>
    </choices>
    <choices>
        <name>New</name>
        <choiceText>New</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>New</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Existing_Change_Request_Check</name>
        <label>Existing Change Request Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Training_Item</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Existing_Change_Request_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Change_Requests.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Request_Already_Exists_Screen</targetReference>
            </connector>
            <label>Existing Change Request Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Existing_Document_Approved_Check</name>
        <label>Existing Document Approved Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Change_Request</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Existing_Document_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Training_Item.Document_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Revision_Number</targetReference>
            </connector>
            <label>Existing Document Approved</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_or_Existing_Document_Check</name>
        <label>New or Existing Document Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Change_Request</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Existing_Document</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>New_or_Existing_Picklist</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Existing</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Change_Requests</targetReference>
            </connector>
            <label>Existing Document</label>
        </rules>
    </decisions>
    <description>This is used by various team members to request that a new document is introduced into the QMS.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaVersonNumberAddOne</name>
        <dataType>Number</dataType>
        <expression>{!Get_Training_Item.Version_Number__c} + 1</expression>
        <scale>0</scale>
    </formulas>
