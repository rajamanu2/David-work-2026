<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Vet_Product_to_True</name>
        <label>Set Vet Product to True</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <assignmentItems>
            <assignToReference>VetProduct</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>UpdateProduct</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Product_New_or_Changed</name>
        <label>Is Product New or Changed?</label>
        <locationX>336</locationX>
        <locationY>623</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_New_or_Changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.ProductItem__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.ProductItem__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Product2Id</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Product2Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsVetSystem</targetReference>
            </connector>
            <label>Product New or Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsVetSystem</name>
        <label>IsVetSystem?</label>
        <locationX>182</locationX>
        <locationY>731</locationY>
        <defaultConnector>
            <targetReference>UpdateProduct</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsVet</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ProductItem__r.Check_In_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Vet</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProductItem__r.Product_Name__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Vet</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProductItem__r.Product_Name__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Vetus</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProductItem__r.Product_Name__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Aohua</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Vet_Product_to_True</targetReference>
            </connector>
            <label>IsVet</label>
        </rules>
    </decisions>
    <decisions>
        <name>Quantity_Changed</name>
        <label>Quantity Changed</label>
        <locationX>336</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Is_Product_New_or_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Quantity_Updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Quantity_Remaining</targetReference>
            </connector>
            <label>Quantity Updated</label>
        </rules>
    </decisions>
    <description>update Quantity Remaining on Quantity edits</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>IsNew()</expression>
    </formulas>
    <formulas>
        <name>NEWQuantityRemaining</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Quantity} - {!$Record__Prior.Quantity}) + {!$Record.Quantity_Remaining__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>SystemAsset</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.ProductItem__r.Product_Family__c} = &quot;Ultrasound System&quot;, true, false)</expression>
    </formulas>
    <interviewLabel>Opportunity Product Updates Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Product Updates Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Quantity_Remaining</name>
        <label>Update Quantity Remaining</label>
        <locationX>204</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Is_Product_New_or_Changed</targetReference>
        </connector>
        <inputAssignments>
            <field>Quantity_Remaining__c</field>
            <value>
                <elementReference>NEWQuantityRemaining</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
