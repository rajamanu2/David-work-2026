    <formulas>
        <description>This formula is used as the default &quot;Target Review Date&quot;. It is set as 2 weeks on from the running date.</description>
        <name>formulaTargetReviewDate</name>
        <dataType>Date</dataType>
        <expression>CASE(
  WEEKDAY(TODAY() + 14),
  1, TODAY() + 15,  /* Sunday → Monday */
  7, TODAY() + 16,  /* Saturday → Monday */
  TODAY() + 14
)</expression>
    </formulas>
