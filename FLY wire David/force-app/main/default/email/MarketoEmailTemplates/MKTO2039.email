<td width="100%" valign="top" align="center" class="st-dynamic-624-2" style="padding-top: 40px; padding-bottom: 40px; width: 100%;"><img border="0" valign="top" width="240" src="https://www.cdnrcad8t.com/z5j2bqvxrw/en_us/images/60216eb98b9c1-1612803769.5718.png" alt="Flywire" title="" class="st-mobile-width-constraint" style="border: 0px; display: block; width: 240px; max-width: 100%;" /> </td> 
