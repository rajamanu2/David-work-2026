            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>If_Intended_Start_Date_Time_is_Before_Earliest_Start_Date_Now</name>
        <label>If Intended Start Date/Time is Before Earliest Start Date Now</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>intended_start_date_time_is_blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Intended_Start_Date_Time__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Set_Intended_Start_Date_to_Earliest_Permitted_Start_Date</targetReference>
            </connector>
            <label>intended start date/time is blank</label>
        </rules>
        <rules>
            <name>Yes_Before_Earliest_Start_Date_Now</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Intended_Start_Date_Time__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record.EarliestStartTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Intended_Start_Date_to_Earliest_Permitted_Start_Date</targetReference>
            </connector>
            <label>Yes, Before Earliest Start Date Now</label>
        </rules>
    </decisions>
