    <decisions>
        <name>Vendor_Issue</name>
        <label>Vendor Issue?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Vendor_Issue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Intacct_Receipt_Error_Message__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>specified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Intacct_Receipt_Error_Message__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Intacct_Receipt_Error_Message__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Vendor</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>VendorNeedsActivation</targetReference>
            </connector>
            <label>Yes, Vendor Issue</label>
        </rules>
    </decisions>
    <description>02/16/2026 (BW) - This email goes to Lori to get the vendor activated in Sage Intacct so we can sync over an item receipt</description>
    <environments>Default</environments>
    <interviewLabel>Item Receipt Error: Email to Activate Vendor for Item Receipt {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Item Receipt Error: Email to Activate Vendor for Item Receipt</label>
    <processMetadataValues>
