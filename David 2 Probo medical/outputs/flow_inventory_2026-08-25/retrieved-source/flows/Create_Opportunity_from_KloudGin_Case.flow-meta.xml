    <formulas>
        <name>KGCityFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!InputText}, &quot;PO Box&quot;) || CONTAINS({!InputText}, &quot;P.O. Box&quot;),
    TRIM(MID({!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1) - FIND(&quot;,&quot;, {!InputText}) - 1)),
    TRIM(MID({!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1) - FIND(&quot;,&quot;, {!InputText})))
)</expression>
    </formulas>
    <formulas>
        <name>KGCountryFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!InputText}, &quot;PO Box&quot;) || CONTAINS({!InputText}, &quot;P.O. Box&quot;),
    TRIM(MID({!InputText}, FIND(&quot;-&quot;, {!InputText}) + 2, LEN({!InputText}) - FIND(&quot;-&quot;, {!InputText}) - 1)),
    TRIM(RIGHT({!InputText}, LEN({!InputText}) - FIND(&quot;-&quot;, {!InputText}) - 2))
)</expression>
    </formulas>
    <formulas>
        <name>KGStateFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!InputText}, &quot;PO Box&quot;) || CONTAINS({!InputText}, &quot;P.O. Box&quot;),
    TRIM(MID({!InputText}, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1) + 1, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1) + 1) - FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1) - 1)),
    TRIM(MID({!InputText}, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1) + 1, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1) + 1) - FIND(&quot;,&quot;, {!InputText}, FIND(&quot;,&quot;, {!InputText}) + 1)))
)</expression>
    </formulas>
    <formulas>
        <name>KGStreetFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!InputText}, &quot;PO Box&quot;),
    TRIM(LEFT({!InputText}, FIND(&quot;,&quot;, {!InputText}) - 1)),
    TRIM(MID({!InputText}, 1, FIND(&quot;,&quot;, {!InputText}) - 1))
)</expression>
    </formulas>
    <formulas>
        <name>KGZipFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!InputText}, &quot;PO Box&quot;) || CONTAINS({!InputText}, &quot;P.O. Box&quot;),
    TRIM(MID({!InputText}, FIND(&quot;-&quot;, {!InputText}) - 6, 5)),
    TRIM(MID({!InputText}, FIND(&quot;-&quot;, {!InputText}) - 6, 5))
)</expression>
    </formulas>
