    <description>SALDEV-1153 – New calc for B2B DOM.
SALDEV-1413 - Average_Quoted_Usage_Percent__c, Average_Quoted_Usage_Amt__c added for Stepped Up pricing ARR calculation</description>
    <environments>Default</environments>
    <formulas>
        <name>Cancelled_ARR</name>
        <dataType>Number</dataType>
        <expression>{!Get_Original_Opportunity_Product_Cancellation.Opp_Product_ARR__c} * (-1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DOM_ARR</name>
        <dataType>Number</dataType>
        <expression>IF(
      ISPICKVAL({!$Record.SBQQ__QuoteLine__r.Usage_Type__c}, &apos;Percent&apos;),
      {!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c} *
  (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0) / 100) * {!UtilizationRate} /
  {!ConversionRate},
      {!$Record.SBQQ__QuoteLine__r.Annual_Number_of_Domestic_Transactions__c} *
  BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c}, 0) * {!UtilizationRate} / {!ConversionRate}
  )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DOM_Commision_ARR</name>
        <dataType>Number</dataType>
        <expression>IF(
      ISPICKVAL({!$Record.SBQQ__QuoteLine__r.Usage_Type__c}, &apos;Percent&apos;),
      {!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c} *
  ((BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0) / 100) - {!STDCostRate}) *
  {!UtilizationRate} / {!ConversionRate},
      {!$Record.SBQQ__QuoteLine__r.Annual_Number_of_Domestic_Transactions__c} *
  (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c}, 0) - {!STDCostRate}) * {!UtilizationRate}
  / {!ConversionRate}
  )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DOM_Revenue_Calculated_Text</name>
        <dataType>String</dataType>
        <expression>&quot;Domestic Payments - &quot; +
  IF(
      ISPICKVAL({!$Record.SBQQ__QuoteLine__r.Usage_Type__c}, &apos;Percent&apos;),
      &quot;(&quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c}) + &quot; * &quot; +
  TEXT(BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0) / 100) + &quot; * &quot; +
  TEXT({!UtilizationRate}) + &quot;) / &quot; + TEXT({!ConversionRate}),
      &quot;(&quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Annual_Number_of_Domestic_Transactions__c}) + &quot; * &quot; +
  TEXT(BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c}, 0)) + &quot; * &quot; + TEXT({!UtilizationRate})
   + &quot;) / &quot; + TEXT({!ConversionRate})
  ) +
  &quot; Calculated: &quot; +
  TEXT( NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <name>QuotedUsageRateAmount</name>
        <dataType>Number</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.Adjusted_Rate_Amount__c})), {!$Record.Adjusted_Rate_Amount__c}, 
    IF(
        NOT(ISBLANK({!$Record.Usage_Rate_Amt__c})), {!$Record.Usage_Rate_Amt__c}, 0
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>QuotedUsageRatePercent</name>
        <dataType>Number</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.Adjusted_Rate_Percent__c})), {!$Record.Adjusted_Rate_Percent__c}, 
    IF(
        NOT(ISBLANK({!$Record.Usage_Rate__c})), {!$Record.Usage_Rate__c}, 0
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>STDCostRate</name>
        <dataType>Number</dataType>
        <expression>IF(
      NOT(ISBLANK({!Direct_Match_Cost_Rate.Standard_Cost_Rate__c})),
      {!Direct_Match_Cost_Rate.Standard_Cost_Rate__c},
      IF(
          TEXT({!$Record.SBQQ__QuoteLine__r.Transaction_Currency__c}) = &apos;USD&apos;
          &amp;&amp; ISPICKVAL({!$Record.SBQQ__QuoteLine__r.Usage_Type__c}, &apos;Percent&apos;)
          &amp;&amp; TEXT({!$Record.SBQQ__QuoteLine__r.Payment_Method__c}) &lt;&gt; &apos;Amex&apos;,
          {!Not_Amex_B2B_Domestic_Cost_Rates.Standard_Cost_Rate__c},
          0
      )
  )</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>UtilizationRate</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.SBQQ__QuoteLine__r.Utilization__c},
    &quot;20%&quot;, 0.2,
    &quot;40%&quot;, 0.4,
    &quot;60%&quot;, 0.6,
    &quot;80%&quot;, 0.8,
    &quot;100%&quot;, 1.0,
    1.0
  )</expression>
        <scale>2</scale>
    </formulas>
