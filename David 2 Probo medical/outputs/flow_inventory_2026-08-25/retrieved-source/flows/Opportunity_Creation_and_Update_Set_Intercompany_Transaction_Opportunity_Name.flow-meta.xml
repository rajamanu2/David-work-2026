<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>&quot;INTERNAL &quot; &amp; varEntityName &amp; formulaDirection &amp; varAccountEntityName &amp; &quot; - &quot; &amp; formulaFinalAssetString &amp; &quot; - &quot; &amp; formulaTypeLabel</description>
        <name>Assign_Final_Opportunity_Name</name>
        <label>Assign Final Opportunity Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOpportunityName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaOpportunityName</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_Name</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Names</name>
        <label>Set Names</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEntityName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Entity__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAccountEntityName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaCovertAccountToCountry</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Final_Opportunity_Name</targetReference>
        </connector>
    </assignments>
    <description>15/06/2026 - SP - Excluding the &quot;External Repair / Testing&quot; Opportunity ID (012U00000001sNsIAI) and and Opportunities with the &quot;Purchasing Opportunity Type&quot; as &quot;Sourcing&quot; in the entry criteria.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaAssetStringClean</name>
        <dataType>String</dataType>
        <expression>LEFT({!varAssetString}, LEN({!varAssetString}) - 2)</expression>
    </formulas>
    <formulas>
        <name>formulaCovertAccountToCountry</name>
        <dataType>String</dataType>
        <expression>CASE(
    $Record.Account.Name,
    &quot;Probo Medical LTD (UK)&quot;, &quot;UK&quot;,
    &quot;Probo Medical - Indy&quot;, &quot;US&quot;,
    &quot;Probo Medical - Tulsa&quot;, &quot;US&quot;,
    &quot;Probo Medical - Tampa&quot;, &quot;US&quot;,
    &quot;Probo Medical SAS (IMAX Medical)&quot;, &quot;FR&quot;,
    &quot;UNKNOWN&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaDirection</name>
        <dataType>String</dataType>
        <expression>IF({!formulaIsPurchase}, &quot; from &quot;, &quot; to &quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaEntityFinal</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!formulaSubstitutedEntity},
    
    &quot;SAS&quot;, &quot;FR&quot;,
    
    {!formulaSubstitutedEntity}
)</expression>
    </formulas>
    <formulas>
        <name>formulaFinalAssetString</name>
        <dataType>String</dataType>
        <expression>IF(
    formulaIsPurchase,
    IF(
        NOT(ISBLANK($Record.Related_Opportunity__c)),
IF(
LEN(TRIM({!$Record.Related_Opportunity__r.Asset_Summary__c})) &gt; 0,
{!$Record.Related_Opportunity__r.Asset_Summary__c},
{!$Record.Related_Opportunity__r.Opportunity_Number__c}
),
&quot;Ref: &quot; &amp; {!$Record.Related_Opportunity__r.Opportunity_Number__c} &amp; &quot; (No Related Opp Found)&quot;
),
{!$Record.Asset_Summary__c}
)</expression>
    </formulas>
    <formulas>
        <name>formulaIsPurchase</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS($Record.RecordType.Name, &quot;Purchasing&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaOpportunityName</name>
        <dataType>String</dataType>
        <expression>&quot;INTERNAL &quot; &amp;
&quot; - &quot; &amp;
{!formulaEntityFinal} &amp;
{!formulaDirection} &amp;
{!varAccountEntityName} &amp;
&quot; - &quot; &amp;
LEFT(
    {!formulaFinalAssetString},
    MAX(
        0,
        120 -
        LEN(
            &quot;INTERNAL &quot; &amp;
            &quot; - &quot; &amp;
            {!formulaEntityFinal} &amp;
            {!formulaDirection} &amp;
            {!varAccountEntityName} &amp;
            &quot; - &quot; &amp;
            &quot; - &quot; &amp;
            {!formulaTypeLabel}
        )
    )
) &amp;
&quot; - &quot; &amp;
{!formulaTypeLabel}</expression>
    </formulas>
    <formulas>
        <name>formulaSubstitutedEntity</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!varEntityName}, &quot;Probo-&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaTypeLabel</name>
        <dataType>String</dataType>
        <expression>IF({!formulaIsPurchase}, &quot; PURCHASE &quot;, &quot; SALE &quot;)</expression>
    </formulas>
    <interviewLabel>Opportunity - Creation and Update - Set Intercompany Transaction Opportunity Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Creation and Update - Set Intercompany Transaction Opportunity Name</label>
