<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Change_Request_Status_Check</name>
        <label>Change Request Status Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Changed_to_Published</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Change_Request_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Published</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Document</targetReference>
            </connector>
            <label>Status Changed to Published</label>
        </rules>
    </decisions>
    <description>22/04/2026 - SP - This Flow has been designed to update a Change Request&apos;s Related Document after the record has been marked as published.</description>
    <environments>Default</environments>
    <interviewLabel>Change Request - Automations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Change Request - After Update - Lifecycle Automations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Related_Document</name>
        <label>Update Related Document</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Approved_By__c</field>
            <value>
                <elementReference>$Record.Approved_By__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Reviewed_By__c</field>
            <value>
                <elementReference>$Record.Document_Owner__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Reviewed_Date__c</field>
            <value>
                <elementReference>$Record.CC_Approval_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Published_Date__c</field>
            <value>
                <elementReference>$Record.Published_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Related_Document__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Change_Request_Status_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Change_Request_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Change_Request__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
