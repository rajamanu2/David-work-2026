<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When a new Prod Config record is set to Status Active (Product Live), update Prod Config Set Live, the Opportunity &quot;Date First Opp Product Live&apos; and The Account Status and Account Status Date.</description>
    <environments>Default</environments>
    <interviewLabel>(PROD CONFIG) New Set to Live {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(PROD CONFIG) New Set to Live</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Account_Status</name>
        <label>Account Status</label>
        <locationX>176</locationX>
        <locationY>455</locationY>
        <connector>
            <targetReference>Opp_1st_Live_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Account_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Active (Product Live)</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Acc_Bypass_DateTime__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_Status_Date__c</field>
            <value>
                <elementReference>$Record.Product_Status_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_Status__c</field>
            <value>
                <stringValue>Active (Product Live)</stringValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>Opp_1st_Live_Date</name>
        <label>Opp 1st Live Date</label>
        <locationX>176</locationX>
        <locationY>575</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date_First_Opp_Product_Live__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Date_First_Opp_Product_Live__c</field>
            <value>
                <elementReference>$Record.Product_Status_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opp_Bypass_DateTime__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Config_Set_Live</name>
        <label>Update Config Set Live Date</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <connector>
            <targetReference>Account_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Prod_Config_Set_Live__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Prod_Config_Set_Live__c</field>
            <value>
                <elementReference>$Record.Product_Status_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Config_Set_Live</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Product_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active (Product Live)</stringValue>
            </value>
        </filters>
        <object>Product_Configuration__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
