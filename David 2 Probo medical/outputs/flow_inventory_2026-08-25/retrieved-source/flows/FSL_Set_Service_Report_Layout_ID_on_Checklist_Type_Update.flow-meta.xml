        <label>Service Report Template Supported?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Service_Report_Template_is_Supported</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Checklist_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>C-Arm</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Checklist_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cardio Labs</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Checklist_Type__c</leftValueReference>
