<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>If the Ass</description>
        <name>Build_varAssetString</name>
        <label>Build varAssetString</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAssetString</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!Loop_Through_Opportunity_Products.ProductItem__r.Name}, </stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Opportunity_Products</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Clean_varAssetString</name>
        <label>Clean varAssetString</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAssetString</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaAssetStringClean</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Related_Opportunity_Asset_Summary</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>If the Opportunity Product is matches the triggering record (the deleted item), then don&apos;t do anything. If the Opportunity Product is not the deleted item, then add the &quot;Asset No&quot; field to varAssetString.</description>
        <name>Check_Asset_Id</name>
        <label>Check Asset Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Build_varAssetString</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Exclude_Triggering_Asset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Opportunity_Products.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Opportunity_Products</targetReference>
            </connector>
            <label>Exclude Triggering Asset</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formulaAssetStringClean</name>
        <dataType>String</dataType>
        <expression>IF(
    LEN({!varAssetString}) &gt; 0,
    LEFT({!varAssetString}, LEN({!varAssetString}) - 2),
    &quot;&quot;
)</expression>
    </formulas>
    <interviewLabel>Opportunity Line Item - On Delete - Set Opportunity Asset Summary {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Line Item - On Delete - Set Opportunity Asset Summary</label>
    <loops>
        <description>Look through each of the retrieved Opportunity Products to buld a list of Asset numbers.</description>
        <name>Loop_Through_Opportunity_Products</name>
        <label>Loop Through Opportunity Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Opportunity_Products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Asset_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Clean_varAssetString</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all Opportunity Products from the Opportunity realted to the triggering Opportunity Product.</description>
        <name>Get_Opportunity_Products</name>
        <label>Get Opportunity Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Opportunity_Products</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Related_Opportunity_Asset_Summary</name>
        <label>Update Related Opportunity Asset Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Asset_Summary__c</field>
            <value>
                <elementReference>varAssetString</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Opportunity</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity_Products</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity_Record_Type__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Sales</stringValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>colvarOpportunityProduct</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityLineItem</objectType>
    </variables>
    <variables>
        <name>varAssetString</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
