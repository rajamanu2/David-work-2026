    <decisions>
        <name>Is_there_a_shipToAddress</name>
        <label>Is there a shipToAddress</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Ship_Directly_to_custom_address</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_there_ShipToAddress_on_Work_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Shipping_Address__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Shipping_Address__r.AddressType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FedEx</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Hold_Shipping_Address_Location</targetReference>
            </connector>
            <label>Is there ShipToAddress on Work Order?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_Opportunity_Found</name>
        <label>Was Opportunity Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UK_Opp</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Country</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <label>UK Opp</label>
        </rules>
        <rules>
            <name>Ship_Date_Populated</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity.Intacct_Shipper_Sync_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Synced</stringValue>
                </rightValue>
            </conditions>
            <label>Opportunity is synced</label>
        </rules>
        <rules>
            <name>Opportunity_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Billing_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Contract</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Billing_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Warranty</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_there_a_shipToAddress</targetReference>
            </connector>
            <label>Opportunity Found</label>
        </rules>
    </decisions>
