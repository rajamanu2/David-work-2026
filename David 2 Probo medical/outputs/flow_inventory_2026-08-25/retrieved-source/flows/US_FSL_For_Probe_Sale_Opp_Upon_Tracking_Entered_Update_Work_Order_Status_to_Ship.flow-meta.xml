    <decisions>
        <name>Is_Status_Repair_Declined</name>
        <label>Is Status Repair Declined?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Related_Work_Order_Status_to_Shipped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_is_Repair_Declined</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Related_Work_Order__r.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Repair Declined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Repair Declined</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Work_Order_Status_to_Closed</targetReference>
            </connector>
            <label>Status is Repair Declined</label>
        </rules>
    </decisions>
