<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_Account_has_Fedex_Account_Set_to_Use_Fedex_Account_for_Shipping</name>
        <label>Check if Account has Fedex Account &amp; Set to Use Fedex Account for Shipping</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Fedex_Account_Use_Fedex_Account_for_Shipping</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Repair_Opportunity__r.Account.Default_Shipping_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer&apos;s Fedex</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Repair_Opportunity__r.Account.Customer_Fedex_Account_Number__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opportunity_Shipping_to_Fedex</targetReference>
            </connector>
            <label>Has Fedex Account &amp; Use Fedex Account for Shipping</label>
        </rules>
    </decisions>
    <description>04/22/2026 (BW) - This sets the Shipping Account to Bill from the account</description>
