<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Updates the lead person type to Opt In Partner IF Lead Sub Industry is Beneficiary Agency. SAL-3302</description>
    <environments>Default</environments>
    <interviewLabel>(LEAD) Update Person Type to Opt In Partner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(LEAD) Update Person Type to Opt In Partner</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Lead_Type</name>
        <label>Update Lead Type</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Lead_Bypass_DateTime__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Person_Type__c</field>
            <value>
                <stringValue>Opt In Partner</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Lead_Type</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Lead_Sub_Industry__c}, &apos;Beneficiary Agency&apos;)
&amp;&amp;
ISCHANGED({!$Record.Lead_Sub_Industry__c})
||
ISNEW() 
&amp;&amp;
ISPICKVAL({!$Record.Lead_Sub_Industry__c}, &apos;Beneficiary Agency&apos;)
&amp;&amp;
NOT(ISPICKVAL({!$Record.Person_Type__c}, &apos;Opt In Partner&apos;))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
