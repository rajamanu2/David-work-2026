        <name>GetCurrency</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$User.Location__c}, &apos;Gloucester, UK&apos;), &apos;GBP&apos;,
IF(ISPICKVAL({!$User.Location__c}, &apos;Bristol, UK&apos;), &apos;GBP&apos;,
IF(ISPICKVAL({!$User.Location__c}, &apos;Nottingham, UK&apos;), &apos;GBP&apos;,
IF(ISPICKVAL({!$User.Location__c}, &apos;Dusseldorf, Germany&apos;), &apos;EUR&apos;,
IF(ISPICKVAL({!$User.Location__c}, &apos;Nantes, FR&apos;), &apos;EUR&apos;,
&apos;USD&apos;) ) ) ) )</expression>
    </formulas>
    <formulas>
        <name>updatedRecordTypeName</name>
        <dataType>String</dataType>
        <expression>IF({!GetProductName.RecordType.DeveloperName} = &apos;Ultrasound_TEE_Probe&apos;, &apos;Ultrasound_Probe&apos;, IF(OR({!GetProductName.RecordType.DeveloperName}  = &apos;Non_Inventory_Item&apos;, {!GetProductName.RecordType.DeveloperName}  = &apos;Big_Iron_Equipment&apos;), &apos;Normal&apos;, IF({!GetProductName.RecordType.DeveloperName}  = &apos;MR&apos;, &apos;MRI&apos;, {!GetProductName.RecordType.DeveloperName} )))</expression>
    </formulas>
