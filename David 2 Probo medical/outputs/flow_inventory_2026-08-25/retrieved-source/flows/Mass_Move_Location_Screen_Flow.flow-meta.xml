    <decisions>
        <description>If this is a UK or French Move Location then the Asset collection is based off the Asset Ownership field, not the Location</description>
        <name>Location_Decision</name>
        <label>Location Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Assets_From_Location</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UK_or_French_Asset</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Move_Location.ProductItem__r.Ownership__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PROBO-UK</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Move_Location.ProductItem__r.Ownership__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PROBO-SAS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Assets_From_Ownership</targetReference>
            </connector>
            <label>UK or French Asset</label>
        </rules>
    </decisions>
