<tr> 
<td align="center" valign="top">
<table width="100%" border="0" cellspacing="0" cellpadding="0" align="center" class="mktoContainer" id="Template">
<tr class="mktoModule" id="Banner_Img_Module"> 
<td align="center" valign="top"> 
<table width="640" border="0" cellspacing="0" cellpadding="0" align="center" style="width:640px;" class="em_wrapper"> 
<tbody> 
<tr> 
<td align="center" valign="top" class="em_full_img"> 
<div id="image_02" class="mktoImg" mktolockimgsize="true">
<a href="https://www.flywire.com/industries/travel?utm_source=marketo&amp;utm_medium=email" target="_blank" style="text-decoration:none;"><img src="https://more.flywire.com/rs/372-QSQ-649/images/image-2020-10-01-15-28-44-081.png" width="640" height="200" style="" border="0" /></a>
</div></td> 
