        <name>Loop_Work_Order_Line_Items_for_Assets</name>
        <label>Loop Work Order Line Items for Assets</label>
        <locationX>666</locationX>
        <locationY>566</locationY>
        <assignNextValueToReference>recvarWorkOrderLineItem</assignNextValueToReference>
        <collectionReference>colvarWorkOrderLineItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Asset_Display_List</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Display_Assets_Screen</targetReference>
        </noMoreValuesConnector>
