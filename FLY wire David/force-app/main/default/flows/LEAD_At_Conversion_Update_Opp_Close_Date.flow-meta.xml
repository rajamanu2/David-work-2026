    <description>At lead conversion, changes the related opportunity closed date to specified timeframe based on vertical. Flow is only triggered if opp is created at conversion. Excludes Marketo user.</description>
    <environments>Default</environments>
    <formulas>
        <description>For B2B vertical</description>
        <name>TodayPlus110</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 110</expression>
    </formulas>
    <formulas>
        <description>For EDU Vertical</description>
        <name>TodayPlus195</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 195</expression>
    </formulas>
    <formulas>
        <description>For HC Vertical</description>
        <name>TodayPlus243</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 243</expression>
    </formulas>
    <formulas>
        <description>For Travel vertical</description>
        <name>TodayPlus71</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 71</expression>
    </formulas>
    <formulas>
        <name>TodayPlus90</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 90</expression>
    </formulas>
    <interviewLabel>(LEAD) At Conversion Update Opp Close Date {!$Flow.CurrentDateTime}</interviewLabel>
