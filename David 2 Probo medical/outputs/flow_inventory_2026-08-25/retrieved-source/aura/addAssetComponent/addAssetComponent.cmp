<aura:component implements="force:hasRecordId,flexipage:availableForAllPageTypes">
    <aura:attribute name="objectRecordId" type="String" access="public"/>
    <aura:attribute name="action" type="String" access="public"/>
    <aura:attribute name="objectName" type="String" access="public"/>
    <aura:handler name="init" value="{!this}" action="{!c.initialize}"/>
    <c:addAssetMainLwc objectRecordId="{!v.objectRecordId}" action="{!v.action}" objectName="{!v.objectName}"/>
</aura:component>