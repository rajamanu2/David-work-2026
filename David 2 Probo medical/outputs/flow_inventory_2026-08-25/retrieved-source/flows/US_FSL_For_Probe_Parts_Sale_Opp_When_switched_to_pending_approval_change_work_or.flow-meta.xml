<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_the_related_work_order_a_US_work_order</name>
        <label>Is the related work order a US work order?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_US_Work_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Related_Work_Order__r.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Work_Order_Status_to_Pending_Approval</targetReference>
            </connector>
            <label>Yes, US Work Order</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_there_a_related_work_order</name>
        <label>Is there a related work order?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_there_is_a_related_work_order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Related_Work_Order__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_the_related_work_order_a_US_work_order</targetReference>
            </connector>
            <label>Yes, there is a related work order</label>
        </rules>
    </decisions>
    <description>05/21/2026 (BW) - On the opportunity going to pending approval, update the work order&apos;s status to &quot;Quote Attached&quot;</description>
    <environments>Default</environments>
    <interviewLabel>US FSL | For Probe/Parts Sale Opp, When switched to pending approval change work order to pending approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>US FSL | For Probe/Parts Sale Opp, When switched to pending approval change work order to Quote Attached</label>
