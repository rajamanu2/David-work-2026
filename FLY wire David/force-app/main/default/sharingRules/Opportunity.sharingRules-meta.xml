        <label>Integration Edit</label>
        <sharedTo>
            <role>Admin</role>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>IsClosed</field>
            <operation>equals</operation>
