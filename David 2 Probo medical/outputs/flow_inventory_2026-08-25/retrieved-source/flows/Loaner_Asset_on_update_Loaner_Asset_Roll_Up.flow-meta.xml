    <description>06/04/26 (GD) – DLRS-replacement: Loaner_Assets_Roll_Up (on update). Sync path for $Record__Prior (old parent on reparent). Loop over Transform: no ConcatenateDistinct, formula field (ProductItem__r.Name), no delimiter/truncation control.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Asset_In_String_Current</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Asset} &amp; &quot;,&quot;, &quot;,&quot; &amp; {!Loop_Current_Parent.Loaner_Asset__c} &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Is_Asset_In_String_New</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Asset} &amp; &quot;,&quot;, &quot;,&quot; &amp; {!Loop_New_Parent.Loaner_Asset__c} &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Is_Asset_In_String_Old</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Asset} &amp; &quot;,&quot;, &quot;,&quot; &amp; {!Loop_Old_Parent.Loaner_Asset__c} &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Loaner_Changed_Formula</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!$Record.Loaner__c} = {!$Record__Prior.Loaner__c})</expression>
    </formulas>
    <formulas>
        <name>Trimmed_Asset</name>
        <dataType>String</dataType>
        <expression>LEFT(IF(RIGHT({!Concatenated_Asset}, 1) = &quot;,&quot;, LEFT({!Concatenated_Asset}, LEN({!Concatenated_Asset}) - 1), {!Concatenated_Asset}), 255)</expression>
    </formulas>
