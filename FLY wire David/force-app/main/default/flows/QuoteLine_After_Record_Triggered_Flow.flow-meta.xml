    <decisions>
        <name>Check_Different_Ship_To_Exists</name>
        <label>Check Different Ship-To Exists</label>
        <locationX>567</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Get_Quote_Line_With_Different_Ship_To</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No – Ship-To Same (Default Path)</defaultConnectorLabel>
        <rules>
            <name>Yes_Different_Ship_To_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Ship_To_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Ship_To_Account__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SBQQ__Quote__r.SBQQ__Account__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Invalid_ShipTo</targetReference>
            </connector>
            <label>Yes – Different Ship-To Found</label>
        </rules>
    </decisions>
