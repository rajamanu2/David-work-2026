<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Calls subflow to look through opps related to find the first prod config for the opp that was set to active status.</description>
    <environments>Default</environments>
    <interviewLabel>(PROD CONFIG) Update First Opp Prod Config Checkbox {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(PROD CONFIG) Update First Opp Prod Config Checkbox</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Call_SubFlow_Set_First_Opp_Prod_Config</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Activated_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Flow_Trigger__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Product_Configuration__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_SubFlow_Set_First_Opp_Prod_Config</name>
        <label>Call  SubFlow Set First Opp Prod Config</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <flowName>PROD_CONFIG_SubFlow_Set_First_Opp_Prod_Config</flowName>
        <inputAssignments>
            <name>OppId</name>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
