<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Requires_a_Reason_For_Closed_Won_Opp</fullName>
    <active>false</active>
    <description>Requires a reason for Closed / Won Opportunities</description>
    <errorConditionFormula>AND(
ISPICKVAL (StageName, &quot;Closed Won&quot;),
ISBLANK (TEXT(Reason_Won__c))
)</errorConditionFormula>
    <errorDisplayField>Reason_Won__c</errorDisplayField>
    <errorMessage>A win reason is required.</errorMessage>
</ValidationRule>
