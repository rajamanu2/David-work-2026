    <formulas>
        <name>AnnualIncreaseDate</name>
        <dataType>Date</dataType>
        <expression>IF(
  AND(
    MONTH( {!$Record.Next_Charge_Date__c} ) = 2,
    DAY( {!$Record.Next_Charge_Date__c} ) = 29,
    NOT( 
      OR( 
        MOD( YEAR( {!$Record.Next_Charge_Date__c} ), 400 ) = 0, 
        AND( 
          MOD( YEAR( {!$Record.Next_Charge_Date__c} ), 4 ) = 0,
          MOD( YEAR( {!$Record.Next_Charge_Date__c} ), 100 ) != 0
        )
      )
    ) 
  ),
  DATE( YEAR( {!$Record.Next_Charge_Date__c} ) + 1, 3, 1),
  DATE( YEAR( {!$Record.Next_Charge_Date__c} ) + 1, MONTH( {!$Record.Next_Charge_Date__c} ), DAY( {!$Record.Next_Charge_Date__c} ) )
)</expression>
    </formulas>
    <formulas>
        <name>BiennialIncreaseDate</name>
        <dataType>Date</dataType>
        <expression>IF(
  AND(
    MONTH( {!$Record.Next_Charge_Date__c} ) = 2,
    DAY( {!$Record.Next_Charge_Date__c} ) = 29,
    NOT( 
      OR( 
        MOD( YEAR( {!$Record.Next_Charge_Date__c} ), 400 ) = 0, 
        AND( 
          MOD( YEAR( {!$Record.Next_Charge_Date__c} ), 4 ) = 0,
          MOD( YEAR( {!$Record.Next_Charge_Date__c} ), 100 ) != 0
        )
      )
    ) 
  ),
  DATE( YEAR( {!$Record.Next_Charge_Date__c} ) + 2, 3, 1),
  DATE( YEAR( {!$Record.Next_Charge_Date__c} ) + 2, MONTH( {!$Record.Next_Charge_Date__c} ), DAY( {!$Record.Next_Charge_Date__c} ) )
)</expression>
    </formulas>
    <formulas>
        <name>BimonthlyIncreaseDate</name>
        <dataType>Date</dataType>
        <expression>DATE(
  YEAR( {!$Record.Next_Charge_Date__c} ) + FLOOR( ( MONTH ( {!$Record.Next_Charge_Date__c} ) + 2 - 1 ) / 12 ),
  MOD( MONTH ( {!$Record.Next_Charge_Date__c} ) + 2 - 1 + 
    IF( DAY ( {!$Record.Next_Charge_Date__c} ) &gt; CASE( MOD( MONTH( {!$Record.Next_Charge_Date__c} ) + 2 - 1, 12 ) + 1, 
      2, 28,
      4, 30,
      6, 30,
      9, 30, 
      11, 30,
      31 ), 1, 0 ), 12 ) + 1,
    IF( DAY( {!$Record.Next_Charge_Date__c} ) &gt; CASE( MOD( MONTH( {!$Record.Next_Charge_Date__c} ) + 2 - 1, 12 ) + 1,
      2, 28, 
      4, 30, 
      6, 30, 
      9, 30, 
      11, 30, 
      31 ), 
    1, DAY( {!$Record.Next_Charge_Date__c} )
  )
)</expression>
    </formulas>
