    <description>06/04/26 (GD) – Replaces DLRS rollup &apos;Roll Up Delivered Date on Loaner&apos; (on update). Handles delivery-date change on the same Loaner and Loaner reparenting (updates both old and new parent). Known gap matching org-wide pattern: if Loaner__c is changed to null the old parent is not updated (entry criteria require current Loaner__c to be non-null). Distinct check uses anchored CONTAINS() pattern (&quot;,value,&quot;) to prevent substring false-positives. $Record__Prior is used for old-parent lookup — only available in synchronous paths.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Date_In_String_Current</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Date} &amp; &quot;,&quot;, &quot;,&quot; &amp; TEXT({!Loop_Current_Parent.zkmulti__Actual_Delivery_Date__c}) &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Is_Date_In_String_New</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Date} &amp; &quot;,&quot;, &quot;,&quot; &amp; TEXT({!Loop_New_Parent.zkmulti__Actual_Delivery_Date__c}) &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Is_Date_In_String_Old</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Date} &amp; &quot;,&quot;, &quot;,&quot; &amp; TEXT({!Loop_Old_Parent.zkmulti__Actual_Delivery_Date__c}) &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Loaner_Changed_Formula</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!$Record.Loaner__c} = {!$Record__Prior.Loaner__c})</expression>
    </formulas>
    <formulas>
        <name>Trimmed_Date</name>
        <dataType>String</dataType>
        <expression>LEFT(IF(RIGHT({!Concatenated_Date}, 1) = &quot;,&quot;, LEFT({!Concatenated_Date}, LEN({!Concatenated_Date}) - 1), {!Concatenated_Date}), 255)</expression>
    </formulas>
