    <description>17/08/2026 - V11 - SP - Querying the created Work Orders to help the &quot;formulaLengthBasedonModality&quot; calculate a value.</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula looks at the Work Order Modality and the following:
Ultrasound = 2
Else = 4</description>
        <name>formulaLengthBasedonModality</name>
        <dataType>Number</dataType>
        <expression>IF(
  {!Loop_Through_Created_Work_Orders.Modality__c} = &quot;Ultrasound&quot;,
  2,
  4
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaTodayPlus30Days</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (30)</expression>
    </formulas>
    <formulas>
        <name>LengthInYears</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.Contract_Length_Months__c} / 12, 0)</expression>
        <scale>0</scale>
    </formulas>
