    <decisions>
        <description>If the &quot;Assigned To&quot; field is populated while previously being a blank value and isn&apos;t &quot;Closed&quot; then set the &quot;Status&quot; to &quot;Claimed&quot;.</description>
        <name>Assigned_To_Just_Populated</name>
        <label>Assigned To Just Populated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Claimed_From_New</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Just_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Assigned_To__r.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Assigned_To__r.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_to_Claimed</targetReference>
            </connector>
            <label>Just Populated</label>
        </rules>
    </decisions>
    <decisions>
        <description>If the &quot;Status&quot; is moved from &quot;New&quot; to &quot;Claimed&quot; and the &quot;Assigned To&quot; field is blank then enter the running user.</description>
        <name>Claimed_From_New</name>
        <label>Claimed From New</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Changes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Claimed_From_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claimed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Assigned_To__r.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Assigned_to_Claimer</targetReference>
            </connector>
            <label>Case Claimed From New</label>
        </rules>
    </decisions>
    <decisions>
        <description>If the Case is set to &quot;Closed&quot; without a user saved in the &quot;Assigned To&quot; field then enter the running user.</description>
