    <decisions>
        <description>The Opportunity Line Type determines if the ARR should be calculated for the products on this Opportunity.
&apos;New&apos; and &apos;Amendment&apos; should always generate ARR but &apos;Renewals&apos; should only generate ARR if the product is an annual fee (Not Implementation fees) else the ARR should be 0</description>
        <name>Opp_meets_criteria</name>
        <label>Opp meets criteria?</label>
        <locationX>1106</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Exit Flow</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Travel</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Ship_To_Account__r.ShippingCountry</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Quote_Line_Type</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
