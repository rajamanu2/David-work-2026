    <description>18/06/2026 - SP - Updating the Flow so that it only updates the &quot;Location of Equipment&quot; and address fields if they&apos;re blank.</description>
    <environments>Default</environments>
    <formulas>
        <name>formCountryCode</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Work_Order__r.Shipping_Country__c} = &quot;United States&quot;, &quot;US&quot;, {!$Record.Work_Order__r.Shipping_Country__c})</expression>
    </formulas>
    <formulas>
        <name>formReporterContactInfo</name>
        <dataType>String</dataType>
        <expression>LEFT(SUBSTITUTE(SUBSTITUTE({!ReporterContactInfo}, &quot;&lt;p&gt;&quot;, &quot;&quot;), &quot;&lt;/p&gt;&quot;, &quot;&quot;), 255)</expression>
    </formulas>
    <formulas>
        <name>formStateCode</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_State_Translation.State_Abbreviation__c}), {!$Record.Work_Order__r.Shipping_State__c}, {!Get_State_Translation.State_Abbreviation__c})</expression>
    </formulas>
