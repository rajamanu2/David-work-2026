    <decisions>
        <description>Route 4 or more Yes responses to Approved (Bid) and less to No Bid.</description>
        <name>Bid_No_Bid</name>
        <label>Bid/No Bid</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>ErrorScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Bid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sumQs</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>6.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Bid_Record</targetReference>
            </connector>
            <label>Yes Bid</label>
        </rules>
        <rules>
            <name>No_Bid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sumQs</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Bid_Record_0</targetReference>
            </connector>
            <label>No Bid</label>
        </rules>
    </decisions>
