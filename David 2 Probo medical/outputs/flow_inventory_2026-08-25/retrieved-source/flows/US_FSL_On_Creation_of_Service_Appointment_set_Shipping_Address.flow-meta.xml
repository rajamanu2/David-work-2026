<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_2_digit_to_state</name>
        <label>Assign 2 digit to state</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varState</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_State_2_digit.State_Abbreviation__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Shipping_Address_on_Service_Appointment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_State_to_varState</name>
        <label>Assign State to varState</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varState</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Parent_WO.Shipping_State__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Shipping_Address_on_Service_Appointment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Work_Order_Parent_a_US_Work_Order</name>
        <label>Is Work Order Parent a US Work Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_US_Work_Order</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_WO.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_WO.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>X2_Digit_Abbreviation</targetReference>
            </connector>
            <label>Yes, US Work Order</label>
        </rules>
    </decisions>
    <decisions>
        <name>X2_Digit_Abbreviation</name>
        <label>2 Digit Abbreviation?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_State_2_digit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_2_Digit_Abbreviation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formStateLength</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_State_to_varState</targetReference>
            </connector>
            <label>Yes 2 Digit Abbreviation</label>
        </rules>
    </decisions>
    <description>06/09/2026 (MPB) - Added Service Site Name to copy from work order
06/01/2026 (MB) - Added Attn line to copy over from work order</description>
    <environments>Default</environments>
    <formulas>
        <name>formShippingCountry</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Parent_WO.Shipping_Country__c}=&quot;United States&quot;,&quot;US&quot;,{!Get_Parent_WO.Shipping_Country__c})</expression>
    </formulas>
    <formulas>
        <name>formStateLength</name>
        <dataType>Boolean</dataType>
        <expression>Len({!Get_Parent_WO.Shipping_State__c})==2</expression>
    </formulas>
    <interviewLabel>US FSL | On Creation of Service Appointment set Shipping Address {!$Flow.CurrentDateTime}</interviewLabel>
    <label>US FSL | On Creation of Service Appointment set Shipping Address</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Parent_WO</name>
        <label>Get Parent WO</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Work_Order_Parent_a_US_Work_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentRecordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_State_2_digit</name>
        <label>Get State 2 digit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_2_digit_to_state</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>State_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Parent_WO.Shipping_State__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>StateTranslation__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
