    <description>Products in this calculation:
Cross Border Payments - FWCCY1000

Use Quote_Line_Type__c instead of Opportunity.Type 07/26/2024. Different formula for UK when usage is Amt 08/08/2024. Updated 09/04/2024 include surcharge in calculations and use # of transactions when usage is amount. BOPI-511 Updated to calculate ARR when Quote Line Type not &apos;Cancellation&apos; or &apos;Renewal&apos;. BOPI-603 updated to set ARR to 0 for cancelled lines. BOPI-620 updated to set the ARR for cancelled lines to the original amount as a negative value. BOPI-650 Updated to account for Canada card cost

BOPI-798 Update this flow to calculate the ARR for all the regions

SALDEV-1151 – Updated with new logic, calc, and metadata – OPP_ARR_EDU_Domestic_Cost_Rate__mdt

SALDEV-1413: Average_Quoted_Usage_Percent__c, Average_Quoted_Usage_Amt__c fields added in formulas in flows for stepped up pricing ARR calculation.</description>
    <environments>Default</environments>
    <formulas>
        <name>Cancelled_ARR</name>
        <dataType>Number</dataType>
        <expression>{!Get_Original_Opportunity_Product_Cancellation.Opp_Product_ARR__c} * (-1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DOM_ARR</name>
        <dataType>Number</dataType>
        <expression>IF(
    ISPICKVAL({!$Record.SBQQ__QuoteLine__r.Usage_Type__c},&apos;Percent&apos;),
    (
        (
            (
                {!$Record.SBQQ__QuoteLine__r.Annual_Total_CC_Volume__c} - 
                BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_Total_Surcharge_Volume__c}, 0)
            ) * (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0) / 100)
              * {!UtilizationRate}
        ) + (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_Total_Surcharge_Volume__c},0) * 0.03)
    ) / {!ConversionRate},
    (
        (
            (
                {!$Record.SBQQ__QuoteLine__r.Annual_Number_of_Domestic_Transactions__c} - BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_No_Surcharge_Transactions__c}, 0)
            ) * (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c},0) / {!ConversionRate})
              * {!UtilizationRate}
        ) + (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_No_Surcharge_Transactions__c}, 0) * 0.03)
    )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DOM_Commision_ARR</name>
        <dataType>Number</dataType>
        <expression>IF(
      ISPICKVAL({!$Record.SBQQ__QuoteLine__r.Usage_Type__c},&apos;Percent&apos;),
      (
          (
              (
                  {!$Record.SBQQ__QuoteLine__r.Annual_Total_CC_Volume__c} -
                  BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_Total_Surcharge_Volume__c}, 0)
              ) * ((BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0) / 100) - {!STDCostRate})
                * {!UtilizationRate}
          ) + (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_Total_Surcharge_Volume__c},0) * 0.03)
      ) / {!ConversionRate},
      (
          (
              (
                  {!$Record.SBQQ__QuoteLine__r.Annual_Number_of_Domestic_Transactions__c} - BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_No_Surcharge_Transactions__c}, 0)
              ) * (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c},0) / {!ConversionRate})
                * {!UtilizationRate}
          ) + (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Annual_No_Surcharge_Transactions__c}, 0) * 0.03)
      )
  )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DOM_Revenue_Calculated_Text</name>
        <dataType>String</dataType>
        <expression>&quot;Domestic Payments - (((&quot; + 
IF(
{!QuotedUsageRatePercent} &gt; 0,
TEXT({!$Record.SBQQ__QuoteLine__r.Annual_Total_CC_Volume__c}) + &quot; - &quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Annual_Total_Surcharge_Volume__c}) + &quot;) * &quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c} / 100) + &quot;) + (&quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Annual_Total_Surcharge_Volume__c}) + &quot; * 0.03) * 0.7) / &quot; + TEXT({!ConversionRate}),
TEXT({!$Record.SBQQ__QuoteLine__r.Annual_Number_of_Domestic_Transactions__c}) + &quot; - &quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Annual_No_Surcharge_Transactions__c}) + &quot;) * &quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Amt__c}) + &quot;) + (&quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Annual_No_Surcharge_Transactions__c}) + &quot; * 0.03) * 0.7) / &quot; + TEXT({!ConversionRate})
) +
&quot; Calculated: &quot; + 
TEXT( NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <name>PaymentMethodFormula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS(TEXT({!$Record.SBQQ__QuoteLine__r.Payment_Method__c}), &apos;Debit&apos;),
  &apos;Debit&apos;,
  IF(CONTAINS(TEXT({!$Record.SBQQ__QuoteLine__r.Payment_Method__c}), &apos;OXXO&apos;),
  &apos;OXXO&apos;,
  IF(CONTAINS(TEXT({!$Record.SBQQ__QuoteLine__r.Payment_Method__c}), &apos;Paynet&apos;),
  &apos;Paynet&apos;,
  &apos;Credit&apos;
  )))</expression>
    </formulas>
    <formulas>
        <name>QuotedUsageRateAmount</name>
        <dataType>Number</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.Adjusted_Rate_Amount__c})), {!$Record.Adjusted_Rate_Amount__c}, 
    IF(
        NOT(ISBLANK({!$Record.Usage_Rate_Amt__c})), {!$Record.Usage_Rate_Amt__c}, 0
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>QuotedUsageRatePercent</name>
        <dataType>Number</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.Adjusted_Rate_Percent__c})), {!$Record.Adjusted_Rate_Percent__c}, 
    IF(
        NOT(ISBLANK({!$Record.Usage_Rate__c})), {!$Record.Usage_Rate__c}, 0
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>STDCostRate</name>
        <dataType>Number</dataType>
        <expression>IF(
    {!$Record.Ship_To_Account__r.Account_Region__c} = &apos;EMEA&apos;,
    IF(
      TEXT({!$Record.Ship_To_Account__r.ShippingCountryCode}) = &apos;GB&apos;,
      {!Country_EDU_Domestic_Cost_Rates.Cost_Rate__c},
      {!REST_EMEA_EDU_Domestic_Cost_Rates.Cost_Rate__c}
    ),
    IF(
       ISNULL({!Country_EDU_Domestic_Cost_Rates.Cost_Rate__c}),
      {!Default_EDU_Domestic_Cost_Rates.Cost_Rate__c},
      {!Country_EDU_Domestic_Cost_Rates.Cost_Rate__c}
    )
  )</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>UtilizationRate</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.SBQQ__QuoteLine__r.Utilization__c},
    &quot;20%&quot;, 0.2,
    &quot;40%&quot;, 0.4,
    &quot;60%&quot;, 0.6,
    &quot;80%&quot;, 0.8,
    &quot;100%&quot;, 1.0,
    1.0
  )</expression>
        <scale>2</scale>
    </formulas>
