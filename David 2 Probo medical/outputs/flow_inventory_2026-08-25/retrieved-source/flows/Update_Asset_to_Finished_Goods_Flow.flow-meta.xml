    <decisions>
        <name>InterCompany_Asset</name>
        <label>InterCompany Asset</label>
        <locationX>248</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Purchasing_Opportunity_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Asset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Sales_Opportunity__r.Account.Inter_Company_Transfer__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Sales_Price</targetReference>
            </connector>
            <label>Asset</label>
        </rules>
    </decisions>
    <decisions>
        <name>Purchasing_Opportunity_Type</name>
        <label>Purchasing Opportunity Type</label>
        <locationX>248</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sourcing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Purchasing_Opportunity__r.Purchasing_Opportunity_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sourcing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Check_In_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Purchase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Location__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ship From Vendor</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Ownership__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PROBO-US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Product_Family__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Part</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ReviewStatus</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Sourcing</label>
        </rules>
    </decisions>
    <decisions>
        <name>ReviewStatus</name>
        <label>ReviewStatus</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>Update_To_Finished_Goods</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Finished_Good</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Review_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Finished Goods</stringValue>
                </rightValue>
            </conditions>
            <label>Finished Good?</label>
        </rules>
    </decisions>
    <description>01/07/2025 (BW) - Updated so that this only runs if there is a purchasing opportunity</description>
    <environments>Default</environments>
    <formulas>
        <name>SalesPriceForAsset</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Cost__c})),{!$Record.Cost__c},0) + IF(NOT(ISBLANK({!$Record.Total_Cost_of_Assets_Used_in_Repair__c})),{!$Record.Total_Cost_of_Assets_Used_in_Repair__c},0)</expression>
        <scale>2</scale>
    </formulas>
