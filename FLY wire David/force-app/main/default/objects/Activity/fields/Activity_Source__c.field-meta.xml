<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Activity_Source__c</fullName>
    <description>Returns which object the Activity originated from</description>
    <externalId>false</externalId>
    <formula>CASE(
left(WhatId,3),
&quot;001&quot;,&quot;Account&quot;,
&quot;003&quot;,&quot;Contacts&quot;,
&quot;00Q&quot;,&quot;Leads&quot;,
&quot;500&quot;,&quot;Case&quot;,
&quot;006&quot;,&quot;Opportunity&quot;,
&quot;Other&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Returns which object the Activity originated from</inlineHelpText>
    <label>Activity Object Source</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
