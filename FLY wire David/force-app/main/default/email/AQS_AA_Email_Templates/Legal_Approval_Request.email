<messaging:emailTemplate subject="{!relatedTo.sbaa__Opportunity__r.Account.RecordType.Name} Opp Approval LGL Req #{!relatedTo.sbaa__Opportunity__r.Opportunity__c} {!relatedTo.sbaa__Opportunity__r.Name}"
   recipientType="User"
   relatedToType="sbaa__Approval__c">
   <messaging:HtmlEmailBody >
      <html>
         <body>
            <!-- <apex:image value="{!LEFT($Api.Enterprise_Server_URL_300, FIND('/services',$Api.Enterprise_Server_URL_300))}/servlet/servlet.ImageServer?id={!$Setup.AQS_AA_Enablement_IDs__c.AQS_Approval_Email_Logo_ID__c}&oid={!$Organization.Id}" 
                alt="Approval Email Logo" /> -->
            <!-- <b></b> 
            <p><br/></p> -->
            Hello {!recipient.name}, 
            <p>{!relatedTo.sbaa__Opportunity__r.Owner.Name} is requesting your approval for an Opportunity, please see below for details. NOTE: Remember to update the Contract URL and Contract Start Date fields on this Opportunity to finalize.<br/></p>
            <p>
               <b></b><br/>
               <b>Note to Legal: </b>{!relatedTo.sbaa__Opportunity__r.Note_to_Legal__c}<br/>
               <b>Client Legal Name: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Client_Legal_Entity_Name__c}<br/>
               <b>Tax ID: </b>{!relatedTo.sbaa__Opportunity__r.Account.Tax_Id__c}<br/>
               
               <apex:outputPanel rendered="{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__Account__c != relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Ship_To_Account__c}">
                  <b>Ship To Account: </b>{!relatedTo.sbaa__Opportunity__r.Ship_To_Account__r.Name}<br/>
                  <b>Shipping Address: </b>{!relatedTo.sbaa__Opportunity__r.Ship_To_Account__r.ShippingStreet}, {!relatedTo.sbaa__Opportunity__r.Ship_To_Account__r.ShippingCity}, {!relatedTo.sbaa__Opportunity__r.Ship_To_Account__r.ShippingState}, {!relatedTo.sbaa__Opportunity__r.Ship_To_Account__r.ShippingPostalCode}, {!relatedTo.sbaa__Opportunity__r.Ship_To_Account__r.ShippingCountry} <br/>
               </apex:outputPanel>
               <b>Bill To Account: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__Account__r.Name}<br/>
               <b>Billing Address: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__Account__r.BillingStreet}, {!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__Account__r.BillingCity}, {!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__Account__r.BillingState}, {!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__Account__r.BillingPostalCode}, {!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__Account__r.BillingCountry} <br/>

               <b>Opportunity: </b>&nbsp;
               <apex:outputLink value="{!LEFT($Api.Enterprise_Server_URL_300, FIND('/services',$Api.Enterprise_Server_URL_300))}/{!relatedTo.sbaa__Opportunity__r.Id}" >{!relatedTo.sbaa__Opportunity__r.Name}</apex:outputLink>
               <br/>
               <b>Flywire Legal Entity: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Flywire_Entity__c}<br/>
               <apex:outputPanel rendered="{!OR(relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Multiple_Ship_to_Accounts__c == 'No', relatedTo.sbaa__Opportunity__r.RecordType.DeveloperName = 'Healthcare')}">
                  <b>Ship To Account:  </b>{!relatedTo.sbaa__Opportunity__r.Ship_To_Account__r.Name}<br/>
               </apex:outputPanel>
               <b>Opportunity Type: </b>{!relatedTo.sbaa__Opportunity__r.Type}<br/>
               <b>Contract Term: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__SubscriptionTerm__c}<br/>
               <b>Renewal Term: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__RenewalTerm__c}<br/>
               <b>Payment Terms: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.SBQQ__PaymentTerms__c}<br/>
               <b>Non-Standard Terms: </b>{!relatedTO.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Non_Standard_Terms__c}<br/>
               <b>PO Required?: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.PO_Required__c}<br/>
               <b>PO Number: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.PO__c}<br/>
               <b>Contract has Auto Renewal Terms: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Contract_has_Auto_Renewal_Terms__c}<br/>
               <b>Exclusivity: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Exclusivity__c}<br/>
               <b>Termination: </b>{!relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Termination__c}<br/>
               <b>Owner Expiration Notice: </b>{!relatedTo.sbaa__Opportunity__r.CPQ_Contract__r.OwnerExpirationNotice}<br/>
            <p>
               <b>Opportunity Line Items:</b><br/>
               <sbaa:relatedList rendered="{!AND(relatedTo.sbaa__Opportunity__c != null, relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Multiple_Ship_to_Accounts__c == 'No')}" recordId="{!relatedTo.sbaa__Opportunity__c}" relationshipName="OpportunityLineItems" fieldSetName="AA_Opp_Approval_Request"/>
               <sbaa:relatedList rendered="{!AND(relatedTo.sbaa__Opportunity__c != null, relatedTo.sbaa__Opportunity__r.SBQQ__PrimaryQuote__r.Multiple_Ship_to_Accounts__c == 'Yes')}" recordId="{!relatedTo.sbaa__Opportunity__c}" relationshipName="OpportunityLineItems" fieldSetName="AA_Opp_Approval_Request_with_Ship_to_Acc"/>
            </p>
            <p>
               <b>Next Step:</b> To reject this request, click on this link:&nbsp;&nbsp;
               <apex:outputLink value="{!LEFT($Api.Partner_Server_URL_140,FIND('.com',$Api.Partner_Server_URL_140)+4)+'apex/SBAA__Reject?id='+relatedTo.Id}">Reject</apex:outputLink>
               <br/>
            </p>
            </p> 
            <p style="color:white">
               <apex:outputText value="{!relatedTo.Id}"/>
            </p>
         </body>
      </html>
   </messaging:HtmlEmailBody>
</messaging:emailTemplate>