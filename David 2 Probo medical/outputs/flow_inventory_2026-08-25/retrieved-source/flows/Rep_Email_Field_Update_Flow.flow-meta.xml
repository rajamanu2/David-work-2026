    <description>06/02/2026 (SP) - Setting the Canadian email by pulling the User record of the entered &quot;Sales Representative&quot;.</description>
    <environments>Default</environments>
    <formulas>
        <name>CanadaRepEmailFormula</name>
        <dataType>String</dataType>
        <expression>LEFT(TEXT({!$Record.Sales_Representative__c}), 1) + IF(
    NOT(ISBLANK(TEXT({!$Record.Sales_Representative__c}))),
    SUBSTITUTE(
        MID(
            TEXT({!$Record.Sales_Representative__c}),
            FIND(&quot; &quot;, TEXT({!$Record.Sales_Representative__c})) + 1,
            LEN(TEXT({!$Record.Sales_Representative__c}))
        ),
        &quot; &quot;,
        &quot;&quot;
    ),
    &quot;&quot;
)+ &quot;@probomedical.ca&quot;</expression>
    </formulas>
