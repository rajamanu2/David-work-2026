    <decisions>
        <name>Did_Project_Change</name>
        <label>Did Project Change?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Project_Changed_and_Prior_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Related_Project__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Related_Project__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Related_Project__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Prior_Opportunities</targetReference>
            </connector>
            <label>Yes, project changed and prior project exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Current_Project_Not_Null</name>
        <label>Is Current Project Not Null?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, nothing to update</defaultConnectorLabel>
        <rules>
            <name>Yes_Current_Project_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Related_Project__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Current_Opportunities</targetReference>
            </connector>
            <label>Yes, current project exists</label>
        </rules>
    </decisions>
    <description>05/14/26 (BW) – Async replacement for DLRS Total_Cost_of_Project_POs rollup (update path). Fires when Related_Project__c or Probo_s_Offer_Total__c changes. Immediate path recalculates the prior Project when the lookup changes; async path recalculates the current Project.</description>
