    <decisions>
        <description>This route is taken when either the previous &quot;Service Appointment ID&quot; is null (record created), or the &quot;Apponitment Type&quot; is changed while the &quot;Parent Record ID&quot; equals the previous &quot;Parent Record ID&quot;. This second condition ensures that any records being reparented and having their &quot;Appointment Type&quot; field changed go to the &quot;Service Appointment Reparented&quot; route first.</description>
        <name>Service_Appointment_Created_or_Reparented_Check</name>
        <label>Service Appointment Created or Reparented Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Service_Appointment_Created</name>
            <conditionLogic>1 OR (2 AND 3) OR 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Appointment_Type__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ParentRecordId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.ParentRecordId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Recalculate_Service_Appointment_Numbers__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_All_Service_Appointments_from_Work_Order</targetReference>
            </connector>
            <label>Service Appointment Created</label>
        </rules>
        <rules>
            <name>Service_Appointment_Reparented</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ParentRecordId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Number_of_Service_Appointments_from_Previous_Work_Order</targetReference>
            </connector>
            <label>Service Appointment Reparented</label>
        </rules>
    </decisions>
