    <decisions>
        <name>Is_RMA_connected_to_an_Work_Order</name>
        <label>Is RMA connected to an Work Order?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Connected_to_FSL_Work_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Related_Work_Order__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_that_work_order_a_US_FSL_Work_Order</targetReference>
            </connector>
            <label>Yes, Connected to FSL Work Order</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_that_work_order_a_US_FSL_Work_Order</name>
        <label>Is that work order a US FSL Work Order?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_US_FSL_Work_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Related_Work_Order__r.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>012Ro000001eDqnIAE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Related_Work_Order__r.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Work_Order_s_Probe_Received_Date</targetReference>
            </connector>
            <label>Yes, US FSL Work Order</label>
        </rules>
    </decisions>
    <description>04/02/2026 (BW) - Updates to allow for Warranty Repair with Customer Expectation of Returning to change the Work Order to &quot;In Progress&quot; when the probe is received</description>
    <environments>Default</environments>
    <interviewLabel>US FSL RMA | On Probe Check-In for Repair, Set Date Checked-In on Work Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>US FSL RMA | On Probe Check-In for Repair, Set Date Checked-In on Work Order</label>
