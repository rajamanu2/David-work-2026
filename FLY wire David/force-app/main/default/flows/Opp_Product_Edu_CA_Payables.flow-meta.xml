    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>&quot;Auto Calculated &quot; + TEXT( NOW() - 0.1666)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_5_myRule_4_A1_1905777677</name>
        <dataType>String</dataType>
        <expression>&quot;Auto Calculated &quot; + TEXT( NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>(
(
([OpportunityLineItem].Opportunity.Avg_Trans_Amt__c * 0.02 +5) * [OpportunityLineItem].Opportunity.FX_XB_Outgoing_PYMTS__c 
) 
+ 
(25 * [OpportunityLineItem].Opportunity.CAD_XB_PYMTS_Offshore__c ) 
+ 
( 
([OpportunityLineItem].Opportunity.CAD_EFT_Outgoing_PYMTS__c  + [OpportunityLineItem].Opportunity.Paper_Checks__c ) 
* 1.5
) 
+ 
[OpportunityLineItem].Opportunity.INTERAC_outgoing_PYMTS__c  
)
* 0.75
* [OpportunityLineItem].Opportunity.CAD_FX_Rate__c </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_6_myRule_4_A1_0775627214</name>
        <dataType>Currency</dataType>
        <expression>(
(
({!myVariable_current.Opportunity.Avg_Trans_Amt__c} * 0.02 +5) * {!myVariable_current.Opportunity.FX_XB_Outgoing_PYMTS__c} 
) 
+ 
(25 * {!myVariable_current.Opportunity.CAD_XB_PYMTS_Offshore__c} ) 
+ 
( 
({!myVariable_current.Opportunity.CAD_EFT_Outgoing_PYMTS__c}  + {!myVariable_current.Opportunity.Paper_Checks__c} ) 
* 1.5
) 
+ 
{!myVariable_current.Opportunity.INTERAC_outgoing_PYMTS__c}  
)
* 0.75
* {!myVariable_current.Opportunity.CAD_FX_Rate__c}</expression>
        <scale>18</scale>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>&quot;Saas Fee Conversion * &quot; + TEXT([OpportunityLineItem].Opportunity.CAD_FX_Rate__c ) + &quot; * &quot; + TEXT([OpportunityLineItem].UnitPrice ) +
&quot; Calculated: &quot;+ TEXT( NOW() - 0.1666)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_9_myRule_8_A1_4683089293</name>
        <dataType>String</dataType>
        <expression>&quot;Saas Fee Conversion * &quot; + TEXT({!myVariable_current.Opportunity.CAD_FX_Rate__c} ) + &quot; * &quot; + TEXT({!myVariable_current.UnitPrice} ) +
&quot; Calculated: &quot;+ TEXT( NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND
(
[OpportunityLineItem].Product_Name_Copy__c  = &quot;Payables&quot;,
[OpportunityLineItem].Opportunity.RecordTypeId = &quot;012f200000122AwAAI&quot;,
[OpportunityLineItem].Do_not_Auto_Calculate_Price__c = False,
[OpportunityLineItem].Opportunity.IsClosed = False,
OR(
[OpportunityLineItem].Opportunity.Account.ShippingCountry = &quot;Canada&quot;,
[OpportunityLineItem].Opportunity.Account.ShippingCountry = &quot;CA&quot;,
[OpportunityLineItem].Opportunity.Account.ShippingCountry = &quot;CAN&quot;
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>AND
(
{!myVariable_current.Product_Name_Copy__c}  = &quot;Payables&quot;,
