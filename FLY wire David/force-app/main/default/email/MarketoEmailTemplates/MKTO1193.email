<tr> 
<td width="100%" valign="top" align="left" style="text-align: left; font-family: Chivo, Arial, Helvetica, sans-serif; color: #223341; font-size: 20px; font-weight: bold; letter-spacing: normal; line-height: 21px; padding-bottom: 20px; width: 100%;"> <p style="margin: 0px; text-align: center;"><span style="color: #147bd1; font-size: 30px; line-height: 32px;">Registrations is now open</span></p> <p style="margin: 0px; text-align: center;"><span style="font-size: 40px; line-height: 42px; color: #48b985;">Flywire Connect Delhi</span></p> <p style="margin: 0px; text-align: center;"><span style="font-size: 20px; line-height: 21px; color: #147bd1;">Saturday evening, 19 August 2023</span></p> </td> 
