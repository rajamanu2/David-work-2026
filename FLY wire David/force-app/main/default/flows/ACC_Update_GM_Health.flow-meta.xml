    <description>Updates the gross margin health field with color emoji and percentage of the gross margin. SAL-2767</description>
    <environments>Default</environments>
    <formulas>
        <name>GMMarginColorAccomdationFor</name>
        <dataType>String</dataType>
        <expression>CASE(1,
If({!MarginFormula} &lt; 15 , 1, 0 ), &apos;🔴 &apos;  &amp; TEXT({!MarginFormula})  &amp; &apos;%&apos;,
If(({!MarginFormula} &lt;= 45 &amp;&amp;{!MarginFormula} &gt;= 15), 1, 0 ),  &apos;🟡 &apos;  &amp; TEXT({!MarginFormula})  &amp; &apos;%&apos; ,
If(({!MarginFormula} &gt; 45), 1, 0 ), &apos;🟢 &apos;  &amp; TEXT({!MarginFormula})  &amp; &apos;%&apos;,
&quot;0%&quot;)</expression>
    </formulas>
