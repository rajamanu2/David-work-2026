<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>What_is_the_Current_Account_Status</name>
        <label>What is the Current Account Status</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IS_NOT_ACTIVE_Product_Live</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Created (Not Active)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prospecting</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client Signed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Date</targetReference>
            </connector>
            <label>IS NOT ACTIVE (Product Live)</label>
        </rules>
        <rules>
            <name>Status_Is_ACTIVE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active (Product Live)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Date_Only</targetReference>
            </connector>
            <label>Status Is ACTIVE (Product Live)</label>
        </rules>
    </decisions>
    <description>Updates the Account Status and Status Date based on Flow Trigger field changing.</description>
