<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Created_Week__c</fullName>
    <description>Week of Year the Opp was created</description>
    <externalId>false</externalId>
    <formula>TEXT((MOD(FLOOR( (DATEVALUE(CreatedDate) -7-DATEVALUE(&quot;2010-01-01&quot; ))/7),52))+1)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Week of Year the Opp was created</inlineHelpText>
    <label>Created Week</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
