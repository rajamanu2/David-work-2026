    <decisions>
        <name>Which_Account_and_Lead_Domains_Match</name>
        <label>Which Account and Lead Domains Match</label>
        <locationX>1106</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Website_Domain_Matches</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Accounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Accounts.Website_Domain_Capture__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Email_Domain_Capture__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Accounts.Account_Industry__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Lead_Industry__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_with_Account_Info_0</targetReference>
            </connector>
            <label>Website Domain Matches</label>
        </rules>
        <rules>
            <name>Email_Changed_to_No_Match_and_Clear_Acct_LookUp</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Accounts.Website_Domain_Capture__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Email_Domain_Capture__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Account_Lookup_Field</targetReference>
            </connector>
            <label>Email Changed to No Match and Clear Acct LookUp</label>
        </rules>
    </decisions>
    <description>Matches lead email to account domain and fills in Account Lookup field. If lead matches criteria for EDU, B2B, or Travel then Account Owner is assigned to Lead. 09/20/2023 Update: added in logic to only match account lookup if lead industry matches account industry. 12/8/2023 Update: added additional BDR assignment logic that if lead is matched to a prospect account without an open opportunity, the lead is assigned the BDR Owner for the account. SAL-3391 06/04/2024 Update: Added HC vertical logic. SAL-5105 03/17/2025 Update: B2B vertical logic update to remove BDRs.</description>
    <environments>Default</environments>
