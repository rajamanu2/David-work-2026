    <formulas>
        <description>Calculates the next invoice date</description>
        <name>frmNextInvoiceDate</name>
        <dataType>Date</dataType>
        <expression>IF ({!Start_Date}&lt;=TODAY(), TODAY(),{!Start_Date})</expression>
    </formulas>
    <formulas>
        <name>RenewalVarFormula</name>
        <dataType>Date</dataType>
        <expression>{!End_Date} - 90</expression>
    </formulas>
    <formulas>
        <name>TermMonths</name>
        <dataType>Number</dataType>
        <expression>{!TermYears} * 12</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TermYears</name>
        <dataType>Number</dataType>
        <expression>YEAR({!End_Date}) - YEAR({!Start_Date})</expression>
        <scale>0</scale>
    </formulas>
