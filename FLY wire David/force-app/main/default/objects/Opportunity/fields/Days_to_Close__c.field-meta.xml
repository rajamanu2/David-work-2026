<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_to_Close__c</fullName>
    <externalId>false</externalId>
    <formula>IF( IsWon ,( 
CloseDate - DATEVALUE(CreatedDate)), 
0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>For Closed Opps how long did it take to close the Opportunity. e.g. From Create Date to Closed Won</inlineHelpText>
    <label>Days to Close</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
