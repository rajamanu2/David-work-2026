        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>&quot;Contract &quot; &amp; {!loop_contract.ContractNumber} &amp; &quot; will expire on &quot; &amp; TEXT({!loop_contract.EndDate})</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>&lt;p&gt;Contract Number {!loop_contract.ContractNumber} for {!loop_contract.Account.Name} will expire on {!TEXT({!loop_contract.EndDate})}.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Click the following link to view full details:&lt;/p&gt;&lt;p&gt;https:/flywire.lightning.force.com/{!loop_contract.Id}&lt;/p&gt;</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>2.0.1</versionString>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Calculate_the_ReminderNotice</name>
        <label>Calculate the ReminderNotice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>loop_contract</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Fulfilled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TargetNoticeDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Agents_Acc_RM_and_Owner</targetReference>
            </connector>
            <label>Is Fulfilled</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_for_account_recordtype</name>
        <label>check for account recordtype</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>loop_contract</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Agent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_contract.Account.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Agents</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Calculate_the_ReminderNotice</targetReference>
            </connector>
            <label>is Agent?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DaysBeforeNotice</name>
        <dataType>Number</dataType>
        <expression>IF(
  ISBLANK( TEXT({!loop_contract.OwnerExpirationNotice}) ),
  90,
  VALUE( TEXT({!loop_contract.OwnerExpirationNotice}) )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>NoticeDate</name>
        <dataType>Date</dataType>
        <expression>DATE(
    YEAR(Today()),
    MONTH(Today()),
    DAY(Today())
)</expression>
    </formulas>
    <formulas>
        <name>TargetNoticeDate</name>
        <dataType>Date</dataType>
        <expression>{!loop_contract.EndDate} - {!DaysBeforeNotice}</expression>
    </formulas>
    <interviewLabel>Test Schdeule Flow for Owner ExpirationNotice {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Schdeule Flow for Owner Expiration Notice</label>
