<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>SCC-3385: Allows creation only when the action is launched from a Trouble Ticket.</description>
        <name>Is_Trouble_Ticket</name>
        <label>Is Trouble Ticket</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invalid_Case_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a Trouble Ticket</defaultConnectorLabel>
        <rules>
            <name>Valid_Trouble_Ticket</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Trouble_Ticket.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Trouble_Ticket.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Trouble_Ticket_Record_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Customer_Account</targetReference>
            </connector>
            <label>Valid Trouble Ticket</label>
        </rules>
    </decisions>
    <decisions>
        <description>SCC-3385: Stops a second Work Order from being created for the same Case.</description>
        <name>Work_Order_Already_Exists</name>
        <label>Work Order Already Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Work_Order_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Existing Work Order</defaultConnectorLabel>
        <rules>
            <name>Existing_Work_Order_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Work_Order.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Duplicate_Work_Order_Screen</targetReference>
            </connector>
            <label>Existing Work Order Found</label>
        </rules>
    </decisions>
    <description>SCC-3385: Creates a Work Order from a Trouble Ticket, maps required Case details, prevents duplicates, and logs the creation in Case activity history.</description>
    <dynamicChoiceSets>
        <description>SCC-3385: Presents all current Work Type records so the mapping follows org configuration.</description>
        <name>Current_Work_Types</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>WorkType</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>SCC-3385: Records creation details in the Case activity history.</description>
        <name>Activity_Description</name>
        <dataType>String</dataType>
        <expression>&quot;Work Order &quot; &amp; {!Get_Created_Work_Order.WorkOrderNumber} &amp;
&quot; was created from this Trouble Ticket with Work Type &quot; &amp;
{!Get_Created_Work_Order.WorkType.Name} &amp; &quot;.&quot;</expression>
    </formulas>
    <formulas>
        <description>SCC-3385: Labels the completed activity with the created Work Order number.</description>
        <name>Activity_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Work Order &quot; &amp; {!Get_Created_Work_Order.WorkOrderNumber} &amp; &quot; Created&quot;</expression>
    </formulas>
    <formulas>
        <description>SCC-3385: Maps the Trouble Ticket Med value to the Work Order Medium value.</description>
        <name>Mapped_Work_Order_Priority</name>
        <dataType>String</dataType>
        <expression>IF(
    TEXT({!Get_Trouble_Ticket.Priority__c}) = &quot;Med&quot;,
    &quot;Medium&quot;,
    IF(
        NOT(ISBLANK(TEXT({!Get_Trouble_Ticket.Priority__c}))),
        TEXT({!Get_Trouble_Ticket.Priority__c}),
        TEXT({!Get_Trouble_Ticket.Priority})
    )
)</expression>
    </formulas>
    <formulas>
        <description>SCC-3385: Gives the created Work Order a traceable Trouble Ticket subject.</description>
        <name>Work_Order_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Trouble Ticket &quot; &amp; {!Get_Trouble_Ticket.CaseNumber} &amp;
IF(
    ISBLANK({!Get_Trouble_Ticket.Subject}),
    &quot;&quot;,
    &quot;: &quot; &amp; {!Get_Trouble_Ticket.Subject}
)</expression>
    </formulas>
    <interviewLabel>SCC-3385 Create Trouble Ticket Work Order {!$Flow.CurrentDateTime}</interviewLabel>
