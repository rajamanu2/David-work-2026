        <label>Is Current Opportunity Not Null?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, nothing to update</defaultConnectorLabel>
        <rules>
            <name>Yes_Current_Opportunity_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OpportunityId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Current_Line_Items</targetReference>
            </connector>
            <label>Yes, current opportunity exists</label>
        </rules>
    </decisions>
    <description>05/15/26 (BW) – Async replacement for DLRS Avg_Inventory_Life_Opp_Product rollup (update path). Fires when OpportunityId or Avg_Inventory_Life__c changes. Immediate path recalculates the prior Opportunity when the lookup changes; async path recalculates the current Opportunity.</description>
    <environments>Default</environments>
    <formulas>
        <name>form_Avg_Current_Inventory_Life</name>
        <dataType>Number</dataType>
        <expression>{!Sum_Current_Avg_Inventory_Life}/{!Count_Current_Line_Items}</expression>
        <scale>2</scale>
    </formulas>
