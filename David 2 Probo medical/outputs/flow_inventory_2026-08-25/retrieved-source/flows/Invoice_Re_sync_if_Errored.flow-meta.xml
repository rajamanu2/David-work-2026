<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>05/27/26 (BW) – Created scheduled daily flow to re-sync Invoice__c records stuck in Error status. Only processes invoices created after 1/1/2026.</description>
    <environments>Default</environments>
    <interviewLabel>Invoice - Re-sync if Errored {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Invoice - Re-sync if Errored</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Invoice_to_Sync</name>
        <label>Set Invoice to Sync</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Intacct_Invoice_Debug_URL__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Intacct_Invoice_Error_Message__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Intacct_Invoice_Sync_Status__c</field>
            <value>
                <stringValue>Sync</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Intacct_Invoice_Timestamp__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Intacct_Invoice_Transaction_ID__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Invoice_to_Sync</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Intacct_Invoice_Sync_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThan</operator>
            <value>
                <dateTimeValue>2026-01-01T00:00:00.000Z</dateTimeValue>
            </value>
        </filters>
        <object>Invoice__c</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-05-27</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
