<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When the Contact.Txt Flow Trigger field is updated, flow updates various Account mirroring fields on the contact record. Used to keep Marketo database in alignment. SAL-4910.</description>
    <environments>Default</environments>
    <interviewLabel>(CONTACT) Mass Update Contact Mirroring Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(CONTACT) Mass Update Contact Mirroring Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Contacts</name>
        <label>Update Contacts Fields</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Acct_DHC_EMR_Vendor_Inpatient__c</field>
            <value>
                <elementReference>$Record.Account.texcellency__DefHC_EMR_Vendor_Inpatient__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_DHC_Net_Patient_Revenue__c</field>
            <value>
                <elementReference>$Record.Account.texcellency__DefHC_NetPatientRev__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_ERP__c</field>
            <value>
                <elementReference>$Record.Account.ERP__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_Employee_Range__c</field>
            <value>
                <elementReference>$Record.Account.Employee_Range__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_Industry__c</field>
            <value>
                <elementReference>$Record.Account.Account_Industry__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_No_International_Payers_At_Account__c</field>
            <value>
                <elementReference>$Record.Account.No_International_Payers_At_Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_Revenue_Range__c</field>
            <value>
                <elementReference>$Record.Account.Revenue_Range__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_Shipping_Country__c</field>
            <value>
                <elementReference>$Record.Account.ShippingCountry</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_Sub_Industry__c</field>
            <value>
                <elementReference>$Record.Account.Account_Sub_Industry__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Acct_Total_Enrollment__c</field>
            <value>
                <elementReference>$Record.Account.Undergrad_Enrollment__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact_Automation_Bypass_DateTime__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Txt_Flow_Trigger__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
