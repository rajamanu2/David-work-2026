<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>The Work Orders listed in this email are those that were marked as &quot;In Prgoress&quot; and had a &quot;Next Service Date&quot; after the &quot;Decommission Date&quot;.</description>
        <name>Email_Service_Coordination_Team_With_Canceled_Work_Orders</name>
        <label>Email Service Coordination Team With Canceled Work Orders</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>formulaEmailRecipient</elementReference>
                </collectionElements>
                <collectionElements>
                    <stringValue>Sacha.Pearce@probomedical.co.uk</stringValue>
                </collectionElements>
