    <formulas>
        <name>formulaDataDeletionDefault</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!Get_Opportunity.Data_Deletion_Requirement__c}, &quot;Hard Drive Removal&quot;),
    &quot;Required&quot;,
    &quot;Not Required&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaDateTimeTodayPlus30</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
    DATE(
        YEAR(TODAY()),
        MONTH(TODAY()),
        DAY(TODAY())
        +
        30
        +
        FLOOR((30 + WEEKDAY(TODAY()) - 1) / 5) * 2
        +
        CASE(
            MOD(30 + WEEKDAY(TODAY()) - 1, 5),
            0, 0,
            6, 2,
            1
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultWorkType</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!Get_Opportunity.RecordType.DeveloperName},
    &quot;Big_Iron_Purchasing_Opportunity&quot;, &quot;08qRo0000006Pq9IAE&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaOutOfHoursDefault</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Opportunity.Out_of_Hours__c} = true, &quot;Full&quot;, &quot;Not Required&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaQADefaultValue</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!Get_Opportunity.QA_Required__c}, &quot;Yes&quot;),
    &quot;Required&quot;,
    &quot;Not Required&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaRAMSDefaultValue</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!Get_Opportunity.RAMs_Required__c}, &quot;Yes&quot;),
    &quot;Required&quot;,
    &quot;Not Required&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaSitePreCheckStatusDefaultValue</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!Get_Opportunity.RAMs_Required__c}, &quot;Yes&quot;),
    &quot;Required&quot;,
    &quot;Not Required&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaTransportStatusDefault</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!Get_Opportunity.Transport_Booked__c}, &quot;Yes&quot;),
    &quot;Required&quot;,
    &quot;Not Required&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaWorkOrderAssetName</name>
        <dataType>String</dataType>
        <expression>{!Create_Mechcanical_Services_Work_Order.WorkOrderNumber} &amp; &quot; - &quot; &amp; {!Loop_colvarOpportunityAssets.Name} &amp; &quot; - &quot; &amp; {!Loop_colvarOpportunityAssets.Product2_Name__c}</expression>
    </formulas>
    <formulas>
        <name>formulaWorkOrderAssetRole</name>
        <dataType>String</dataType>
        <expression>IF(
    {!Loop_colvarOpportunityAssets.Imaging_Modality__c} = &quot;101--Ultrasound Probes&quot;,
    &quot;Associated Equipment&quot;,
    &quot;Main System&quot;
)</expression>
    </formulas>
