    <description>SALDEV-1152 – Migrated from (Opp Product) Travel XB/DOM ARR Calculator when new calcs were added for 2026 and DOM and XB calcs separated into two different flows.

SALDEV-1413 - Quote Line field Quoted_Usage_Percent__c replaced with Average_Quoted_Usage_Percent__c for stepped up pricing</description>
    <environments>Default</environments>
    <formulas>
        <name>Cancelled_ARR</name>
        <dataType>Number</dataType>
        <expression>{!Get_Original_Opportunity_Product_Cancellation.Opp_Product_ARR__c} * (-1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DOM_ARR</name>
        <dataType>Number</dataType>
        <expression>{!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c} / ConversionRate * (BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0) / 100)  * {!UtilizationRate}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DOM_Commision_ARR</name>
        <dataType>Number</dataType>
        <expression>IF(
      ISPICKVAL({!$Record.SBQQ__QuoteLine__r.Usage_Type__c}, &apos;Percent&apos;),
      {!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c} * ((BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0) / 100) - {!TavelStdCost}) * {!UtilizationRate} / {!ConversionRate},
      null
  )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RevenuCalcFor</name>
        <dataType>String</dataType>
        <expression>&quot;Travel &quot; + {!$Record.Ship_To_Account__r.Account_Region__c} + &quot; &quot; +
  {!$Record.Account_Industry__c} + &quot; DOM &quot; +
  TEXT(BLANKVALUE({!$Record.SBQQ__QuoteLine__r.Average_Quoted_Usage_Percent__c}, 0)) + &quot;% * &quot; +
  TEXT({!UtilizationRate} * 100) + &quot;% Utilization * MM $&quot; +
  TEXT({!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c}) + &quot; / FX &quot; +
  TEXT(ConversionRate) + &quot; Calculated: &quot; + TEXT(NOW() - 0.1666)</expression>
    </formulas>
    <formulas>
        <name>TavelStdCost</name>
        <dataType>Number</dataType>
        <expression>IF( ISNULL({!Currency_Travel_Domestic_Cost_Rates.Standard_Cost_Rate__c}),
{!Default_Travel_Domestic_Cost_Rates.Standard_Cost_Rate__c}
,
{!Currency_Travel_Domestic_Cost_Rates.Standard_Cost_Rate__c}
)</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>UtilisationLookUpKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.Ship_To_Account__r.Account_Region__c} &amp; &quot;_&quot; &amp;
  {!$Record.Account_Industry__c} &amp;
  IF(
    {!$Record.Account_Industry__c} = &quot;Accommodations&quot; &amp;&amp; NOT(ISBLANK({!$Record.Account_Sub_Industry__c})),
    &quot;_&quot; &amp; {!$Record.Account_Sub_Industry__c},
    &quot;&quot;
  )</expression>
    </formulas>
    <formulas>
        <description>UtilizationRate</description>
        <name>UtilizationRate</name>
        <dataType>Number</dataType>
        <expression>
  IF(
    ISNULL({!Utilisation_Rate_Record.Utilization__c}),
    1.0,
    {!Utilisation_Rate_Record.Utilization__c}
  )</expression>
        <scale>6</scale>
    </formulas>
