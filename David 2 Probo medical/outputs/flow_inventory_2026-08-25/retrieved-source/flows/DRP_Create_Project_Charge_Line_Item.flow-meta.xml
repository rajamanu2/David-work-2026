    <formulas>
        <description>Calculate the value to print into the &quot;Line Cost&quot; but multiplting the entered &quot;Quantity&quot; by the entered &quot;Cost per Unit (Rate)&quot;</description>
        <name>formulaExpenseCostTotal</name>
        <dataType>Currency</dataType>
        <expression>{!varProjectChargeLineItem.Quantity__c} * {!Cost_per_Unit}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Calculate the &quot;Line Revenue&quot; by adding the Disaster Recovery Billing Rule&apos;s &quot;Markup %&quot; to the &quot;Line Cost&quot;.

&quot;Line Cost&quot; was previously set by &quot;formulaExpenseCostTotal&quot;</description>
        <name>formulaExpenseLineRevenue</name>
        <dataType>Currency</dataType>
        <expression>{!varProjectChargeLineItem.Line_Cost__c} * (1 + {!varDisasterRecoveryBillingRule.Markup_Percentage__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaLaborLineRevenue</name>
        <dataType>Currency</dataType>
        <expression>{!varProjectChargeLineItem.Quantity__c} * {!varDisasterRecoveryBillingRule.Bill_Rate__c}</expression>
        <scale>2</scale>
    </formulas>
