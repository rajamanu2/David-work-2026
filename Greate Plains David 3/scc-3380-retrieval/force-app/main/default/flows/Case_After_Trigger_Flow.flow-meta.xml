    <decisions>
        <description>SCC-3380: When a Trouble Ticket is closed, close its child cases so NOC can close a parent ticket and all children in one action. Child cases keep their own case numbers and details.</description>
        <name>Check_Case_Closed</name>
        <label>Check Case Closed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>After_Email_Case_Created</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Trouble_Ticket</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Child_Cases</targetReference>
            </connector>
            <label>Case Closed</label>
        </rules>
    </decisions>
    <description>SCC-3380: After a Trouble Ticket is closed, closes open child cases linked through Parent Case. Also sends the existing email-to-case acknowledgement on insert.
Child cases retain their own case numbers and details; only Status is updated.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Case - After Trigger Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - After Trigger Flow</label>
    <processMetadataValues>
