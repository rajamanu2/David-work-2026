<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>02/24/2024 - Kyle L @ Delegate - This flow guarantees that the &quot;Offsite Appointment&quot; Checkbox is marked &quot;TRUE&quot; when an SA is created or updated when the Appointment Type field value is &quot;Tech Call&quot;.</description>
    <environments>Default</environments>
    <interviewLabel>Service Appointment - Trigger - Update Offsite Appointment Checkbox {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Service Appointment - Trigger - Update Offsite Appointment Checkbox</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>This action updates the checkbox required to have a remote / offsite SA for &quot;Tech phone calls&quot;</description>
        <name>Update_Offsite_Appointment_Checkbox</name>
        <label>Update Offsite Appointment Checkbox</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>IsOffsiteAppointment</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Offsite_Appointment_Checkbox</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsOffsiteAppointment</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Appointment_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Tech Support Call</stringValue>
            </value>
        </filters>
        <object>ServiceAppointment</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
