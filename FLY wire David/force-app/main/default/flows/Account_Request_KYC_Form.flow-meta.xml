    <description>Create passfort profile and customer request form. SAL-4599 Updated 09/25/2024 Autopopulate Flywire entities, add form description. SAL-4599 Updated to not autopopulate the entity with Account Region Object. This feature will be re activated after the BOPI project implementation. SAL-4599 Updated 11/04/2024 Company Agents should not have vertical specified in the create profile API request. Updated 11/04/2024 Company Agents should have Entity Type = &apos;Education Agent&apos; on profile creation. SAL-4599 Updated 11/07/2024 to send &apos;Education&apos; as vertical for &apos;Agents&apos; Account record type except Agents (Individual) form. For Individuals we don&apos;t send the vertical because that field does not exist in PF for that form.
SAL-5204  Only Agents Account should be able to select &apos;N/A&apos; as flywire entity. Created a second choice set for agents only that includes N/A</description>
    <environments>Default</environments>
    <formulas>
        <description>For Agents Companies, we do not send a vertical value. Instead we send the custom field s_entity_type = &apos;Education Agent&apos;</description>
        <name>CompanyAgentsEntityType</name>
        <dataType>String</dataType>
        <expression>IF({!FormKYCInput.firstSelectedRow.DeveloperName} = &quot;Agents_Company&quot;, &quot;Education Agent&quot;, null)</expression>
    </formulas>
    <formulas>
        <name>DefaultFlywireEntity</name>
        <dataType>String</dataType>
        <expression>CASE({!AccountFlywireEntity}, 
&quot;Flywire (Singapore) Pte., Ltd.&quot;, &quot;Flywire (Singapore) Pte Ltd&quot;,
&quot;Flywire Canada Inc (Canada)&quot;, &quot;Flywire Canada Inc&quot;,
&quot;Flywire Europe, UAB&quot;, &quot;Flywire Europe UAB&quot;,
&quot;Flywire G.K.&quot;, &quot;Flywire G.K.&quot;,
&quot;Flywire Payments Corporation&quot;, &quot;Flywire Payments Corporation&quot;,
&quot;Flywire Payments Limited&quot;, &quot;Flywire Payments Limited&quot;,
&quot;Flywire (Hong Kong) Limited&quot;, &quot;Flywire (Hong Kong) Limited&quot;,
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Used to take the right value from the picklists. There are 2 different picklists and depending on the record type, only one is shown to the user</description>
        <name>FlywireEntity</name>
        <dataType>String</dataType>
        <expression>IF(
    {!recordId.RecordType.DeveloperName} = &apos;Agents&apos;,
    {!Flywire_Entity_Input_Agents},
    {!Flywire_Entity_Input_Non_Agents}
)</expression>
    </formulas>
    <formulas>
        <name>FormURLFor</name>
        <dataType>String</dataType>
        <expression>&apos;https://collection.passfort.com/?request_id=&apos;+ {!Create_Form_API.2XX.id}+&apos;&amp;apikey=&apos;+ {!Create_Form_API.2XX.apix5fkey}</expression>
    </formulas>
    <formulas>
        <name>NewOrReKYCText</name>
        <dataType>String</dataType>
        <expression>IF(  ISBLANK({!recordId.Passfort_Profile_Id__c}) 
 , &apos;New KYC&apos;,  &apos;Re KYC&apos;)</expression>
    </formulas>
    <formulas>
        <name>ProfileEntityType</name>
        <dataType>String</dataType>
        <expression>IF({!FormKYCInput.firstSelectedRow.DeveloperName} = &quot;Agent_Individual&quot;, &quot;INDIVIDUAL&quot;, &quot;COMPANY&quot;)</expression>
    </formulas>
    <formulas>
        <description>Passfort profile role</description>
        <name>ProfileRole</name>
        <dataType>String</dataType>
        <expression>IF({!FormKYCInput.firstSelectedRow.DeveloperName} = &quot;Agent_Individual&quot;, &quot;INDIVIDUAL_CUSTOMER&quot;, &quot;COMPANY_CUSTOMER&quot;)</expression>
    </formulas>
    <formulas>
        <name>Vertical</name>
        <dataType>String</dataType>
        <expression>IF({!FormKYCInput.firstSelectedRow.DeveloperName} = &apos;Agent_Individual&apos;, null,
IF({!recordId.RecordType.DeveloperName} = &apos;Agents&apos;, &apos;Education&apos;,
{!recordId.RecordType.DeveloperName}))</expression>
    </formulas>
