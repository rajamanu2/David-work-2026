                <targetReference>Get_Original_Opportunity_Product</targetReference>
            </connector>
            <label>Cancellation</label>
        </rules>
    </decisions>
    <description>Product in this calculation:
Financial Aid Disbursements: Backend FX - FWFA-1100

Auto Calculate Edu Payables product price for UK Region.</description>
    <environments>Default</environments>
    <formulas>
        <name>Canceled_ARR</name>
        <dataType>Number</dataType>
        <expression>{!Get_Original_Opportunity_Product.Opp_Product_ARR__c} * (-1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>USLoansARR</name>
        <dataType>Number</dataType>
        <expression>(({!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c} * {!$Record.SBQQ__QuoteLine__r.Avg_Quoted_Rate__c}) / {!ConversionRate})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>USLoansRevenueCalculation</name>
        <dataType>String</dataType>
        <expression>&quot;Financial Aid Disbursements: Backend FX - &quot; + TEXT({!$Record.SBQQ__QuoteLine__r.Est_Annual_MM__c}) +  &quot;*&quot;  + TEXT({!$Record.SBQQ__QuoteLine__r.Avg_Quoted_Rate__c}) + &quot;/&quot; + TEXT({!ConversionRate})</expression>
    </formulas>
    <interviewLabel>(Opp Product) US Loans ARR Calculator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(Opp Product) US Loans ARR Calculator</label>
