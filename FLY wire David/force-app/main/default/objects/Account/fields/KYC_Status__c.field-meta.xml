<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>KYC_Status__c</fullName>
    <description>KYC Status, to be filled in automatically by integration with PassFort</description>
    <inlineHelpText>Applications are created as &apos;Applied&apos;, they can then be &apos;Approved&apos; or &apos;Rejected&apos;. If Application status shows &apos;In Review&apos; it should still be considered &apos;Approved&apos;</inlineHelpText>
    <label>KYC Status</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>false</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Approved</fullName>
                <default>false</default>
                <label>Approved</label>
            </value>
            <value>
                <fullName>Rejected</fullName>
                <default>false</default>
                <label>Rejected</label>
            </value>
            <value>
                <fullName>Applied</fullName>
                <default>false</default>
                <label>Applied</label>
            </value>
            <value>
                <fullName>Cancelled</fullName>
                <default>false</default>
                <label>Cancelled</label>
            </value>
            <value>
                <fullName>In Review</fullName>
                <default>false</default>
                <isActive>false</isActive>
                <label>In Review</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
