        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Concatenated_Tracking</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Shipments.zkmulti__Tracking_Number__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Shipments</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Loaner_Is_Null_Check</name>
        <label>Loaner Is Null Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Loaner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Remaining_Shipments_of_Loaner</targetReference>
            </connector>
            <label>Is Not Null</label>
        </rules>
    </decisions>
    <description>06/04/26 (GD) – DLRS-replacement: Tracking_to_Loaner_Record (before delete, synchronous). No delimiter — tracking numbers concatenated directly with no separator (deviates from org comma standard). No CONTAINS-based dedup implemented (dedup pattern requires a comma delimiter to work safely). Revisit delimiter and dedup in a future iteration.</description>
    <environments>Default</environments>
    <formulas>
        <name>Trimmed_Tracking</name>
        <dataType>String</dataType>
        <expression>LEFT({!Concatenated_Tracking}, 255)</expression>
    </formulas>
    <interviewLabel>MCShipment | Before Delete, Tracking to Loaner Roll Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MCShipment | Before Delete, Tracking to Loaner Roll Up</label>
    <loops>
        <name>Loop_Through_Shipments</name>
        <label>Loop Through Shipments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Remaining_Shipments_of_Loaner</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Tracking_String</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Loaner</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Remaining_Shipments_of_Loaner</name>
        <label>Get Remaining Shipments of Loaner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Shipments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Loaner__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Loaner__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>zkmulti__Tracking_Number__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>zkmulti__MCShipment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Loaner</name>
        <label>Update Loaner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Loaner__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Tracking_Number__c</field>
            <value>
                <elementReference>Trimmed_Tracking</elementReference>
            </value>
        </inputAssignments>
        <object>Loaner__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loaner_Is_Null_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Loaner__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>zkmulti__MCShipment__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Concatenated_Tracking</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
