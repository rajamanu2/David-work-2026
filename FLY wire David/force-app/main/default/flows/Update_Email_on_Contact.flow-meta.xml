            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(255, 0, 0); font-family: Arial, sans-serif; font-size: 11pt; background-color: transparent;&quot;&gt;ATTENTION: NETSUITE SYNC IMPACT&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You&apos;re updating a contact that is designated as the &lt;strong&gt;Billing Contact&lt;/strong&gt; for multiple accounts. This change will sync to NetSuite for:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong&gt;{!var_AccountListText}&lt;/strong&gt;&lt;/p&gt;&lt;blockquote&gt;&lt;p class=&quot;ql-quote-block&quot;&gt;&lt;em&gt;If this is correct, click &lt;/em&gt;&lt;strong&gt;&lt;em&gt;Next&lt;/em&gt;&lt;/strong&gt;&lt;em&gt; to enter new email. If not, click &lt;/em&gt;&lt;strong&gt;&lt;em&gt;X&lt;/em&gt;&lt;/strong&gt;&lt;em&gt; to close this Page&lt;/em&gt;&lt;/p&gt;&lt;/blockquote&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
