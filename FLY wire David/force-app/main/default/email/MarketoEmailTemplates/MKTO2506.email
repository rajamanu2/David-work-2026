<tr> 
<td width="100%" bgcolor="#DCEAF6" valign="top" style="width: 100%; padding-right: 39px; padding-left: 41px;"> 
<table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" width="100%" style="width: 100%;"> 
<tbody>
<tr> 
<td width="100%" valign="top" align="left"> 
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="560" class="st-mso-full-width st-mobile-full-width" style="width: 560px;"> 
<tbody>
<tr> 
<td align="center" valign="top" width="560"> 
<table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"> 
<tbody>
<tr> 
<td width="100%" valign="top" align="center" style="padding: 0px; width: 100%;"> <p height="20" width="100%" style="mso-line-height-rule:exactly; mso-table-lspace:0pt; mso-table-rspace:0pt; text-size-adjust:100%; width: 100%; height: 20px; max-height: 20px; margin: 0px; font-size: 20px; line-height: 20px"> &nbsp; </p> </td> 
</tr> 
<tr> 
<td width="100%" valign="top" align="left" style="text-align: left; font-family: Chivo, Arial, Helvetica, sans-serif; color: #223341; font-size: 22px; font-weight: bold; letter-spacing: normal; line-height: 24px; padding-bottom: 20px; width: 100%;"> <p style="margin: 0px;"><span style="font-size: 22px; line-height: 24px; color: #0f476b;">Flywire Dashboard:</span></p> </td> 
</tr> 
<tr> 
<td width="100%" valign="top" align="left" class="aligned-bullets" style="text-align: left; font-family: Chivo, Arial, Helvetica, sans-serif; color: #223341; font-size: 16px; font-weight: normal; letter-spacing: normal; line-height: 24px; padding-bottom: 40px; width: 100%;"> 
<ul style="margin-bottom: 0px !important; margin-top: 0px !important;"> 
<li style="font-size: 15px; line-height: 23px;">To enhance security, we’re introducing two-factor authentication via email for the Flywire Dashboard. Support for authenticator apps will be rolled out at a later time.</li> 
</ul> </td> 
</tr> 
