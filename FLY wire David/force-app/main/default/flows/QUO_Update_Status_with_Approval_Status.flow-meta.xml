<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>BOPI-577 This flow updates the SBQQ__Status__c fields which controls what is shown on the Quote record page depending on the Approval status</description>
    <environments>Default</environments>
    <formulas>
        <name>RecordTypeIdFormula</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.ApprovalStatus__c}),
&quot;Approved&quot;, {!$Setup.AQS_AA_Enablement_IDs__c.AQS_Approved_Quote_RT__c},
&quot;Pending&quot;, {!$Setup.AQS_AA_Enablement_IDs__c.AQS_In_Progress_Quote_RT__c},
{!$Setup.AQS_AA_Enablement_IDs__c.AQS_Draft_Quote_RT__c}
)</expression>
    </formulas>
    <formulas>
        <description>Returns the correct status depending on the approval status</description>
        <name>StatusFormula</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.ApprovalStatus__c}),
&quot;Approved&quot;, &quot;FW Approved&quot;,
&quot;Pending&quot;, &quot;FW In Review&quot;,
&quot;Rejected&quot;, &quot;FW Rejected&quot;,
&quot;Draft&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Formula that sets the WatermarkShown to true is the  Approval Status is &quot;Approved&quot;</description>
        <name>WatermarkShownFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(TEXT({!$Record.ApprovalStatus__c}) = &quot;Approved&quot;,
FALSE,
TRUE
)</expression>
    </formulas>
    <interviewLabel>(QUO) Update Status with Approval Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(Quote) Update Status with Approval Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update Quote with new formula updates</description>
        <name>Update_Quote</name>
        <label>Update Quote</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>SBQQ__Status__c</field>
            <value>
                <elementReference>StatusFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ApprovalStatus__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>SBQQ__Quote__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
