        <name>Contains_a_Work_Order_Association</name>
        <label>Contains a Work Order Association?</label>
        <locationX>1320</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Add_Current_Opp_Line_to_List_for_Transform</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Associated_with_WOLI</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Opportunity_Products.Work_Order_Line_Item__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
