    <formulas>
        <name>ContractNameFormula</name>
        <dataType>String</dataType>
        <expression>&quot;Service Contract - &quot; + {!ServiceContractRecord.ContractNumber} + &quot; - &quot; + TEXT({!TermYears})</expression>
    </formulas>
    <formulas>
        <name>RenewalLetterClac</name>
        <dataType>Date</dataType>
        <expression>IF(
DAY({!End_Date}) &gt; CASE(MOD(MONTH({!End_Date}) - 3 + 11, 12) + 1,
2, 28, 4, 30, 6, 30, 9, 30, 11, 30, 31),
DATE(
IF(MONTH({!End_Date}) &lt;= 3, YEAR({!End_Date}) - 1, YEAR({!End_Date})),
IF(MONTH({!End_Date}) &gt; 3, MONTH({!End_Date}) - 3, MONTH({!End_Date}) + 9),
CASE(MOD(MONTH({!End_Date}) - 3 + 11, 12) + 1, 2, 28, 4, 30, 9, 30, 11, 30, 31)
),
DATE(
IF(MONTH({!End_Date}) &lt;=3, YEAR({!End_Date}) - 1, YEAR({!End_Date})),
IF(MONTH({!End_Date}) &gt; 3, MONTH({!End_Date}) - 3, MONTH({!End_Date}) + 9),
DAY({!End_Date})
)
)</expression>
    </formulas>
    <formulas>
        <name>TermMonths</name>
        <dataType>Number</dataType>
        <expression>{!TermYears} * 12</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TermYears</name>
        <dataType>Number</dataType>
        <expression>YEAR({!End_Date}) - YEAR({!Start_Date})</expression>
        <scale>0</scale>
    </formulas>
