    <description>05/22/2026 (BW) - Fixed the Shipping Country issue by adding an exception parameter for &quot;US&quot; to be changed to &quot;United States&quot;
06/05/2026 (BW) - Added StateTranslation__mdt lookup to convert 2-letter state abbreviations to full state names for Shipping and Billing state fields before creating the Service Contract</description>
    <environments>Default</environments>
    <formulas>
        <name>formBillingState</name>
        <dataType>String</dataType>
        <expression>IF(LEN(TEXT({!$Record.BillingState__c})) = 2, {!Get_Billing_State_Translation.State_Name__c}, TEXT({!$Record.BillingState__c}))</expression>
    </formulas>
    <formulas>
        <name>formBillingStateUpper</name>
        <dataType>String</dataType>
        <expression>UPPER(TEXT({!$Record.BillingState__c}))</expression>
    </formulas>
    <formulas>
        <name>formShippingCountry</name>
        <dataType>String</dataType>
        <expression>If(TEXT({!$Record.ShippingCountry__c})==&quot;US&quot;,&quot;United States&quot;,TEXT({!$Record.ShippingCountry__c}))</expression>
    </formulas>
    <formulas>
        <name>formShippingState</name>
        <dataType>String</dataType>
        <expression>IF(LEN(TEXT({!$Record.ShippingState__c})) = 2, {!Get_Shipping_State_Translation.State_Name__c}, TEXT({!$Record.ShippingState__c}))</expression>
    </formulas>
    <formulas>
        <name>formShippingStateUpper</name>
        <dataType>String</dataType>
        <expression>UPPER(TEXT({!$Record.ShippingState__c}))</expression>
    </formulas>
    <formulas>
        <name>NumberofYears</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Warranty_Length_in_Days__c}/365</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Sets the end date based on the activation date + number of warranty days</description>
        <name>setEndDate</name>
        <dataType>Date</dataType>
        <expression>{!setStartDate} + IF({!$Record.Warranty_Length_in_Days__c} &lt; 365, {!$Record.Warranty_Length_in_Days__c}, (365*{!NumberofYears}) - 1)</expression>
    </formulas>
    <formulas>
        <description>Sets the activation date based on the ship date</description>
        <name>setStartDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Ship_Date__c} + 3</expression>
    </formulas>
