        <rules>
            <name>Type_is_Break_Fix</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WorkTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
