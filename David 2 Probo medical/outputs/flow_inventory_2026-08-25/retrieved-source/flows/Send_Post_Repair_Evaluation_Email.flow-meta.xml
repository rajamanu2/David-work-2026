&quot;Method: &quot; + TEXT({!Get_Related_Opportunity.Ship_Type__c} ) + BR() + 
&quot;Tracking #: &quot; + {!Get_Related_Opportunity.Tracking__c} + BR() + BR() + 
IF(ISBLANK({!Get_Related_RMA.Loaner_RMA__c}), &quot;&quot;, (&quot;Our records indicate the following loaner is associated with this repair. Please return this within 5 business days to avoid any fees.&quot; + BR() + 
&quot;Loaner SN: &quot; + {!Get_Related_RMA.Loaner_Asset_Number__r.Serial_No__c} + BR() + 
&quot;Loaner RMA: &quot; + {!Get_Related_RMA.Loaner_RMA__r.Name} + BR() + 
&quot;Ship to Address: &quot; + {!FacilityAddress}))</expression>
    </formulas>
