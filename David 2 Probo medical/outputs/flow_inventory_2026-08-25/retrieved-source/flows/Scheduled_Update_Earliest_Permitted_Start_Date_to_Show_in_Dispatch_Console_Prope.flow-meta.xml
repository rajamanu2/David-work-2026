<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>If_Earliest_Start_Date_is_before_30_Days_ago_or_within_5_months</name>
        <label>If Earliest Start Date is before 30 Days ago or within 5 months</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Before_30_Days_Ago</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EarliestStartTime</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>x30DaysBeforeToday</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Service_Appointment_Earliest_Start_Date_to_30_Days_Ago</targetReference>
            </connector>
            <label>Before 30 Days Ago</label>
        </rules>
        <rules>
            <name>Within_5_Months</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EarliestStartTime</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>form5MonthsFromToday</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EarliestStartTime</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Service_Appointment_Earliest_Start_Date_to_Today</targetReference>
            </connector>
            <label>Within 5 Months</label>
        </rules>
    </decisions>
    <description>05/05/2025 (BW) - Updated the flow so that it doesn&apos;t error when trying to set the earliest start time</description>
    <environments>Default</environments>
    <formulas>
        <name>form5MonthsFromToday</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Flow.CurrentDate},5)</expression>
    </formulas>
    <formulas>
        <name>x30DaysAfterToday</name>
        <dataType>DateTime</dataType>
        <expression>NOW()+30</expression>
    </formulas>
    <formulas>
        <name>x30DaysBeforeToday</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}-30</expression>
    </formulas>
    <interviewLabel>Scheduled: Update Earliest Permitted Start Date to Show in Dispatch Console Properly {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Scheduled: Update Earliest Permitted Start Date to Show in Dispatch Console Properly</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Service_Appointment_Earliest_Start_Date_to_30_Days_Ago</name>
        <label>Update Service Appointment Earliest Start Date to 30 Days Ago</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>DueDate</field>
            <value>
                <elementReference>x30DaysAfterToday</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EarliestStartTime</field>
            <value>
                <elementReference>x30DaysBeforeToday</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Service_Appointment_Earliest_Start_Date_to_Today</name>
        <label>Update Service Appointment Earliest Start Date to Today</label>
        <locationX>314</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>EarliestStartTime</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_Earliest_Start_Date_is_before_30_Days_ago_or_within_5_months</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Canceled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cannot Complete</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Dispatched</stringValue>
            </value>
        </filters>
        <object>ServiceAppointment</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-03-10</startDate>
            <startTime>09:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
