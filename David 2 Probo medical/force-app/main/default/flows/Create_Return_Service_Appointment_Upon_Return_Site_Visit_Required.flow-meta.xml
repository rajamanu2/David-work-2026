    <decisions>
        <name>Does_Coverage_Level_Cover_Return_Visit</name>
        <label>Does Coverage Level Cover Return Visit?</label>
        <locationX>182</locationX>
        <locationY>708</locationY>
        <defaultConnector>
            <targetReference>Set_Status_to_Ready_To_Book</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Work_Order__r.Contract_Line_Item__r.Coverage_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-Contract</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Work_Order__r.Contract_Line_Item__r.Coverage_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Protect</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Work_Order__r.Contract_Line_Item__r.Coverage_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PPM 1</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Work_Order__r.Contract_Line_Item__r.Coverage_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PPM 2</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Set_Status_to_Ready_To_Book</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <description>Requirement 1: If “Follow on appointment required” is checked TRUE – site visit type, status none
Requirement 2: If “Parts Required” Is checked true only, make status internal on SA
Requirement 3: If both are true, make sure its site visit type, status awaiting parts</description>
        <name>Follow_Site_Visit_Required</name>
        <label>Follow Site Visit Required</label>
        <locationX>644</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Default_B_F_Action_Ready_To_Book</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cannot Complete Only</defaultConnectorLabel>
        <rules>
            <name>Site_Visit_Only</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Return_Visit_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parts_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Does_Coverage_Level_Cover_Return_Visit</targetReference>
            </connector>
            <label>Site Visit Only</label>
        </rules>
        <rules>
            <name>Parts_Required_or_Chargeable_Work</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parts_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Return_Visit_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Additional_Items_to_Quote__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_to_Internal</targetReference>
            </connector>
            <label>Parts Required or Chargeable Work</label>
        </rules>
        <rules>
            <name>Both_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Return_Visit_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parts_Required__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_to_Internal2</targetReference>
            </connector>
            <label>Both True</label>
        </rules>
    </decisions>
