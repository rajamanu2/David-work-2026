<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Website_Email_Domain__c</fullName>
    <description>USED in Lead 2 Acct match flow – do not OBS</description>
    <externalId>false</externalId>
    <formula>IF(
(LEN(Email_Domain_Capture__c)-LEN(SUBSTITUTE(LOWER(Email_Domain_Capture__c),&quot;.&quot;,&quot;&quot;)) &gt; 1) ,
(SUBSTITUTE(Email_Domain_Capture__c, LEFT(Email_Domain_Capture__c, FIND(&quot;.&quot;, Email_Domain_Capture__c)), NULL))
,Email_Domain_Capture__c)</formula>
    <inlineHelpText>Pulls account email domain from website capture field.</inlineHelpText>
    <label>Website Email Domain</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
