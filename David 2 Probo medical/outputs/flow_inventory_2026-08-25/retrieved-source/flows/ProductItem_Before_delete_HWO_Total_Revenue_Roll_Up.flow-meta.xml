<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>05/26/26 (BW) – Delete counterpart to the on-create HWO Total Revenue roll-up. Runs synchronously before delete (Salesforce does not support async after-delete flows). Queries remaining ProductItems on the Harvest Work Order (excluding the record being deleted) and writes the summed Sales_Price__c to Harvest_Work_Order__c.HWO_Total_Revenue__c.
06/01/26 (GD) – Updated entry criteria</description>
    <environments>Default</environments>
    <interviewLabel>ProductItem | Before delete, HWO Total Revenue Roll Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ProductItem | Before delete, HWO Total Revenue Roll Up</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_ProductItems_on_HWO</name>
        <label>Get All ProductItems on HWO</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Sum_Sales_Price_for_HWO</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Harvest_Work_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Harvest_Work_Order__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ProductItem__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_HWO_Total_Revenue</name>
        <label>Update HWO Total Revenue</label>
        <locationX>176</locationX>
        <locationY>503</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Harvest_Work_Order__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>HWO_Total_Revenue__c</field>
            <value>
                <elementReference>Sum_Sales_Price_for_HWO</elementReference>
            </value>
        </inputAssignments>
        <object>Harvest_Work_Order__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_ProductItems_on_HWO</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Harvest_Work_Order__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ProductItem__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <transforms>
        <name>Sum_Sales_Price_for_HWO</name>
        <label>Sum Sales Price for HWO</label>
        <locationX>176</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Update_HWO_Total_Revenue</targetReference>
        </connector>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <scale>2</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <inputParameters>
                    <name>aggregationValues</name>
                    <value>
                        <elementReference>Get_All_ProductItems_on_HWO</elementReference>
                    </value>
                </inputParameters>
                <inputParameters>
                    <name>aggregationFieldReference</name>
                    <value>
                        <complexValue>{&quot;dataType&quot;:&quot;SObject&quot;,&quot;objectType&quot;:&quot;ProductItem__c&quot;,&quot;fieldReferences&quot;:[&quot;Sales_Price__c&quot;],&quot;elementReference&quot;:&quot;Get_All_ProductItems_on_HWO&quot;}</complexValue>
                        <complexValueType>FieldReference</complexValueType>
                    </value>
                </inputParameters>
                <transformType>Sum</transformType>
            </transformValueActions>
        </transformValues>
    </transforms>
</Flow>
