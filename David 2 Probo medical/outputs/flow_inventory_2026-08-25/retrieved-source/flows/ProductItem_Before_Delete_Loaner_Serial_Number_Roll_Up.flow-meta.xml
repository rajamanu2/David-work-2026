<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Serial_String</name>
        <label>Build Serial String</label>
        <locationX>242</locationX>
        <locationY>520</locationY>
        <assignmentItems>
            <assignToReference>Concatenated_Serial</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Serials.Serial_No__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Concatenated_Serial</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>,</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Serials</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Loaner_Is_Null_Check</name>
        <label>Loaner Is Null Check</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Loaner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Remaining_Product_Items_of_Loaner</targetReference>
            </connector>
            <label>Is Not Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Skip_If_Duplicate</name>
        <label>Skip If Duplicate</label>
        <locationX>374</locationX>
        <locationY>520</locationY>
        <defaultConnector>
            <targetReference>Build_Serial_String</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Duplicate</defaultConnectorLabel>
        <rules>
            <name>Is_Duplicate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_Serial_In_String</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Serials</targetReference>
            </connector>
            <label>Is Duplicate</label>
        </rules>
    </decisions>
    <description>05/28/26 (GD) – Replaces DLRS Loaner_Serial_Number rule. Re-concatenates remaining ProductItem__c.Serial_No__c onto Loaner__c.Loaner_Serial__c before a ProductItem is deleted. Excludes the record being deleted from the concatenation. Loaner_Is_Null_Check decision prevents SOQL when Loaner__c is blank.
06/01/26 (GD) – Added Loaner__c IsNull false entry criteria to prevent execution on every ProductItem delete when no Loaner is set.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Serial_In_String</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Serial} &amp; &quot;,&quot;, &quot;,&quot; &amp; {!Loop_Through_Serials.Serial_No__c} &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Trimmed_Serial</name>
        <dataType>String</dataType>
        <expression>IF(RIGHT({!Concatenated_Serial}, 1) = &quot;,&quot;, LEFT({!Concatenated_Serial}, LEN({!Concatenated_Serial}) - 1), {!Concatenated_Serial})</expression>
    </formulas>
    <interviewLabel>ProductItem | Before Delete, Loaner Serial Number Roll Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ProductItem | Before Delete, Loaner Serial Number Roll Up</label>
    <loops>
        <name>Loop_Through_Serials</name>
        <label>Loop Through Serials</label>
        <locationX>242</locationX>
        <locationY>492</locationY>
        <collectionReference>Get_Remaining_Product_Items_of_Loaner</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Skip_If_Duplicate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Loaner</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Remaining_Product_Items_of_Loaner</name>
        <label>Get Remaining Product Items of Loaner</label>
        <locationX>242</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Serials</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Loaner__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Loaner__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ProductItem__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Loaner</name>
        <label>Update Loaner</label>
        <locationX>242</locationX>
        <locationY>600</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Loaner__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Loaner_Serial__c</field>
            <value>
                <elementReference>Trimmed_Serial</elementReference>
            </value>
        </inputAssignments>
        <object>Loaner__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loaner_Is_Null_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Loaner__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ProductItem__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Concatenated_Serial</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
