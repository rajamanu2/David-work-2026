<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Date_String</name>
        <label>Build Date String</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Concatenated_Date</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Shipments.zkmulti__Actual_Delivery_Date__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Concatenated_Date</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>,</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Shipments</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Loaner_Is_Null_Check</name>
        <label>Loaner Is Null Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Loaner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Remaining_Shipments_of_Loaner</targetReference>
            </connector>
            <label>Is Not Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Skip_If_Duplicate</name>
        <label>Skip If Duplicate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Build_Date_String</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Duplicate</defaultConnectorLabel>
        <rules>
            <name>Is_Duplicate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_Date_In_String</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Shipments</targetReference>
            </connector>
            <label>Is Duplicate</label>
        </rules>
    </decisions>
    <description>06/04/26 (GD) – Replaces DLRS rollup &apos;Roll Up Delivered Date on Loaner&apos; (before delete). Queries all remaining MCShipments for the triggered Loaner — the being-deleted record is excluded via Id != $Record.Id filter. Concatenates distinct Actual_Delivery_Date__c values (YYYY-MM-DD, comma-delimited) onto Loaner.Delivered_Date__c. Synchronous only; no async paths are supported in Before Delete flows. Distinct check uses anchored CONTAINS() pattern (&quot;,value,&quot;) to prevent substring false-positives.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Date_In_String</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; {!Concatenated_Date} &amp; &quot;,&quot;, &quot;,&quot; &amp; TEXT({!Loop_Through_Shipments.zkmulti__Actual_Delivery_Date__c}) &amp; &quot;,&quot;)</expression>
    </formulas>
    <formulas>
        <name>Trimmed_Date</name>
        <dataType>String</dataType>
        <expression>LEFT(IF(RIGHT({!Concatenated_Date}, 1) = &quot;,&quot;, LEFT({!Concatenated_Date}, LEN({!Concatenated_Date}) - 1), {!Concatenated_Date}), 255)</expression>
    </formulas>
    <interviewLabel>MC Shipment | Before Delete, Delivered Date Roll Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MC Shipment | Before Delete, Delivered Date Roll Up</label>
    <loops>
        <name>Loop_Through_Shipments</name>
        <label>Loop Through Shipments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Remaining_Shipments_of_Loaner</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Skip_If_Duplicate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Loaner</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Remaining_Shipments_of_Loaner</name>
        <label>Get Remaining Shipments of Loaner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Shipments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Loaner__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Loaner__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>zkmulti__Actual_Delivery_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>zkmulti__MCShipment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Loaner</name>
        <label>Update Loaner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Loaner__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Delivered_Date__c</field>
            <value>
                <elementReference>Trimmed_Date</elementReference>
            </value>
        </inputAssignments>
        <object>Loaner__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loaner_Is_Null_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Loaner__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>zkmulti__Actual_Delivery_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>zkmulti__MCShipment__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Concatenated_Date</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
