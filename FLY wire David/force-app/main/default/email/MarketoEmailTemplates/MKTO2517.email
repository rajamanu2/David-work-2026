<td width="100%" valign="top" align="center" class="st-dynamic-fn9lugmv73ogf" style="padding-bottom: 20px; width: 100%;"><a href="https://www.flywire.com/?utm_source=marketo&amp;utm_medium=email&amp;utm_campaign=Insurance_cbhs_and_ahm_update_23_oct_2025" target="_blank" style="display: block;"><img border="0" valign="top" width="200" src="https://www.cdnrcad8t.com/c9howft0ap/en_us/images/6508bd99c6780-1695071641.8129.png" height="67" alt="" title="" class="st-mobile-width-constraint" style="border: 0px; display: block; width: 200px; max-width: 100%;" /> </a></td> 
