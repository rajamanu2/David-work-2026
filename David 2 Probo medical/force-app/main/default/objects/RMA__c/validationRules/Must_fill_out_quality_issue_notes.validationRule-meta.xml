<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Must_fill_out_quality_issue_notes</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(CONTAINS(RMA_Type__c, &quot;Return from Sale&quot;), CONTAINS(RMA_Type__c, &quot;Warranty&quot;)),  ISBLANK(Quality_Issue_Notes__c))</errorConditionFormula>
    <errorMessage>You must fill out the quality issue notes for warranties and return from sales.</errorMessage>
</ValidationRule>
