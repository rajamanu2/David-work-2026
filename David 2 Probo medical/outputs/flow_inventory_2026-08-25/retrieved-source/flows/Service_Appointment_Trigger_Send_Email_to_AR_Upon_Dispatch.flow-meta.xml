    <decisions>
        <description>Notify resource if the following is ALL true: Assigned Resource has a value, The contract line item has a value, and its not a subcontractor.</description>
        <name>Resource_and_Contract_Line_Item_Found</name>
        <label>Resource and Contract Line Item Found</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>AR_and_CLI_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Assigned_Resource</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contract_Line_Item</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Assigned_Resource.ServiceResource.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>UK Subcontractor - Radiology</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Assigned_Resource.ServiceResource.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>UK Subcontractor - Ultrasound</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Assigned_Resource.ServiceResource.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>John Williams (Subcontractor)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_1</targetReference>
            </connector>
            <label>AR and CLI found</label>
        </rules>
    </decisions>
    <description>03/14/2025 - Kyle/Delegate - Adjustments to process call for email notification ONLY when SA is actually dispatched.
03/21/2025 - Kyle - Additional error handling
04/10/2025 - Kyle - Additional criteria to exclude subcontractor email notifications
01/14/2025 - V4 - SP - Amending &quot;EmailBody&quot; and notification to be formatted/processed as &quot;Plain Text&quot;
01/14/2025 - V5 - SP - Amending &quot;EmailSubject&quot; to be &quot;Plain Text&quot;</description>
