    <formulas>
        <name>ContactName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Repair_Eval_Contact_First_Name__c} + &apos; &apos; + {!$Record.Repair_Eval_Contact_Last_Name__c}</expression>
    </formulas>
    <formulas>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>&quot;Hello &quot; + {!$Record.Repair_Eval_Contact_First_Name__c} + &quot; &quot; + {!$Record.Repair_Eval_Contact_Last_Name__c} + &quot;, &quot; + br() + br() +
&quot;Thank you for using Probo Medical&apos;s free online probe evaluation tool!&quot; + br() + br() +
&quot;The estimate for your &quot; + {!$Record.Repair_Eval_Probe_Model__c} + &quot; repair is attached to this email.&quot;+ br() +
&quot;Please note this is an estimate based upon your diagnosis of the problem - not an official quote.&quot; + br() + br() +
&quot;What happens next?&quot; + br() +  
&quot;1. Generate your RMA # and FREE FedEx shipping label by clicking here - https://probomedical.my.salesforce-sites.com/CustomerForm/?id=&quot; + {!$Record.Id} + &quot; &quot; + br() +
&quot;2. Print the label and affix it to the outside of your box. In the unlikely event that we can’t repair your probe, or you choose not to move forward with the repair, we will ship the probe back to you at no cost to you.&quot; + br() +
&quot;3. Our expert technical team will evaluate your probe in-house and issue a formal quote including an itemized list of actual repairs.&quot; + br() +
&quot;4. Review your formal quote and execute the repair remotely via the link that will be provided in the quote or reach out to one of our technical experts to answer any questions you have.&quot; + br() + br() +
&quot;We value the opportunity to help you!&quot; + br() + br()+
{!EmailSender} + br()+
&quot;Probo Medical&quot;</expression>
    </formulas>
    <formulas>
        <name>EmailSender</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!$Record.Repair_Eval_Contact_Country__c}), {!$Record.Repair_Eval_Contact_Country__c} == &apos;United States&apos;), &apos;Matt Mooney, Vice President&apos;, &apos;Enrico Franchini&apos;)</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>{!$Record.Repair_Eval_Probe_Model__c} + &apos; - Repair Evaluation Quote from Probo Medical&apos;</expression>
    </formulas>
    <formulas>
        <name>OpportunityName</name>
        <dataType>String</dataType>
        <expression>&apos;Repair Evaluation Tool Endoscopy - &apos; + {!$Record.Repair_Eval_Endoscope_Manufacturer__c} + &apos; &apos; + {!$Record.Repair_Eval_Endoscope_Model__c} + &apos; - &apos; + {!$Record.Account.Name}</expression>
    </formulas>
    <formulas>
