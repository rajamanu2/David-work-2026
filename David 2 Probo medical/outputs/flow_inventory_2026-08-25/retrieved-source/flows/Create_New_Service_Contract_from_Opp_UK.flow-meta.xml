    <decisions>
        <description>This Decision element looks at the Account&apos;s Payment Terms and determines if we can proceed or not.</description>
        <name>Customer_Payment_Status</name>
        <label>Customer Payment Status</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Get_opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Prepay_and_Not_Paid_or_Not_Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Account.Payment_Term__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prepay</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Confirmation_Number__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Invoice_Number__r.Payment_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Contract_Creation_Blocked</targetReference>
            </connector>
            <label>Prepay and Not Paid or Not Confirmed</label>
        </rules>
    </decisions>
