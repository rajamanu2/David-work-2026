            <value>
                <elementReference>$Record.ProductItem__r.Check_In_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Model__c</field>
            <value>
                <elementReference>$Record.ProductItem__r.Product_Name__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product_Family_TXT__c</field>
