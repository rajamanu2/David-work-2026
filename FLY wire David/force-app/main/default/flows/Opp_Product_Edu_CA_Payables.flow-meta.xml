    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[OpportunityLineItem].UnitPrice * [OpportunityLineItem].Opportunity.CAD_FX_Rate__c </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_10_myRule_8_A1_0087902478</name>
        <dataType>Currency</dataType>
        <expression>{!myVariable_current.UnitPrice} * {!myVariable_current.Opportunity.CAD_FX_Rate__c}</expression>
        <scale>18</scale>
    </formulas>
