<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quote_must_have_Primary_Contact</fullName>
    <active>true</active>
    <description>Created for SALDEV-1144</description>
    <errorConditionFormula>AND(
				$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
				ISNEW(),
    NOT(ISBLANK(AQS_Quote__c)),
    ISBLANK(AQS_Quote__r.SBQQ__PrimaryContact__c),
    NOT(ISPICKVAL(AQS_Quote__r.SBQQ__Opportunity2__r.Type, &quot;Auto Renewal&quot;))
)</errorConditionFormula>
    <errorMessage>You must add a Primary Contact Role on the Opportunity before submitting for approval</errorMessage>
</ValidationRule>
