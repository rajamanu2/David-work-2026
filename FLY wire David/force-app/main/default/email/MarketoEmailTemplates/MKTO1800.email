<td width="100%" valign="top" align="center" class="st-dynamic-500-2" style="padding-top: 40px; padding-bottom: 40px; width: 100%;"><a href="https://help.flywire.com/hc/en-us/p/client_edu_uk?utm_source=marketo&amp;utm_medium=email&amp;utm_campaign=" target="_blank" style="display: block;"><img border="0" valign="top" width="240" src="https://www.cdnrcad8t.com/9i26uhaos8/en_us/images/60216eb98b9c1-1612803769.5718.png" alt="Client Resource Centre" title="" class="st-mobile-width-constraint" style="border: 0px; display: block; width: 240px; max-width: 100%;" /> </a></td> 
